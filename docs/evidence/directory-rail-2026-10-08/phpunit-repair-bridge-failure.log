    height: 14px;\n
    accent-color: var(--accent);\n
}\n
.admin-console .admin-content .content-tag-uses {\n
    flex: 0 0 auto;\n
    min-width: 62px;\n
    color: var(--text-faint);\n
    font-family: var(--font-mono);\n
    font-size: .78rem;\n
    text-align: right;\n
}\n
.admin-console .admin-content .content-tag-save {\n
    flex: 0 0 auto;\n
    padding: 5px 12px;\n
    font-size: .72rem;\n
    letter-spacing: .04em;\n
}\n
.admin-console .admin-content .content-tag-row-errors {\n
    flex: 1 0 100%;\n
    width: 100%;\n
    padding: 7px 10px;\n
    border-left: 3px solid var(--rust);\n
    border-radius: var(--radius-sm);\n
    background: color-mix(in srgb, var(--rust) 9%, var(--surface-raised));\n
}\n
.admin-console .admin-content .content-tag-row-errors .field-error {\n
    margin: 0;\n
}\n
.admin-console .admin-content .content-tag-merge {\n
    flex: 0 0 auto;\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 6px;\n
}\n
.admin-console .admin-content .content-tag-merge .input {\n
    width: auto;\n
    max-width: 180px;\n
    margin: 0;\n
    padding: 5px 32px 5px 8px;\n
    border-color: var(--border-soft);\n
    border-radius: var(--radius-md);\n
    background-color: var(--surface-page);\n
    color: var(--text-body);\n
    font-size: .82rem;\n
}\n
.admin-console .admin-content .content-tag-empty {\n
    padding: 40px 20px;\n
    text-align: center;\n
}\n
.admin-console .admin-content .content-tag-empty h3 {\n
    margin: 0;\n
    color: var(--text-strong);\n
    font-family: var(--font-display);\n
    font-size: 1.2rem;\n
    font-weight: 500;\n
}\n
.admin-console .admin-content .content-tag-empty p {\n
    margin: 6px 0 0;\n
    color: var(--text-muted);\n
    font-size: .93rem;\n
}\n
\n
/* — Admin people: AdminPeople.dc.html body adoption (Slice 7). —\n
   The shared console owns the area heading and tabs. These rules copy the\n
   roles list, record, assignments and simulator into external, namespaced CSS\n
   so strict CSP, real routes and the server-rendered no-JS forms all survive. */\n
.admin-console .admin-roles {\n
    gap: 0;\n
}\n
.admin-console .admin-roles .role-callout {\n
    display: flex;\n
    align-items: flex-start;\n
    gap: 14px;\n
    margin: 0 0 20px;\n
    padding: 13px 16px;\n
    border: 1px solid var(--river-200);\n
    border-left: 3px solid var(--info);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-info);\n
    color: var(--on-info);\n
}\n
.admin-console .admin-roles .role-callout > svg {\n
    flex: 0 0 auto;\n
    margin-top: 2px;\n
}\n
.admin-console .admin-roles .role-callout p {\n
    max-width: 82ch;\n
    margin: 0;\n
    color: var(--on-info);\n
    font-size: .93rem;\n
    line-height: 1.55;\n
    text-wrap: pretty;\n
}\n
.admin-console .admin-roles .role-callout code {\n
    font-family: var(--font-mono);\n
    font-size: .84rem;\n
}\n
.admin-console .admin-roles .role-callout a {\n
    color: inherit;\n
    text-decoration: underline;\n
}\n
.admin-console .admin-roles .role-list-meta {\n
    display: flex;\n
    justify-content: flex-end;\n
    margin: 0 0 12px;\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    font-size: .74rem;\n
    letter-spacing: .04em;\n
}\n
.admin-console .admin-roles .role-table-card {\n
    padding: 6px 20px 10px;\n
    overflow: visible;\n
    box-shadow: var(--shadow-sm);\n
}\n
.admin-console .admin-roles .role-table {\n
    width: 100%;\n
    border-collapse: collapse;\n
    font-size: .92rem;\n
}\n
.admin-console .admin-roles .role-table th {\n
    padding: 11px 10px 9px;\n
}\n
.admin-console .admin-roles .role-table td {\n
    padding: 10px;\n
}\n
.admin-console .admin-roles .role-table th:first-child,\n
.admin-console .admin-roles .role-table td:first-child {\n
    padding-left: 0;\n
}\n
.admin-console .admin-roles .role-table th:last-child,\n
.admin-console .admin-roles .role-table td:last-child {\n
    padding-right: 0;\n
    text-align: right;\n
}\n
.admin-console .admin-roles .role-table td:first-child {\n
