{
  "name": "RetroBoards",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "php-server",
      "command": "bash .cursor/start.sh && php -S 0.0.0.0:8000 -t public public/index.php"
    }
  ],
  "ports": [8000]
}
