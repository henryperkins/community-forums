{
  // RetroBoards on Cloudflare Containers.
  // Runbook: docs/runbooks/deployment-cloudflare.md
  //
  // The Worker is a thin front door: it fixes up the client-IP header and hands
  // dynamic requests to a single container running the Apache/PHP image.
  // Secrets (APP_KEY, DB_PASSWORD, DB_SSL_CA_PEM, R2 keys) are NOT here --
  // set them with `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retroboards",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "build": { "command": "npm run build" },
  "assets": {
    // Generated allowlist only: never upload public/index.php or local uploads.
    "directory": "./.build/static",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "containers": [
    {
      "class_name": "ForumContainer",
      "image": "./Dockerfile",
      // The app is stateful and single-writer: one instance, always the same one.
      "max_instances": 1,
      // 1/2 vCPU, 4 GiB, 8 GB disk. `basic` (1/4 vCPU, 1 GiB) also runs it but
      // leaves little headroom for Apache + PHP under concurrent renders.
      "instance_type": "standard-1",
      // Pin the container to ENAM (current node ewr14). Added with the
      // 2026-08-06 DB move to gcp-us-east4; since the 2026-09-12 cutover the
      // database is in gcp-us-central1 again, so this pair is cross-region --
      // see docs/runbooks/deployment-cloudflare.md §14 before changing either.
      "constraints": {
        "regions": ["ENAM"]
      }
    }
  ],

  "durable_objects": {
    "bindings": [{ "class_name": "ForumContainer", "name": "FORUM" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ForumContainer"] }],

  // Every hostname listed here other than the APP_URL host is redirected to
  // APP_URL by worker/canonical.mjs, so a hostname can be attached before the
  // canonical origin moves to it (runbook §16).
  "routes": [
    { "pattern": "forum.candidary.online", "custom_domain": true },
    // boards.hperkins.blog is a Cloudflare for SaaS custom hostname of this
    // zone (its DNS stays at WordPress.com), so it is a zone route, not a
    // Custom Domain. Hostname-only on purpose: a `*/*` route would run ahead
    // of the `candidary` Worker's Custom Domain on the apex and capture it.
    { "pattern": "boards.hperkins.blog/*", "zone_name": "candidary.online" }
  ],

  "triggers": {
    "crons": [
      "*/5 * * * *", // worker:email, worker:webhooks
      "0 */6 * * *", // worker:registry-refresh
      "10 3 * * *", // worker:purge-ips, worker:attachments, worker:packages
      "0 7 * * *" // worker:digest
    ]
  },

  "vars": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://forum.candidary.online",
    "SESSION_SECURE": "true",
    "SECURITY_HSTS": "true",
    "MAIL_DRIVER": "cloudflare_smtp",
    "MAIL_FROM": "noreply@candidary.online",
    "MAIL_FROM_NAME": "",
    "MAIL_TIMEOUT_SECONDS": "30",

    // PlanetScale, reached over the public internet. Database `imladris-boards`
    // (org `perkinism`), branch `main`, region gcp-us-central1 -- cut over
    // 2026-09-12 from the previous account's `imladris-db`/`production-east`.
    // Always use the region-scoped access host: the generic anycast host
    // (gcp.connect.psdb.cloud) is not location-predictable and measured ~3x
    // slower per query than gcp-us-central1.connect.psdb.cloud. The container
    // is still pinned to ENAM (see §14 of the runbook for the latency cost of
    // a cross-region pair). Only DB_PASSWORD is a secret (PlanetScale password
    // `production-app`, role admin -- migrations run on boot). PlanetScale
    // serves a publicly-trusted certificate, so the trust anchor is the distro
    // CA bundle already in the image -- no DB_SSL_CA_PEM secret is needed.
    "DB_HOST": "gcp-us-central1.connect.psdb.cloud",
    "DB_PORT": "3306",
    "DB_DATABASE": "imladris-boards",
    "DB_USERNAME": "jfi825th4rola9t3c6pw",
    "DB_EMULATE_PREPARES": "true",
    "DB_SSL": "true",
    "DB_SSL_CA": "/etc/ssl/certs/ca-certificates.crt",

    // /data is an R2 mount -- the container filesystem does not survive restarts.
    "R2_BUCKET": "retroboards-data",
    "R2_ACCOUNT_ID": "a77e479f6736120eadd99973dbeb705e",
    "UPLOADS_PATH": "/data/media",
    "PACKAGES_STORAGE_PATH": "/data/packages",
    // The single instance owns this ephemeral ledger; restart resets its limits.
    "RATELIMIT_PATH": "/var/www/html/storage/ratelimit",

    // The Worker overwrites X-Forwarded-For with the verified client IP, so the
    // app must trust the hop it sees, or every request is attributed to one
    // address and per-IP rate limiting collapses into a single global bucket.
    // Apache logs the Cloudflare-side peer as 10.1.0.0; that address is not a
    // documented stable value, so trust the private range that contains it.
    // Safe here because the container has no public address (network mode is
    // "private", assign_ipv4/assign_ipv6 both "none") -- the only thing that can
    // reach it is the Worker, which discards any client-sent header first.
    "TRUSTED_PROXIES": "10.0.0.0/8",

    // Migrations run in the entrypoint on boot (single instance, no race).
    "RUN_MIGRATIONS": "true"
  }
}
