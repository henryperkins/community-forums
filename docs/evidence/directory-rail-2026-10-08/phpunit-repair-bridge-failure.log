\n
/* — Messages: private counsel reading room. —\n
   The whole surface lives in this one section, in reading order: the shell and\n
   its tokens, the list pane, the compose dialog, list rows, the conversation\n
   header and its menu, the details rail, the stream and its letters, the\n
   composer, empty states, the New message page, the recipient picker, and last\n
   the responsive and input-mode rules that override them. Committed reference:\n
   .impeccable/mocks/messages/. */\n
.dm-shell, .dm-compose-panel, .forum-subheader:has(.dm-listpane-head) {\n
    /* Private-counsel "Bruinen" register — a cool river tint layered over the\n
       warm parchment/gold, scoped to the DM room and compose panel (the global\n
       topbar + nav rail stay warm, so the temperature shift IS the "you're in\n
       the private room" cue). River = the private surface + every status signal; gold stays\n
       "my voice"/esteem; green stays actions. */\n
    --dm-ground: color-mix(in srgb, var(--info) 11%, var(--surface-page));\n
    --dm-raised: color-mix(in srgb, var(--info) 6%, var(--surface-raised));\n
    --dm-sunken: color-mix(in srgb, var(--info) 14%, var(--surface-sunken));\n
    --dm-accent: var(--info);\n
    --dm-accent-line: color-mix(in srgb, var(--info) 45%, var(--border-hair));\n
    --dm-accent-ink: var(--on-info, var(--info));\n
    --dm-active-wash: color-mix(in srgb, var(--info) 18%, var(--surface-raised));\n
    /* Lines drawn from register-aware semantics, so twilight never keeps a pale\n
       day line: the evergreen hover/pressed edge (≈ green-200 by day), and the\n
       gold edge of the own-letter plate and its chips (≈ gold-200 by day). */\n
    --dm-brand-line: color-mix(in srgb, var(--brand) 25%, var(--brand-subtle));\n
    --dm-gold-line: color-mix(in srgb, var(--rule-gold) 25%, var(--gold-soft));\n
    /* Ink on an evergreen --brand fill. The system's filter tab pairs --brand\n
       with parchment in both registers (.inbox-tab.is-active); no semantic token\n
       carries that pairing (--accent-contrast turns twilight-900 at night, 3.3:1\n
       on green-500), so it is named once here, in the token layer. */\n
    --dm-on-brand: var(--parchment-50);\n
    --dm-list-inset: var(--space-4);\n
}\n
.dm-shell {\n
    width: 100%;\n
    max-width: var(--maxw);\n
    margin: -24px auto -64px;\n
    display: grid;\n
    /* The columns are set by the width rules at the end of this section. This\n
       value and the three-column .has-rail one below paint only where neither\n
       side of a 900/901px or 1399/1400px pair matches: a fractional viewport\n
       width at a non-100% zoom. */\n
    grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);\n
    /* The room is height-bounded: the stream scrolls inside it and the composer\n
       docks at the bottom, which is also what lets the new-messages pill work. */\n
    height: calc(100dvh - var(--topbar-h));\n
    min-height: 0;\n
    background: var(--dm-raised);\n
}\n
.dm-shell.has-rail {\n
    grid-template-columns: minmax(260px, 320px) minmax(0, 1fr) minmax(260px, 320px);\n
}\n
/* ── Zoom and short screens: the viewport height is a floor, not a lock ── */\n
/* Locked to the viewport, the letters were whatever the header and composer\n
   left: 34px at 200% and 400% zoom. The conversation now grows past the\n
   viewport once the header, a readable run of letters and the composer no\n
   longer fit, and the page scrolls. No new breakpoint: it follows content, so\n
   enlarged text is covered too. The letters stay their own scroller, so opening\n
   at the newest letter, the poll's pinning and the new-messages pill are\n
   unchanged. The side columns take the room's height without adding their\n
   own (size containment, not sticky: that would trap the compose dialog). */\n
.dm-shell[data-dm-conversation] { height: auto; min-height: calc(100dvh - var(--topbar-h)); }\n
.dm-shell[data-dm-conversation] :is(.dm-listpane, .dm-inforail) { contain: size; }\n
.dm-shell[data-dm-conversation] .dm-scroll { flex: 1 0 0px; min-height: min(8rem, calc(100dvh - var(--topbar-h))); }\n
\n
/* ── List pane: name first, a short time, one-line preview ────────────── */\n
.dm-listpane {\n
    border-right: 1px solid var(--border-hair);\n
    background: var(--dm-ground);\n
    display: flex;\n
    flex-direction: column;\n
    min-height: 0;\n
}\n
.dm-listpane-head {\n
    padding: var(--space-4) var(--dm-list-inset) var(--space-3);\n
    border-bottom: 1px solid var(--border-hair);\n
    position: relative;   /* anchors a server-revealed compose error panel */\n
}\n
.dm-listpane-top {\n
    display: flex;\n
    align-items: center;\n
    justify-content: space-between;\n
    gap: 12px;\n
}\n
.dm-listpane-top > span:first-child {\n
    min-width: 0;\n
}\n
.dm-listpane-head .eyebrow {\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 5px;\n
    margin: 0 0 3px;\n
    white-space: nowrap;\n
}\n
/* h1 on /messages, h2 beside a conversation or the new-message form (one h1\n
   per page); the class keeps both looking the same. */\n
.dm-listpane-head .dm-listpane-title {\n
    font-size: 1.6rem;\n
    line-height: 1.1;\n
    margin: 0;\n
}\n
.dm-listpane-filters {\n
    display: flex;\n
    flex-wrap: wrap;\n
    gap: var(--space-2);\n
    margin-top: var(--space-3);\n
}\n
.dm-listpane-filters .pill { text-decoration: none; font-family: var(--font-label); text-transform: none; letter-spacing: normal; font-size: var(--text-fine); min-height: 44px; display: inline-flex; align-items: center; padding: 0 var(--space-3); }\n
.dm-listpane-filters .pill:hover { color: var(--dm-accent-ink); }\n
/* Selected = the system's filter tab (DESIGN.md "Filter tabs": active fills\n
   evergreen with parchment text), so the choice reads by fill, not by hue. The\n
   inset --brand-hover edge lifts the twilight fill past 3:1 on the pane. */\n
.dm-listpane-filters .pill.is-active { background: var(--brand); color: var(--dm-on-brand); font-weight: var(--weight-medium); box-shadow: inset 0 0 0 1px var(--brand-hover); }\n
.dm-filter-n { margin-left: 6px; font-family: var(--font-mono); font-size: .69rem; color: var(--dm-accent-ink); }\n
.dm-filter-n:empty { display: none; }\n
.dm-listpane-filters .pill.is-active .dm-filter-n { color: inherit; }\n
.dm-search {\n
    position: relative;\n
    display: flex;\n
    align-items: center;\n
    margin-top: var(--space-3);\n
}\n
.dm-search .icon {\n
    position: absolute;\n
    left: 12px;\n
    width: 15px;\n
    height: 15px;\n
    color: var(--text-faint);\n
    pointer-events: none;\n
}\n
.dm-search input {\n
    width: 100%;\n
    min-height: 44px;\n
    font: inherit;\n
    font-family: var(--font-body);\n
    font-size: 1rem;\n
    color: var(--text-body);\n
    padding: 8px 12px 8px 34px;\n
    background: var(--dm-sunken);\n
    border: 1px solid transparent;\n
    border-radius: var(--radius-pill);\n
    transition: background 140ms var(--ease-calm), border-color 140ms var(--ease-calm);\n
}\n
.dm-search input::placeholder { color: var(--text-faint); }\n
/* The shared field focus (DESIGN.md "Inputs and fields" -> Focus; ADR 0034):\n
   gold edge, the 2px accent outline at 1px, and the gold halo. */\n
.dm-search input:focus {\n
    background: var(--dm-raised);\n
    border-color: var(--rule-gold);\n
    outline: 2px solid var(--accent);\n
    outline-offset: 1px;\n
    box-shadow: 0 0 0 3px var(--focus-ring);\n
}\n
.dm-list > li.is-filtered { display: none; }\n
\n
/* — Compose panel: shared creation opens the canonical new-message page.\n
   JS reveals this dialog in place; origin=dialog errors reveal the same form\n
   on the server. No summary-less <details> or implicit browser control. — */\n
.dm-compose-panel {\n
    position: fixed;\n
    left: 50%;\n
    top: calc(var(--topbar-h) + var(--subheader-h) + var(--space-2));\n
    transform: translateX(-50%);\n
    width: min(540px, calc(100vw - 32px));\n
    max-height: calc(100dvh - var(--topbar-h) - var(--subheader-h) - var(--space-4));\n
    overflow-y: auto;\n
    z-index: 46;\n
    text-align: left;\n
}\n
.dm-dialog {\n
    background: var(--surface-raised);\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    box-shadow: var(--shadow-xl);\n
    overflow: hidden;\n
}\n
.dm-dialog-head {\n
    display: flex;\n
    align-items: flex-start;\n
    justify-content: space-between;\n
    gap: 12px;\n
    padding: 18px 22px 12px;\n
}\n
.dm-dialog-head h2 {\n
    font-family: var(--font-display);\n
    font-weight: var(--weight-medium);\n
    font-size: 1.4rem;\n
    color: var(--text-strong);\n
    margin: 0;\n
}\n
.dm-dialog-head .eyebrow { margin: 0 0 2px; display: block; }\n
.dm-dialog-close {\n
    display: inline-flex;\n
    align-items: center;\n
    justify-content: center;\n
    width: 32px;\n
    height: 32px;\n
    border-radius: var(--radius-md);\n
    background: none;\n
    border: 0;\n
    color: var(--text-muted);\n
    cursor: pointer;\n
}\n
.dm-dialog-close:hover { background: var(--surface-sunken); color: var(--brand); }\n
.dm-dialog-body {\n
    padding: 6px 22px 8px;\n
    display: flex;\n
    flex-direction: column;\n
    gap: 14px;\n
}\n
/* The message box sits inside the dialog's padded body, edge to edge with the fields. */\n
.dm-dialog .composer-box { margin: 0 22px; }\n
.dm-dialog .composer-meta-row { margin: 4px 22px 16px; }\n
.has-js .dm-compose-panel:not([hidden]) {\n
    inset: 0;\n
    width: auto;\n
    max-height: none;\n
    overflow: visible;\n
    transform: none;\n
    z-index: 80;\n
}\n
.has-js .dm-compose-panel:not([hidden])::before {\n
    content: "";\n
    position: fixed;\n
    inset: 0;\n
    z-index: 80;\n
    background: var(--scrim);\n
    backdrop-filter: blur(2px);\n
}\n
.has-js .dm-compose-panel:not([hidden]) > .dm-dialog {\n
    position: fixed;\n
    z-index: 81;\n
    top: 10vh;\n
    left: 50%;\n
    right: auto;\n
    transform: translateX(-50%);\n
    width: min(540px, calc(100vw - 32px));\n
    max-height: 82vh;\n
    overflow-y: auto;\n
    animation: dm-dialog-rise 240ms var(--ease-calm) both;\n
}\n
@keyframes dm-dialog-rise {\n
    from { opacity: 0; transform: translate(-50%, 10px); }\n
    to   { opacity: 1; transform: translate(-50%, 0); }\n
}\n
@media (prefers-reduced-motion: reduce) {\n
    .has-js .dm-compose-panel:not([hidden]) > .dm-dialog { animation: none; }\n
}\n
.dm-list {\n
    list-style: none;\n
    margin: 0;\n
    padding: 8px 8px 24px;\n
    overflow-y: auto;\n
    min-height: 0;\n
    display: flex;\n
    flex-direction: column;\n
    gap: 2px;\n
}\n
.dm-list > li {\n
    margin: 0;\n
}\n
.dm-row {\n
    display: grid;\n
    grid-template-columns: auto minmax(0, 1fr) auto;\n
    gap: 2px 11px;\n
    align-items: center;\n
    width: 100%;\n
    padding: 10px 12px;\n
    border-radius: var(--radius-md);\n
    color: inherit;\n
    position: relative;\n
    transition: background 140ms var(--ease-calm);\n
}\n
.dm-row:hover {\n
    background: var(--surface-sunken);\n
    text-decoration: none;\n
}\n
/* Only the active conversation carries the plate; unread is a lone river dot. */\n
.dm-row.active {\n
    background: var(--dm-active-wash);\n
    box-shadow: inset 3px 0 0 var(--dm-accent);\n
}\n
.dm-row .monogram {\n
    grid-row: 1 / span 2;\n
}\n
.dm-row-top {\n
    display: flex;\n
    align-items: baseline;\n
    gap: 7px;\n
    min-width: 0;\n
    grid-column: 2;\n
    grid-row: 1;\n
}\n
.dm-other {\n
    font-family: var(--font-display);\n
    font-weight: var(--weight-medium);\n
    font-size: 1.06rem;\n
    color: var(--text-strong);\n
    line-height: 1.15;\n
    white-space: nowrap;\n
    overflow: hidden;\n
    text-overflow: ellipsis;\n
}\n
.dm-row.is-unread .dm-other {\n
    font-weight: var(--weight-semibold);\n
}\n
.dm-time {\n
    grid-column: 3;\n
    grid-row: 1;\n
    font-family: var(--font-mono);\n
    font-size: .69rem;\n
    letter-spacing: .01em;\n
    font-variant-numeric: tabular-nums;\n
    color: var(--text-muted);\n
    white-space: nowrap;\n
    align-self: baseline;\n
}\n
.dm-row.is-unread .dm-time {\n
    color: var(--dm-accent-ink);\n
}\n
.dm-preview {\n
    grid-column: 2 / span 2;\n
    grid-row: 2;\n
    font-family: var(--font-body);\n
    font-size: .9rem;\n
    color: var(--text-muted);\n
    line-height: 1.4;\n
    display: -webkit-box;\n
    -webkit-line-clamp: 1;\n
    -webkit-box-orient: vertical;\n
    overflow: hidden;\n
}\n
.dm-row.is-unread .dm-preview {\n
    grid-column: 2;\n
    color: var(--text-body);\n
}\n
.dm-preview-you { font-family: var(--font-label); font-size: .69rem; letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted); margin-right: 2px; }\n
/* Unread marker — a single river dot at the row's far right, nothing more. */\n
.dm-unread-dot {\n
    grid-column: 3;\n
    grid-row: 2;\n
    justify-self: end;\n
    align-self: center;\n
    width: 7px;\n
    height: 7px;\n
    border-radius: 50%;\n
    background: var(--dm-accent);\n
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--info) 22%, transparent);\n
}\n
.dm-list-empty {\n
    padding: var(--space-5) var(--dm-list-inset);\n
    margin: 0;\n
    color: var(--text-muted);\n
    text-align: left;\n
}\n
.dm-list-empty > p { margin: 0; }\n
.dm-list-empty-title { margin: 0 0 var(--space-2); font-family: var(--font-display); font-size: var(--text-thread); font-weight: var(--weight-medium); color: var(--text-strong); line-height: 1.25; }\n
.dm-list-empty-first .dm-list-empty-sub { max-width: 36ch; font-size: var(--text-sm); color: var(--text-muted); line-height: 1.5; }\n
\n
/* ── Conversation header: identity, presence, one lock eyebrow ────────── */\n
.dm-threadpane {\n
    background: var(--dm-raised);\n
    display: flex;\n
    flex-direction: column;\n
    min-height: 0;\n
    min-width: 0;\n
}\n
/* One-row conversation header: (back) · identity · details-toggle + one ··· menu. */\n
.dm-thread-head {\n
    padding: 13px 22px;\n
    border-bottom: 1px solid var(--border-hair);\n
    display: flex;\n
    align-items: center;\n
    gap: 12px;\n
    flex: 0 0 auto;\n
}\n
.dm-back {\n
    display: none;\n
    align-items: center;\n
    justify-content: center;\n
    width: 34px;\n
    height: 34px;\n
    border-radius: var(--radius-md);\n
    background: none;\n
    border: 0;\n
    color: var(--text-muted);\n
    cursor: pointer;\n
    flex: 0 0 auto;\n
    text-decoration: none;\n
}\n
.dm-back:hover { background: var(--surface-sunken); color: var(--brand); }\n
.dm-back .icon { width: 18px; height: 18px; }\n
.dm-thread-id {\n
    display: flex;\n
    align-items: center;\n
    gap: 11px;\n
    min-width: 0;\n
    flex: 1 1 auto;\n
}\n
.dm-thread-id > div { min-width: 0; }\n
/* Lock eyebrows (list header + conversation header) read in river ink. */\n
.dm-listpane-head .eyebrow.dm-lock-eyebrow,\n
.dm-thread-eyebrow { color: var(--dm-accent-ink); }\n
.dm-lock-eyebrow .icon,\n
.dm-thread-eyebrow .icon { width: 12px; height: 12px; color: var(--dm-accent); flex: 0 0 auto; }\n
.dm-thread-eyebrow {\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 5px;\n
    font-family: var(--font-label);\n
    text-transform: uppercase;\n
    letter-spacing: var(--tracking-caps);\n
    /* The ramp's floor, not the eyebrow step: at 390px, beside 44px header\n
       targets, "Private counsel" still sets on one line at this size. */\n
    font-size: var(--text-chip);\n
    margin: 0 0 2px;\n
}\n
.dm-thread-title {\n
    font-family: var(--font-display);\n
    font-weight: var(--weight-medium);\n
    font-size: 1.28rem;\n
    line-height: 1.12;\n
    margin: 0;\n
    color: var(--text-strong);\n
    white-space: nowrap;\n
    overflow: hidden;\n
    text-overflow: ellipsis;\n
}\n
.dm-thread-title a { color: inherit; text-decoration: none; }\n
.dm-thread-title a:hover { color: var(--brand); }\n
.dm-thread-sub {\n
    display: block;\n
    font-family: var(--font-mono);\n
    font-size: .72rem;\n
    color: var(--text-muted);\n
    margin: 2px 0 0;\n
    white-space: nowrap;\n
    overflow: hidden;\n
    text-overflow: ellipsis;\n
}\n
.dm-presence { display: inline-flex; align-items: center; gap: 5px; vertical-align: baseline; }\n
.dm-presence .presence-dot-bare { width: 7px; height: 7px; flex: 0 0 auto; }\n
.dm-presence.is-online .presence-dot-bare { background: var(--success); }\n
.dm-presence.is-away .presence-dot-bare { background: var(--warning); }\n
.dm-thread-actions { display: flex; align-items: center; gap: 4px; flex: 0 0 auto; }\n
/* Icon-only header controls — the details toggle and the single overflow. */\n
.dm-iconbtn {\n
    display: inline-flex;\n
    align-items: center;\n
    justify-content: center;\n
    width: 34px;\n
    height: 34px;\n
    border-radius: var(--radius-md);\n
    background: none;\n
    border: 1px solid transparent;\n
    color: var(--text-muted);\n
    cursor: pointer;\n
    transition: background 140ms var(--ease-calm), color 140ms var(--ease-calm);\n
}\n
.dm-iconbtn:hover { background: var(--surface-sunken); color: var(--brand); }\n
.dm-iconbtn.is-active { background: var(--brand-subtle); color: var(--brand); border-color: var(--dm-brand-line); }\n
.dm-iconbtn .icon { width: 18px; height: 18px; }\n
\n
/* The header ··· overflow — a native <details> popover (works with no JS). */\n
.dm-menu { position: relative; display: inline-flex; }\n
.dm-menu > summary { list-style: none; }\n
.dm-menu > summary::-webkit-details-marker { display: none; }\n
.dm-menu-pop {\n
    position: absolute;\n
    z-index: 50;\n
    right: 0;\n
    top: calc(100% + 6px);\n
    min-width: 214px;\n
    padding: 6px;\n
    background: var(--surface-raised);\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-md);\n
    box-shadow: var(--shadow-lg);\n
    display: flex;\n
    flex-direction: column;\n
}\n
.dm-menu form { display: contents; }\n
.dm-menu-item {\n
    display: flex;\n
    align-items: center;\n
    gap: 10px;\n
    width: 100%;\n
    text-align: left;\n
    padding: 8px 10px;\n
    border-radius: var(--radius-sm);\n
    background: none;\n
    border: 0;\n
    cursor: pointer;\n
    font-family: var(--font-body);\n
    font-size: .92rem;\n
    color: var(--text-body);\n
    text-decoration: none;\n
}\n
.dm-menu-item:hover { background: var(--surface-sunken); }\n
.dm-menu-item.danger { color: var(--danger); }\n
.dm-menu-item .icon { width: 16px; height: 16px; color: var(--text-muted); flex: 0 0 auto; }\n
.dm-menu-item.danger .icon { color: var(--danger); }\n
.profile-block > summary { list-style: none; width: 100%; }\n
.profile-block > summary::-webkit-details-marker { display: none; }\n
.profile-cover .profile-block form {\n
    display: grid; gap: 8px; padding: 2px 10px 8px; overflow-wrap: anywhere;\n
}\n
.profile-cover .profile-block form > * { min-width: 0; }\n
.profile-cover .profile-block form p {\n
    margin: 0; font-size: .82rem; line-height: 1.45; color: var(--text-body); text-wrap: pretty;\n
}\n
.dm-menu-sep { height: 1px; background: var(--border-hair); margin: 5px 4px; }\n
/* ── Details rail: identity → facts → quiet actions → members ───────────── */\n
.dm-inforail {\n
    background: var(--dm-ground);\n
    border-left: 1px solid var(--border-hair);\n
    display: flex;\n
    flex-direction: column;\n
    min-height: 0;\n
    min-width: 0;\n
}\n
.dm-rail-head {\n
    padding: 13px 18px;\n
    border-bottom: 1px solid var(--border-hair);\n
    display: flex;\n
    align-items: center;\n
    justify-content: space-between;\n
    gap: 10px;\n
    flex: 0 0 auto;\n
}\n
.dm-rail-head .eyebrow { margin: 0; }\n
.dm-rail-body { overflow-y: auto; min-height: 0; padding: 22px 18px 28px; display: flex; flex-direction: column; gap: 20px; }\n
\n
.dm-rail-id { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; }\n
.dm-rail-id .monogram { width: 72px; height: 72px; font-size: 1.7rem; margin-bottom: 6px; }\n
.dm-rail-name { font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 1.4rem; color: var(--text-strong); line-height: 1.1; margin: 0; }\n
.dm-rail-handle { font-family: var(--font-mono); font-size: .76rem; color: var(--text-muted); }\n
.dm-tier-pill { margin-top: 4px; display: inline-flex; align-items: center; gap: 6px; padding: 3px 12px; border-radius: var(--radius-pill); background: var(--gold-soft); border: 1px solid var(--dm-gold-line); font-family: var(--font-label); text-transform: uppercase; letter-spacing: .06em; font-size: var(--text-chip); color: var(--gold-ink); }\n
\n
.dm-rail-sec { display: flex; flex-direction: column; gap: 9px; }\n
.dm-rail-sec > h3 { font-family: var(--font-label); text-transform: uppercase; letter-spacing: var(--tracking-caps); font-size: var(--text-eyebrow); margin: 0; }\n
.dm-rail-meta { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }\n
.dm-rail-meta li { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; font-family: var(--font-body); font-size: .9rem; color: var(--text-body); }\n
.dm-rail-meta li .k { color: var(--text-muted); }\n
.dm-rail-meta li .v { font-family: var(--font-mono); font-size: .78rem; color: var(--text-strong); text-align: right; }\n
\n
.dm-rail-actions { display: flex; flex-direction: column; gap: 2px; }\n
.dm-rail-form { display: contents; }\n
.dm-rail-btn { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; padding: 9px 10px; border-radius: var(--radius-md); background: none; border: 0; cursor: pointer; font-family: var(--font-body); font-size: .95rem; color: var(--text-body); text-decoration: none; }\n
.dm-rail-btn:hover { background: var(--surface-sunken); }\n
.dm-rail-btn.danger { color: var(--danger); }\n
.dm-rail-btn .icon { width: 16px; height: 16px; color: var(--text-muted); flex: 0 0 auto; }\n
.dm-rail-btn.danger .icon { color: var(--danger); }\n
\n
/* Group members list in the rail */\n
.dm-members { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }\n
.dm-member { display: flex; align-items: center; gap: 10px; padding: 7px 8px; border-radius: var(--radius-md); position: relative; }\n
.dm-member:hover { background: var(--surface-sunken); }\n
.dm-member .monogram { width: 32px; height: 32px; font-size: .72rem; flex: 0 0 auto; }\n
.dm-member .m-id { min-width: 0; display: flex; flex-direction: column; }\n
.dm-member .m-name { font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 1rem; color: var(--text-strong); line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n
.dm-member .m-handle { font-family: var(--font-mono); font-size: .68rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n
.dm-member .m-role { margin-left: auto; font-family: var(--font-label); text-transform: uppercase; letter-spacing: .06em; font-size: .69rem; flex: 0 0 auto; }\n
/* Section heads and member roles read in river ink. */\n
.dm-rail-sec h3, .dm-member .m-role { color: var(--dm-accent-ink); }\n
.dm-member.is-left { opacity: .55; }\n
.dm-member.is-left .m-name { text-decoration: line-through; }\n
.dm-member .m-role.left { color: var(--text-faint); }\n
/* Owner tools overlay the row so a hidden pair of buttons never steals width. */\n
.dm-member-tools { display: flex; gap: 8px; opacity: 0; transition: opacity 140ms var(--ease-calm); position: absolute; right: 6px; top: 50%; transform: translateY(-50%); margin: 0; padding-left: 10px; background: linear-gradient(90deg, transparent, var(--dm-ground) 18%); }\n
.dm-member-tools form { display: contents; }\n
.dm-member:hover .dm-member-tools, .dm-member:focus-within .dm-member-tools { opacity: 1; }\n
.dm-linkbtn { background: none; border: 0; padding: 2px 6px; cursor: pointer; font-family: var(--font-label); letter-spacing: .03em; text-transform: uppercase; font-size: .69rem; color: var(--text-muted); white-space: nowrap; min-height: 24px; }\n
.dm-linkbtn:hover { color: var(--brand); }\n
.dm-linkbtn.danger:hover { color: var(--danger); }\n
.dm-owner-tool { display: flex; gap: 8px; align-items: center; }\n
.dm-owner-tool .input { flex: 1; min-width: 0; }\n
\n
/* Rail scrim — only used as the overlay backdrop (see the width rules below). */\n
.dm-rail-scrim { display: none; }\n
\n
/* ── Stream: the conversation takes the measure ───────────────────────── */\n
.dm-scroll {\n
    overflow-y: auto;\n
    padding: 22px 32px 24px;\n
    display: flex;\n
    flex-direction: column;\n
    gap: 3px;\n
    position: relative;\n
}\n
.dm-scroll-inner {\n
    max-width: 760px;\n
    width: 100%;\n
    margin: 0 auto;\n
    display: flex;\n
    flex-direction: column;\n
    gap: 3px;\n
}\n
[data-dm-messages] { display: flex; flex-direction: column; gap: 3px; }\n
/* Paging. "Earlier messages" is the only way back through a long counsel, so it\n
   and "Latest messages" are quiet secondary buttons (DESIGN.md "Buttons"), never\n
   a line of prose-coloured text. */\n
.dm-earlier,\n
.dm-latest {\n
    align-self: center;\n
    display: inline-flex;\n
    align-items: center;\n
    justify-content: center;\n
    min-height: 34px;\n
    padding: 6px 13px;\n
    margin: 6px 0 10px;\n
    border: 1.5px solid var(--border-soft);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-raised);\n
    color: var(--text-strong);\n
    font-family: var(--font-label);\n
    font-size: .82rem;\n
    letter-spacing: .03em;\n
    line-height: 1.2;\n
    text-decoration: none;\n
}\n
.dm-earlier:hover,\n
.dm-latest:hover { background: var(--surface-sunken); border-color: var(--border-strong); text-decoration: none; }\n
/* Day / section divider — a hairline with a small-caps label, no pill box. */\n
.dm-day {\n
    display: flex;\n
    align-items: center;\n
    gap: 14px;\n
    margin: 18px 2px 10px;\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    text-transform: uppercase;\n
    letter-spacing: var(--tracking-caps);\n
    font-size: .69rem;\n
}\n
.dm-day::before,\n
.dm-day::after {\n
    content: "";\n
    height: 1px;\n
    flex: 1;\n
    background: var(--border-hair);\n
}\n
.dm-day > span { white-space: nowrap; }\n
.dm-day time { white-space: nowrap; }\n
/* Opening divider — the fastest "this is private" cue at the top of the thread. */\n
.dm-day-begin { margin-top: 4px; margin-bottom: 2px; gap: 8px; }\n
.dm-day-begin .icon { width: 12px; height: 12px; flex: 0 0 auto; }\n
.dm-begin-note { text-align: center; font-family: var(--font-body); font-size: .88rem; color: var(--text-faint); margin: 0 0 4px; }\n
/* Grouped "letter" — one author line, then a run of that author's messages. */\n
.dm-group {\n
    display: grid;\n
    grid-template-columns: auto minmax(0, 1fr);\n
    gap: 0 12px;\n
    max-width: 88%;\n
    margin-top: 13px;\n
}\n
.dm-group .dm-mono-col {\n
    grid-row: 1 / span 2;\n
    align-self: start;\n
}\n
.dm-ghead {\n
    display: flex;\n
    align-items: baseline;\n
    gap: 8px;\n
    margin: 1px 0 5px;\n
}\n
.dm-name {\n
    font-family: var(--font-label);\n
    letter-spacing: .04em;\n
    font-size: .72rem;\n
    text-transform: uppercase;\n
    color: var(--on-brand-subtle);\n
}\n
.dm-ghead .dm-gtime {\n
    font-family: var(--font-mono);\n
    font-size: .69rem;\n
    font-variant-numeric: tabular-nums;\n
    color: var(--text-faint);\n
}\n
/* Rank pill beside a group author's name — gold esteem, like the members list. */\n
.dm-rank { font-family: var(--font-label); text-transform: uppercase; letter-spacing: .08em; font-size: .69rem; color: var(--gold-ink); background: var(--gold-soft); border: 1px solid var(--rule-gold); border-radius: var(--radius-pill); padding: 1px 7px; line-height: 1.3; }\n
.dm-msgs {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 3px;\n
    min-width: 0;\n
}\n
.dm-line {\n
    display: flex;\n
    align-items: flex-start;\n
    gap: 6px;\n
    position: relative;\n
}\n
/* DM bubbles take the shared .formatted-content contract (family, size, ink,\n
   code/quote/list treatment) and deliberately override ONE thing: the paragraph\n
   rhythm. A chat bubble is sized to its own text, so the 1em block gap a forum\n
   post needs would leave it hollow. This is the only sanctioned divergence. */\n
.dm-body p { margin: 0; }\n
.dm-body p + p { margin-top: .7em; }\n
.dm-body :not(pre) > code { word-break: normal; overflow-wrap: anywhere; }\n
.dm-body pre { max-width: 100%; overflow-x: auto; }\n
/* Quoted reply → a gold-ruled italic blockquote (from the message's markdown). */\n
.dm-body blockquote {\n
    margin: 4px 0;\n
    padding: 2px 0 2px 14px;\n
    border-left: 2px solid var(--rule-gold);\n
    color: var(--text-muted);\n
    font-style: italic;\n
}\n
/* Mine — right-aligned, wearing the one ceremonial gold plate. */\n
.dm-group.mine {\n
    grid-template-columns: minmax(0, 1fr);\n
    margin-left: auto;\n
    justify-items: end;\n
}\n
.dm-group.mine .dm-ghead {\n
    flex-direction: row-reverse;\n
}\n
.dm-group.mine .dm-msgs { max-width: 100%; min-width: 0; }\n
.dm-group.mine .dm-line {\n
    flex-direction: row-reverse;\n
}\n
.dm-group.mine .dm-body {\n
    background: var(--gold-soft);\n
    border: 1px solid var(--dm-gold-line);\n
    border-radius: var(--radius-lg);\n
    padding: 8px 14px;\n
}\n
.dm-group.mine .dm-body blockquote { border-left-color: color-mix(in srgb, var(--rule-gold) 80%, var(--gold-soft)); }\n
/* Theirs — plain counsel on parchment; a right gutter holds the hover ···. */\n
.dm-group:not(.mine) .dm-body {\n
    padding: 1px 0;\n
}\n
.dm-group:not(.mine) .dm-line {\n
    padding-right: 26px;\n
}\n
/* Per-message hover ··· (report) — nothing visible until you reach for it. */\n
.dm-line-menu {\n
    position: absolute;\n
    top: 0;\n
    right: 0;\n
    opacity: 0;\n
    transition: opacity 140ms var(--ease-calm);\n
}\n
.dm-line:hover .dm-line-menu,\n
.dm-line:focus-within .dm-line-menu,\n
.dm-line-menu:has(details[open]) {\n
    opacity: 1;\n
}\n
.dm-dotbtn {\n
    display: inline-flex;\n
    align-items: center;\n
    justify-content: center;\n
    width: 24px;\n
    height: 24px;\n
    border-radius: var(--radius-sm);\n
    background: var(--surface-raised);\n
    border: 1px solid var(--border-hair);\n
    color: var(--text-muted);\n
    cursor: pointer;\n
    list-style: none;\n
}\n
.dm-dotbtn::-webkit-details-marker {\n
    display: none;\n
}\n
.dm-dotbtn:hover {\n
    color: var(--brand);\n
    border-color: var(--dm-brand-line);\n
}\n
.dm-dotbtn .icon {\n
    width: 15px;\n
    height: 15px;\n
}\n
/* Reference cards (linked topics / posts inside a message) — lightened. */\n
.reference-cards {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 6px;\n
    margin-top: 7px;\n
    max-width: 100%;\n
}\n
.reference-card {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 2px;\n
    text-decoration: none;\n
    border: 1px solid var(--border-hair);\n
    border-left: 3px solid var(--dm-accent);\n
    border-radius: var(--radius-sm);\n
    padding: 8px 12px;\n
    background: var(--surface-raised);\n
}\n
.reference-card:hover {\n
    border-color: color-mix(in srgb, var(--brand) 25%, var(--brand-subtle));\n
    box-shadow: var(--shadow-xs);\n
}\n
.reference-card .ref-type {\n
    font-family: var(--font-label);\n
    text-transform: uppercase;\n
    letter-spacing: .08em;\n
    font-size: .56rem;\n
    color: var(--dm-accent-ink);\n
}\n
.reference-card strong {\n
    font-family: var(--font-display);\n
    font-weight: var(--weight-medium);\n
    font-size: .98rem;\n
    color: var(--text-strong);\n
    line-height: 1.2;\n
}\n
.reference-card .ref-meta {\n
    font-family: var(--font-mono);\n
    font-size: .68rem;\n
    color: var(--text-muted);\n
}\n
/* Link previews now use the design system's own `.link-preview` component; its\n
   rules live with the thread stream's cards further down. The block that used to\n
   sit here dressed a `.reference-card` and had no markup left to match. */\n
/* Per-message report — opened from the hover ···, floats as a small card. */\n
.dm-report-form {\n
    position: absolute;\n
    z-index: 6;\n
    top: calc(100% + 4px);\n
    right: 0;\n
    width: max-content;\n
    max-width: 300px;\n
    display: flex;\n
    flex-wrap: wrap;\n
    gap: 8px;\n
    padding: 11px;\n
    background: var(--surface-raised);\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-md);\n
    box-shadow: var(--shadow-lg);\n
}\n
.dm-report-form .dm-copy {\n
    flex: 1 0 100%;\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 8px;\n
    text-align: left;\n
}\n
.dm-report-form .dm-copy .icon { width: 14px; height: 14px; color: var(--text-muted); }\n
.dm-report-form .input {\n
    font-size: .85rem;\n
}\n
.dm-report-form .input-small {\n
    flex: 1;\n
    min-width: 120px;\n
}\n
.dm-composer {\n
    flex: 0 0 auto;\n
    border-top: 1px solid var(--border-hair);\n
    padding: 12px 26px 16px;\n
    background: var(--dm-raised);\n
    display: flex;\n
    flex-direction: column;\n
    align-items: stretch;\n
    gap: 6px;\n
}\n
.dm-composer .composer-input {\n
    min-height: 58px;\n
}\n
/* Read receipt — a quiet line under my last letter. */\n
.dm-receipt-row { display: flex; justify-content: flex-end; }\n
.dm-receipt {\n
    font-family: var(--font-label);\n
    text-transform: uppercase;\n
    letter-spacing: .08em;\n
    font-size: .69rem;\n
    color: var(--text-faint);\n
    margin: 5px 2px 2px;\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 5px;\n
}\n
/* The new-messages pill: sticks to the foot of the stream while you read back. */\n
.dm-newpill {\n
    position: sticky; bottom: 6px; align-self: center; margin-top: 14px; z-index: 1;\n
    display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px 7px 11px;\n
    border: 0; border-radius: var(--radius-pill); cursor: pointer;\n
    background: var(--surface-inverse); color: var(--text-inverse);\n
    box-shadow: var(--shadow-lg);\n
    font-family: var(--font-label); font-size: .78rem; letter-spacing: .03em;\n
}\n
.dm-newpill .icon { width: 14px; height: 14px; }\n
.dm-newpill:hover { background: var(--brand); color: var(--surface-raised); }\n
.dm-events {\n
    margin-top: 2px;\n
}\n
.dm-events > summary { display: inline-flex; align-items: center; gap: 6px; }\n
/* A flash on the reading room floats as a quiet toast — the acknowledgement of\n
   tucked-away actions (mute, leave, report) — instead of pushing the shell\n
   down. :has() browsers only; others keep the standard flash plate. */\n
.main > .flash:has(+ .dm-shell) {\n
    position: fixed;\n
    left: 50%;\n
    bottom: 26px;\n
    transform: translateX(-50%);\n
    z-index: 80;\n
    margin: 0;\n
    max-width: 90vw;\n
    text-align: center;\n
    background: var(--surface-inverse);\n
    color: var(--text-inverse);\n
    border: 0;\n
    font-size: .92rem;\n
    padding: 10px 18px;\n
    border-radius: var(--radius-pill);\n
    box-shadow: var(--shadow-lg);\n
    animation: dm-toastfade 160ms var(--ease-calm) both;\n
}\n
@keyframes dm-toastfade { from { opacity: 0; } to { opacity: 1; } }\n
@media (prefers-reduced-motion: reduce) {\n
    .main > .flash:has(+ .dm-shell) { animation: none; }\n
}\n
/* ── Empty states ─────────────────────────────────────────────────────── */\n
.dm-empty {\n
    flex: 1;\n
    display: flex;\n
    align-items: center;\n
    justify-content: center;\n
    padding: 60px 24px;\n
}\n
.dm-empty-inner {\n
    text-align: center;\n
    max-width: 42ch;\n
    color: var(--text-muted);\n
}\n
.dm-empty-inner .star {\n
    color: var(--on-brand-subtle);\n
    opacity: .35;\n
}\n
.dm-empty-inner h2 {\n
    font-family: var(--font-display);\n
    font-weight: var(--weight-medium);\n
    font-size: 1.5rem;\n
    color: var(--text-strong);\n
    margin: 10px 0 6px;\n
}\n
.dm-empty-inner p {\n
    margin: 0;\n
    line-height: 1.55;\n
}\n
.dm-empty-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); margin: var(--space-4) 0 0; }\n
.dm-empty-note { display: flex; align-items: flex-start; gap: 8px; text-align: left; font-size: .9rem; line-height: 1.5; color: var(--text-muted); background: var(--dm-ground); border: 1px solid var(--border-hair); border-radius: var(--radius-md); padding: 10px 12px; margin: 14px 0 0; }\n
.dm-empty-note .icon { flex: 0 0 auto; width: 14px; height: 14px; margin-top: 4px; color: var(--dm-accent-ink); }\n
.dm-list-empty .dm-empty-actions { justify-content: flex-start; }\n
\n
/* ── The standalone New message page is the reading room ──────────────── */\n
.dm-compose {\n
    flex: 1;\n
    overflow-y: auto;\n
    min-height: 0;\n
    padding: 26px 32px 40px;\n
}\n
.dm-compose-wrap {\n
    max-width: 640px;\n
}\n
.dm-form {\n
    display: flex;\n
    flex-direction: column;\n
    gap: var(--space-4);\n
    align-items: stretch;\n
}\n
.dm-form .field { margin-bottom: 0; }\n
.dm-form .field-label { display: block; margin-bottom: var(--space-2); font-family: var(--font-label); font-size: var(--text-fine); font-weight: var(--weight-medium); color: var(--text-muted); }\n
.dm-form .dm-field-optional { font-family: var(--font-body); font-weight: var(--weight-regular); }\n
.dm-form [data-dm-picker] { display: flex; flex-direction: column; gap: var(--space-2); }\n
.dm-form .field-hint {\n
    font-family: var(--font-body);\n
    font-size: var(--text-fine);\n
    color: var(--text-muted);\n
    margin: 0;\n
}\n
.dm-dialog-body .field-hint { margin: 0; }\n
.dm-dialog-body .field-error { margin: 0; }\n
\n
/* ── Recipient picker: chips in the engraved field, suggestions in flow ── */\n
.dm-to-field-wrap { display: flex; flex-direction: column; gap: 6px; }\n
.dm-to-field { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 8px; min-height: 44px; cursor: text; }\n
/* The chip field wears the shared engraved-field focus on its container (the\n
   inner input is borderless), so it matches every other field (ADR 0034). */\n
.dm-to-field:focus-within { border-color: var(--rule-gold); outline: 2px solid var(--accent); outline-offset: 1px; box-shadow: var(--shadow-inset), 0 0 0 3px var(--focus-ring); }\n
.dm-to-field.is-invalid { border-color: var(--danger); }\n
.dm-to-chips { display: contents; }\n
.dm-chip { display: inline-flex; align-items: center; gap: 4px; padding: 2px 2px 2px 3px; border-radius: var(--radius-pill); background: var(--dm-sunken); border: 1px solid var(--dm-accent-line); font-family: var(--font-body); font-size: .94rem; line-height: 1; color: var(--text-strong); }\n
.dm-chip-mono { width: 20px; height: 20px; font-size: .5rem; }\n
.dm-chip-x { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border: 0; border-radius: 50%; background: none; color: var(--text-muted); cursor: pointer; }\n
.dm-chip-x .icon { width: 12px; height: 12px; }\n
.dm-chip-x:hover { background: var(--surface-raised); color: var(--danger); }\n
.dm-chip.is-invalid { border-color: var(--danger); background: color-mix(in srgb, var(--danger) 10%, var(--surface-raised)); }\n
.dm-to-input { flex: 1 1 140px; min-width: 120px; font: inherit; font-family: var(--font-body); font-size: 1rem; color: var(--text-body); padding: 4px 2px; }\n
/* The input is always the field's own child; the field draws the frame. */\n
.dm-to-field > .dm-to-input { border: 0; box-shadow: none; background: transparent; outline: none; }\n
.dm-to-input::placeholder { color: var(--text-faint); }\n
.dm-suggest { flex: 1 0 100%; list-style: none; margin: 2px -2px 0; padding: 4px 0 0; border-top: 1px solid var(--border-hair); display: flex; flex-direction: column; gap: 2px; }\n
.dm-to-field-wrap .dm-suggest { width: 100%; }\n
.dm-suggest-row { display: flex; align-items: center; gap: 10px; width: 100%; padding: 6px 8px; border: 0; border-radius: var(--radius-sm); background: transparent; text-align: left; cursor: pointer; min-height: 40px; }\n
.dm-suggest-row.is-active, .dm-suggest-row:hover { background: var(--dm-active-wash); }\n
.dm-suggest-row .monogram { width: 28px; height: 28px; font-size: .62rem; }\n
.dm-suggest-id { display: flex; flex-direction: column; min-width: 0; }\n
.dm-suggest-name { font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 1rem; line-height: 1.15; color: var(--text-strong); }\n
.dm-suggest-sub { font-family: var(--font-mono); font-size: .69rem; color: var(--text-muted); }\n
\n
/* Script-toggled parts hide with [hidden] even where a rule above sets display. */\n
.dm-newpill[hidden], .dm-presence[hidden], [data-dm-receipt][hidden],\n
[data-dm-group-title][hidden], .dm-suggest[hidden], [data-dm-unread-count][hidden] { display: none; }\n
\n
/* ── Width: list | conversation | details, and where the rail goes ─────── */\n
/* The details rail is on demand at every width: a column from 1400px (1700px\n
   beside the open board rail), a drawer over the conversation below that, a\n
   full overlay on phones. The enhanced toggle (.rail-open) and the no-JS\n
   anchor (#dm-rail :target) share the same open state; a closed rail leaves\n
   the focus order entirely. */\n
@media (min-width: 901px) {\n
    .dm-shell { grid-template-columns: minmax(272px, 312px) minmax(0, 1fr); }\n
    .dm-list-empty-first .dm-empty-actions, .dm-list-empty-first .dm-empty-note { display: none; }\n
}\n
@media (min-width: 1400px) {\n
    .dm-shell.has-rail { grid-template-columns: minmax(272px, 312px) minmax(0, 1fr); }\n
    .dm-shell.has-rail.rail-open,\n
    .dm-shell.has-rail:has(.dm-inforail:target) { grid-template-columns: minmax(272px, 300px) minmax(0, 1fr) minmax(264px, 300px); }\n
}\n
/* With the board rail open there is no room for a third column until ~1700px:\n
   the rail stays a drawer over the conversation, as it is below 1400px. */\n
@media (min-width: 1400px) and (max-width: 1699px) {\n
    .is-rail-open .dm-shell.has-rail.rail-open,\n
    .is-rail-open .dm-shell.has-rail:has(.dm-inforail:target) { grid-template-columns: minmax(272px, 312px) minmax(0, 1fr); }\n
    .is-rail-open .dm-shell.has-rail.rail-open .dm-inforail,\n
    .is-rail-open .dm-shell.has-rail:has(.dm-inforail:target) .dm-inforail {\n
        position: fixed; top: var(--topbar-h); right: 0; bottom: 0; width: min(340px, 92vw); z-index: 55;\n
        box-shadow: var(--shadow-xl);\n
    }\n
    .is-rail-open .dm-shell.has-rail.rail-open .dm-inforail { transform: translateX(0); }\n
    .is-rail-open .dm-shell.has-rail.rail-open .dm-rail-scrim,\n
    .is-rail-open .dm-inforail:target + .dm-rail-scrim { display: block; position: fixed; inset: var(--topbar-h) 0 0 0; z-index: 54; background: var(--scrim); }\n
}\n
@media (max-width: 1399px) {\n
    /* The rail floats over the conversation's right edge instead of squeezing a\n
       third column. No-JS: the header's details toggle (#dm-rail) opens it via\n
       :target and the scrim (an anchor to #) closes it; app.js adds the toggle\n
       button + Escape on top. */\n
    .dm-shell.has-rail { grid-template-columns: minmax(260px, 320px) minmax(0, 1fr); }\n
    .dm-inforail {\n
        position: fixed;\n
        top: var(--topbar-h);\n
        right: 0;\n
        bottom: 0;\n
        width: min(340px, 92vw);\n
        z-index: 55;\n
        box-shadow: var(--shadow-xl);\n
        /* Fixed descendants are positioned against .main's padded containing\n
           block here. Clear both the drawer width and that outer gutter so a\n
           closed rail cannot leave an actionable sliver in the viewport. */\n
        transform: translateX(calc(100% + 24px));\n
    }\n
    .dm-shell.has-rail.rail-open .dm-inforail { transform: translateX(0); }\n
    .dm-shell.has-rail.rail-open .dm-rail-scrim,\n
    .dm-inforail:target + .dm-rail-scrim { display: block; position: fixed; inset: var(--topbar-h) 0 0 0; z-index: 54; background: var(--scrim); }\n
}\n
@media (max-width: 1399px) and (prefers-reduced-motion: no-preference) {\n
    .dm-inforail { transition: transform 240ms var(--ease-calm); }\n
}\n
.dm-shell.has-rail:not(.rail-open):not(:has(.dm-inforail:target)) .dm-inforail { display: none; }\n
.dm-shell.has-rail:has(.dm-inforail:target) .dm-inforail { display: flex; transform: none; }\n
@media (max-width: 900px) {\n
    /* Single pane: list ↔ conversation with a back control; rail as a full overlay. */\n
    .dm-shell,\n
    .dm-shell.has-rail { grid-template-columns: 1fr; width: auto; margin-inline: -14px; }\n
    .dm-threadpane { display: none; }\n
    .dm-shell.reading .dm-listpane { display: none; }\n
    .dm-shell.reading .dm-threadpane { display: flex; }\n
    .dm-back { display: inline-flex; }\n
    .dm-inforail { width: 100vw; max-width: 100vw; }\n
    /* Presence drops under the count rather than vanishing behind an ellipsis. */\n
    .dm-thread-sub { white-space: normal; overflow: visible; text-overflow: clip; }\n
    .dm-scroll { padding: 16px 16px 18px; }\n
    .dm-group { max-width: 92%; }\n
    .dm-compose { padding: 18px 16px 32px; }\n
}\n
\n
/* ── Touch: hover-revealed controls must exist without hover ──────────── */\n
@media (hover: none) {\n
    .dm-line-menu { opacity: 1; }\n
    .dm-member-tools { opacity: 1; position: static; transform: none; flex-wrap: wrap; background: var(--dm-ground); padding: 0; }\n
    .dm-member { flex-wrap: wrap; }\n
    .dm-dotbtn { width: 28px; height: 28px; }\n
}\n
\n
/* ── Touch: 44px hit areas, icons and labels unchanged ────────────────────\n
   The app's own touch floor (">=44px" under "Accessibility + mobile polish"),\n
   keyed to a coarse pointer so a tablet showing both panes gets it too. The\n
   transparent header icons simply grow; a control whose box is drawn keeps\n
   its drawn size and takes the tap on a centred ::after of at least 44x44. */\n
@media (pointer: coarse) {\n
    .dm-back, .dm-iconbtn { width: 44px; height: 44px; }\n
    .dm-earlier, .dm-latest { min-height: 44px; }\n
    .dm-listpane-filters .pill, .dm-dotbtn { position: relative; }\n
    .dm-listpane-filters .pill::after, .dm-dotbtn::after {\n
        content: "";\n
        position: absolute;\n
        inset: min(0px, calc((100% - 44px) / 2));\n
    }\n
    /* A letter is at least as tall as its actions target, so two neighbouring\n
       letters' targets never overlap. */\n
    .dm-group:not(.mine) .dm-line { min-height: 44px; }\n
    /* Owner tools: two separate 44px targets in the secondary-button frame. */\n
    .dm-linkbtn { min-height: 44px; min-width: 44px; padding: 0 12px; background: var(--surface-raised); border: 1.5px solid var(--border-soft); border-radius: var(--radius-md); }\n
}\n
\n
/* — Moderation queues. —\n
   Slice 18 moved /mod/reports, /mod/approvals, /mod/appeals and /mod/u/{id}\n
   onto the shared operator console chrome (admin/_console), which ADR 0024\n
   decision 2 makes the eleventh area. That retired this surface's own\n
   `.mod`, `.mod-head`, `.mod-pill`, `.mod-subnav` and `.mod-pane` chrome --\n
   deleted here rather than left as dead rules, since nothing in templates/,\n
   public/assets/*.js or the specs referenced them once the swap landed.\n
   (2026-08-08: one `.mod` rule inside the <=860px block outlived that sweep and\n
   has now been removed too. mod-console.spec.ts pins all five names at zero.)\n
\n
   The queue count survives: the `mod-count` badge is `feature-added` (the\n
   design's tier models no counts), so it is kept and now rides the console's\n
   own tab. */\n
.mod-count {\n
    font-family: var(--font-mono);\n
    font-size: .68rem;\n
    line-height: 1;\n
    font-variant-numeric: tabular-nums;\n
    min-width: 18px;\n
    padding: 3px 6px;\n
    border-radius: var(--radius-pill);\n
    text-align: center;\n
    background: var(--surface-sunken);\n
    color: var(--text-muted);\n
    border: 1px solid var(--border-hair);\n
}\n
.admin-tab.is-active .mod-count {\n
    background: var(--gold-100);\n
    color: var(--gold-700);\n
    border-color: var(--gold-200);\n
}\n
.mod-count.is-urgent {\n
    background: #F3E2DC;\n
    color: var(--rust);\n
    border-color: color-mix(in srgb, var(--rust) 30%, transparent);\n
}\n
.report-list {\n
    list-style: none;\n
    padding: 0;\n
    margin: 0;\n
    display: flex;\n
    flex-direction: column;\n
    gap: 14px;\n
}\n
.report-row {\n
    background: var(--surface-raised);\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    padding: 16px 18px;\n
    box-shadow: var(--shadow-xs);\n
    border-left: 3px solid var(--border-soft);\n
}\n
.report-row.is-open {\n
    border-left-color: var(--accent-2);\n
}\n
.report-row.is-urgent {\n
    border-left-color: var(--rust);\n
}\n
.report-head {\n
    display: flex;\n
    align-items: center;\n
    gap: 9px;\n
    flex-wrap: wrap;\n
    margin-bottom: 10px;\n
}\n
.report-head .badge {\n
    white-space: nowrap;\n
}\n
.report-head .muted {\n
    font-family: var(--font-mono);\n
    font-size: .76rem;\n
}\n
.report-target {\n
    margin: 0 0 8px;\n
    font-family: var(--font-body);\n
    font-size: 1.05rem;\n
    color: var(--text-strong);\n
}\n
.report-target a {\n
    color: var(--brand);\n
    text-decoration: none;\n
    font-weight: var(--weight-medium);\n
}\n
.report-target a:hover {\n
    text-decoration: underline;\n
}\n
.report-target em {\n
    font-style: italic;\n
    color: var(--text-body);\n
}\n
.report-excerpt {\n
    margin: 0 0 10px;\n
    padding: 9px 14px;\n
    border-left: 3px solid var(--border-soft);\n
    background: var(--surface-sunken);\n
    border-radius: 0 var(--radius-md) var(--radius-md) 0;\n
    font-family: var(--font-body);\n
    font-size: .98rem;\n
    line-height: 1.55;\n
    color: var(--text-body);\n
}\n
.report-note {\n
    margin: 0 0 12px;\n
    color: var(--text-muted);\n
    font-style: italic;\n
}\n
.report-note::before {\n
    content: "\201C";\n
}\n
.report-note::after {\n
    content: "\201D";\n
}\n
.report-actions {\n
    display: flex;\n
    gap: 10px;\n
    align-items: center;\n
    flex-wrap: wrap;\n
    padding-top: 4px;\n
    border-top: 1px solid var(--border-hair);\n
    margin-top: 2px;\n
}\n
.appeal-resolve {\n
    margin-top: 12px;\n
    padding-top: 12px;\n
    border-top: 1px solid var(--border-hair);\n
    display: grid;\n
    grid-template-columns: 200px 1fr auto;\n
    gap: 10px 14px;\n
    align-items: end;\n
}\n
.appeal-resolve .field {\n
    width: 100%;\n
    max-width: none;\n
}\n
.appeal-resolve .field > span:first-child {\n
    display: block;\n
    font-family: var(--font-label);\n
    letter-spacing: .02em;\n
    font-size: .76rem;\n
    color: var(--text-muted);\n
    margin-bottom: 5px;\n
}\n
.appeal-resolve .btn {\n
    white-space: nowrap;\n
}\n
.approval-list {\n
    list-style: none;\n
    padding: 0;\n
    margin: 0 0 6px;\n
    display: flex;\n
    flex-direction: column;\n
    gap: 10px;\n
}\n
.approval-item {\n
    display: flex;\n
    align-items: flex-start;\n
    justify-content: space-between;\n
    gap: 16px;\n
    flex-wrap: wrap;\n
    background: var(--surface-raised);\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    padding: 14px 17px;\n
}\n
.approval-meta {\n
    min-width: 0;\n
    flex: 1 1 340px;\n
}\n
.approval-meta strong,\n
.approval-meta > a {\n
    font-family: var(--font-display);\n
    font-weight: var(--weight-medium);\n
    font-size: 1.12rem;\n
    color: var(--text-strong);\n
    display: block;\n
}\n
.approval-meta > a {\n
    color: var(--brand);\n
    text-decoration: none;\n
}\n
.approval-meta > a:hover {\n
    text-decoration: underline;\n
}\n
.approval-meta .muted {\n
    display: block;\n
    font-family: var(--font-mono);\n
    font-size: .74rem;\n
    margin-top: 3px;\n
}\n
.approval-meta > p {\n
    margin: 9px 0 0;\n
    font-family: var(--font-body);\n
    font-size: .98rem;\n
    line-height: 1.55;\n
    color: var(--text-body);\n
}\n
.approval-actions {\n
    display: flex;\n
    gap: 9px;\n
    align-items: center;\n
    flex: 0 0 auto;\n
}\n
.member-note {\n
    color: var(--text-muted);\n
    margin: 0 0 14px;\n
    max-width: 70ch;\n
}\n
.appeal-form {\n
    margin-top: 12px;\n
    padding-top: 12px;\n
    border-top: 1px solid var(--border-hair);\n
}\n
.appeal-form label {\n
    display: block;\n
    font-family: var(--font-label);\n
    letter-spacing: .02em;\n
    font-size: .78rem;\n
    color: var(--text-muted);\n
    margin-bottom: 6px;\n
}\n
.appeal-form .textarea-engraved {\n
    margin-bottom: 10px;\n
}\n
.resolution-note {\n
    margin: 10px 0 0;\n
    padding: 9px 13px;\n
    background: var(--surface-info);\n
    color: var(--on-info);\n
    border-radius: var(--radius-md);\n
    font-size: .92rem;\n
    box-shadow: inset 0 0 0 1px var(--river-200);\n
}\n
.resolution-note strong {\n
    font-family: var(--font-label);\n
    letter-spacing: .03em;\n
}\n
.error-list {\n
    background: #F3E2DC;\n
    color: var(--rust);\n
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--rust) 30%, transparent);\n
}\n
.error-list p {\n
    margin: 0;\n
}\n
\n
/*\n
   Imladris Design System import: reading rooms and control fidelity.\n
   These routes translate the imported reading UI kit into server-rendered\n
   PHP: home, board listings, feed, search, tags, notifications, compose,\n
   and profile connections.\n
*/\n
\n
.main > .read-main {\n
    margin: -24px;\n
    min-width: 0;\n
}\n
.read-pad {\n
    max-width: 880px;\n
    padding: 28px 34px 64px;\n
}\n
.board-header { margin-bottom: 18px; }\n
.board-header h1 { font-size: 1.95rem; margin: 0 0 4px; line-height: 1.1; }\n
.board-header > .muted { margin: 0; max-width: 70ch; line-height: 1.5; }\n
.board-header .breadcrumb { font-family: var(--font-mono); font-size: .8rem; color: var(--text-faint); margin: 0 0 8px; }\n
.board-header .breadcrumb a { color: var(--text-muted); text-decoration: none; }\n
.board-header .breadcrumb a:hover { color: var(--brand); }\n
.board-header .header-follow { display: inline-flex; align-items: center; gap: 12px; margin-top: 12px; }\n
.board-header .header-follow .muted { font-family: var(--font-mono); font-size: .74rem; white-space: nowrap; }\n
.empty { padding: 28px 0; }\n
\n
/* ══════════════════════════════════════════════════════════════════════════\n
   Board page (/c/{slug}) — the Imladris "Board page" template.\n
\n
   One wide primary column: an evergreen identity band over a ruled topic list\n
   whose order is stated, never offered as a toolbar. The row's six tracks are\n
   declared once, on the section, so the sticky header rules the columns\n
   beneath it instead of merely sitting above them.\n
   ══════════════════════════════════════════════════════════════════════════ */\n
.board-view {\n
    /* gutter · monogram · copy · status · activity · star */\n
    --board-row-cols: 10px 32px minmax(0, 1fr) 128px 104px 18px;\n
    --board-row-gap: 14px;\n
    /* The scrolled masthead's height. The topics header sticks below it, so\n
       the two never contend for the same offset. */\n
    --board-condensed-h: 46px;\n
}\n
/* Reading prefs turned avatars off. thread_row.php omits the monogram, and the\n
   section states the narrower track list for header and rows together — a\n
   :has() probe on the row alone would leave the header's columns behind. */\n
.board-view .board-topics.is-flat {\n
    --board-row-cols: 10px minmax(0, 1fr) 128px 104px 18px;\n
}\n
/* The row grew three right-hand tracks (status · activity · star). The column\n
   widens by roughly their width so the TITLE keeps the measure the density\n
   pass settled on, rather than being squeezed by its own furniture. */\n
.board-view.read-pad { max-width: 1080px; }\n
\n
.board-view .board-identity-breadcrumb {\n
    display: flex;\n
    align-items: center;\n
    flex-wrap: wrap;\n
    gap: 8px;\n
    margin: 0 0 12px;\n
    color: var(--text-faint);\n
    font-family: var(--font-mono);\n
    font-size: .73rem;\n
    letter-spacing: 0;\n
}\n
.board-view .board-identity-breadcrumb a { color: var(--text-muted); text-decoration: none; }\n
.board-view .board-identity-breadcrumb a:hover { color: var(--accent); }\n
.board-view .board-identity-breadcrumb .hash { color: var(--gold-ink); }\n
\n
/* The band. Its three approved values stay hex literals — Playwright asserts\n
   them, and the green/gold/parchment primitives have no twilight flip, so a\n
   token would either move the colour or break dark. The SECONDARY colours are\n
   tokens for the same reason in reverse: they do not flip either, so the slab\n
   reads identically in both registers. */\n
.board-view .board-identity {\n
    display: grid;\n
    grid-template-columns: minmax(0, 1fr) auto;\n
    align-items: end;\n
    gap: 18px 40px;\n
    padding: 19px 24px 17px;\n
    border-bottom: 3px solid #C29A44;\n
    background: #2E4A3A;\n
    color: #FAF6EC;\n
    box-shadow: var(--shadow-sm);\n
}\n
.board-view .board-identity-copy { min-width: 0; }\n
.board-view .board-identity .eyebrow {\n
    margin: 0;\n
    color: var(--green-100);\n
    font-size: .62rem;\n
    letter-spacing: .18em;\n
}\n
.board-view .board-identity h1 {\n
    margin: 4px 0 0;\n
    color: #FAF6EC;\n
    font-family: var(--font-display);\n
    font-size: clamp(1.9rem, 4.4vw, 2.3rem);\n
    font-weight: var(--weight-medium);\n
    letter-spacing: -.02em;\n
    line-height: 1.05;\n
    text-wrap: balance;\n
}\n
/* The hash steps back so the board's NAME is the word you read. Green-200, not\n
   the global gold rule — gold on evergreen is the accent, and the band already\n
   spends its gold on the bottom rule. */\n
.board-view .board-identity h1 .hash {\n
    width: auto;\n
    margin-right: 2px;\n
    color: var(--green-200);\n
    font-weight: var(--weight-regular);\n
}\n
.board-view .board-identity-description {\n
    max-width: 54ch;\n
    margin: 7px 0 0;\n
    color: var(--green-100);\n
    font-size: .98rem;\n
    line-height: 1.5;\n
    text-wrap: pretty;\n
}\n
.board-view .board-identity-aside {\n
    display: flex;\n
    flex-direction: column;\n
    align-items: flex-end;\n
    gap: 15px;\n
    min-width: 0;\n
}\n
/* A register, not a run-on sentence: each fact names itself and is ruled off\n
   from its neighbour, so "1,204" is never mistaken for the post count. */\n
.board-view .board-identity-facts {\n
    display: flex;\n
    align-items: stretch;\n
    margin: 0;\n
}\n
.board-view .board-identity-facts > div {\n
    padding: 0 22px;\n
    border-left: 1px solid var(--green-600);\n
    text-align: right;\n
}\n
.board-view .board-identity-facts > div:last-child { padding-right: 0; }\n
.board-view .board-identity-facts dt {\n
    color: var(--green-100);\n
    font-family: var(--font-label);\n
    font-size: .58rem;\n
    letter-spacing: .15em;\n
    text-transform: uppercase;\n
}\n
.board-view .board-identity-facts dd {\n
    margin: 4px 0 0;\n
    color: #FAF6EC;\n
    font-family: var(--font-mono);\n
    font-size: 1.04rem;\n
    font-variant-numeric: tabular-nums;\n
    line-height: 1;\n
}\n
.board-view .board-identity-actions { display: flex; flex: 0 0 auto; align-items: center; gap: 9px; }\n
.board-view .board-identity-actions form { display: flex; margin: 0; }\n
.board-view .board-identity-actions .btn {\n
    display: inline-flex;\n
    align-items: center;\n
    justify-content: center;\n
    gap: 7px;\n
    min-height: 36px;\n
    white-space: nowrap;\n
}\n
.board-view .board-identity-actions .btn-secondary {\n
    border-color: var(--green-100);\n
    background: var(--parchment-50);\n
    color: var(--green-800);\n
}\n
.board-view .board-identity-actions .btn-secondary:hover { background: #FFFDF6; }\n
.board-view .board-identity-actions .btn .icon { width: 13px; height: 13px; }\n
.board-view .board-identity-follow-note { margin: 10px 0 0; color: var(--text-faint); font-family: var(--font-mono); font-size: .68rem; line-height: 1.45; text-align: right; }\n
.board-view [data-open-topic-composer][hidden] { display: none; }\n
.has-js .board-view .js-native-topic-trigger { display: none; }\n
\n
/* Follow board, on-state + pending. .btn-on is the shared on-state; the button\n
   simply never asked for it. aria-busy is set by app.js on submit so the slow\n
   POST has a visible acknowledgement. */\n
.board-view .board-identity-actions .btn-on { border-color: var(--gold-500); }\n
.board-view .board-identity-actions .btn[aria-busy="true"] {\n
    background: var(--surface-sunken);\n
    color: var(--text-muted);\n
    cursor: progress;\n
    opacity: .8;\n
}\n
.board-view .board-identity-actions .btn[aria-busy="true"]::before {\n
    width: 12px;\n
    height: 12px;\n
    border: 2px solid var(--gold-200);\n
    border-top-color: var(--gold-600);\n
    border-radius: 50%;\n
    animation: rb-spin 620ms linear infinite;\n
    content: "";\n
}\n
@keyframes rb-spin { to { transform: rotate(360deg); } }\n
@media (prefers-reduced-motion: reduce) {\n
    .board-view .board-identity-actions .btn[aria-busy="true"]::before { animation: none; }\n
}\n
\n
/* Condensed board identity: a zero-height sticky wrapper, so the bar floats over\n
   the list and never adds flow height whether it is revealed or not — no height\n
   constant to keep in sync anywhere. app.js toggles .is-condensed from one\n
   IntersectionObserver on the slab. Slab colours stay hex literals here, matching\n
   the .board-identity block above. */\n
.board-view .board-identity-sticky {\n
    position: sticky;\n
    top: var(--topbar-h);\n
    z-index: 6;\n
    height: 0;\n
    overflow: visible;\n
}\n
.board-view .board-identity-condensed {\n
    display: flex;\n
    align-items: center;\n
    gap: 12px;\n
    min-height: var(--board-condensed-h);\n
    padding: 0 16px;\n
    border-bottom: 2px solid #C29A44;\n
    background: #2E4A3A;\n
    color: #FAF6EC;\n
    box-shadow: var(--shadow-md);\n
    opacity: 0;\n
    transform: translateY(-8px);\n
    transition: opacity var(--dur-base) var(--ease-calm), transform var(--dur-base) var(--ease-calm);\n
    pointer-events: none;\n
}\n
.board-view.is-condensed .board-identity-condensed {\n
    opacity: 1;\n
    transform: none;\n
    pointer-events: auto;\n
}\n
.board-view .board-identity-condensed h2 {\n
    margin: 0;\n
    /* A nowrap flex item's automatic minimum size is its full unwrapped width, so\n
       without min-width: 0 a long board name pushes New topic out of the pane —\n
       and the sticky wrapper is overflow: visible, so it escapes the viewport. */\n
    min-width: 0;\n
    overflow: hidden;\n
    color: #FAF6EC;\n
    font-family: var(--font-display);\n
    font-size: 1.05rem;\n
    font-weight: var(--weight-medium);\n
    line-height: 1;\n
    text-overflow: ellipsis;\n
    white-space: nowrap;\n
}\n
.board-view .board-identity-condensed h2 .hash { color: #C29A44; }\n
.board-view .board-identity-condensed-facts {\n
    color: var(--green-100);\n
    font-family: var(--font-mono);\n
    font-size: .6rem;\n
    white-space: nowrap;\n
}\n
.board-view .board-identity-condensed .btn {\n
    min-height: 28px;\n
    margin-left: auto;\n
    padding: 0 12px;\n
    font-size: .72rem;\n
}\n
@media (prefers-reduced-motion: reduce) {\n
    .board-view .board-identity-condensed { transition: none; }\n
}\n
/* No JS: nothing toggles .is-condensed, so the slab stays the only masthead. */\n
html:not(.has-js) .board-view .board-identity-sticky { display: none; }\n
\n
/* The two banners share the archived chassis: a quiet well with a gold rule\n
   stating that the sentence is about this board, not about your topic. */\n
.board-view .joinbar {\n
    display: block;\n
    margin-top: 14px;\n
    padding: 14px 18px;\n
    border: 1px solid var(--border-hair);\n
    border-left: 3px solid var(--rule-gold);\n
    border-radius: var(--radius-lg);\n
    background: var(--surface-sunken);\n
    color: var(--text-body);\n
    font-size: .96rem;\n
    line-height: 1.55;\n
    text-wrap: pretty;\n
}\n
.board-view .joinbar a { color: var(--accent); }\n
\n
/* The composer states its destination once, at the top of the panel, so the\n
   board is never in doubt when the panel is a centred modal. NOT scoped to\n
   .board-view: it is rendered inside the <form> (new_thread_form.php) so that\n
   it travels into the modal, and `.composer-details[open] > .composer` is what\n
   gets lifted — anything left outside the form stays behind the scrim. */\n
.composer-scope-eyebrow {\n
    margin: 0 0 14px;\n
    color: var(--gold-ink);\n
    font-family: var(--font-label);\n
    font-size: .66rem;\n
    letter-spacing: .16em;\n
    text-transform: uppercase;\n
}\n
\n
.board-view .board-topics { margin-top: 22px; }\n
/* Sticky BELOW the condensed masthead, never at the same offset: the bar is\n
   z-index 6, so a header sharing its top would slide underneath and vanish. */\n
.board-view .board-topics-heading {\n
    position: sticky;\n
    /* No allowance for the bar's gold rule: box-sizing is border-box here, so\n
       the rule sits INSIDE --board-condensed-h. Adding for it would leave a\n
       2px band of scrolling rows visible between the two sticky elements. */\n
    top: calc(var(--topbar-h) + var(--board-condensed-h));\n
    z-index: 4;\n
    display: grid;\n
    grid-template-columns: var(--board-row-cols);\n
    /* end, not baseline: the left cluster is two stacked lines, and the unread\n
       count belongs beside the heading it counts — not beside the eyebrow. */\n
    align-items: end;\n
    gap: 0 var(--board-row-gap);\n
    padding: 9px 6px 7px;\n
    background: var(--surface-page);\n
    border-bottom: 1px solid var(--border-soft);\n
}\n
html:not(.has-js) .board-view .board-topics-heading { top: var(--topbar-h); }\n
.board-view .board-topics-heading-main {\n
    grid-column: 1 / 4;\n
    display: flex;\n
    align-items: baseline;\n
    flex-wrap: wrap;\n
    gap: 0 10px;\n
    min-width: 0;\n
}\n
.board-view .board-topics-heading .eyebrow { flex-basis: 100%; margin: 0 0 1px; }\n
.board-view .board-topics-heading h2 {\n
    margin: 0;\n
    font-family: var(--font-display);\n
    font-size: 1.12rem;\n
    font-weight: var(--weight-medium);\n
    letter-spacing: -.01em;\n
    line-height: 1.2;\n
}\n
.board-view .board-topics-order {\n
    flex: 0 1 auto;\n
    min-width: 0;\n
    margin: 0;\n
    overflow: hidden;\n
    color: var(--text-faint);\n
    font-family: var(--font-mono);\n
    font-size: .66rem;\n
    text-overflow: ellipsis;\n
    white-space: nowrap;\n
}\n
.board-view .board-topics-heading-aside {\n
    grid-column: 4 / -1;\n
    display: flex;\n
    align-items: baseline;\n
    justify-content: flex-end;\n
    gap: 14px;\n
    min-width: 0;\n
}\n
.board-view .board-topics-heading-aside form { margin: 0; }\n
.board-view .board-topics-unread {\n
    color: var(--gold-ink);\n
    font-family: var(--font-mono);\n
    font-size: .68rem;\n
    white-space: nowrap;\n
}\n
.board-view .board-topics-markread {\n
    padding: 0;\n
    border: 0;\n
    background: none;\n
    color: var(--text-muted);\n
    font-family: var(--font-label);\n
    font-size: .74rem;\n
    letter-spacing: .03em;\n
    white-space: nowrap;\n
    cursor: pointer;\n
}\n
.board-view .board-topics-markread:hover { color: var(--accent); }\n
\n
.board-view .board-topics-list { margin-top: 0; }\n
.board-view .board-topics-list > .thread-row-board + .thread-row-board { border-top: 0; }\n
/* The row is the header's grid, repeated: gutter · monogram · copy · status ·\n
   activity · star. The gutter and the star are always emitted, so read and\n
   unread, starred and unstarred rows share one left and one right edge. */\n
.board-view .thread-row-board {\n
    display: grid;\n
    grid-template-columns: var(--board-row-cols);\n
    column-gap: var(--board-row-gap);\n
    align-items: center;\n
    min-height: 64px;\n
    padding: 9px 6px;\n
    border-bottom: 1px solid var(--border-hair);\n
    border-radius: 0;\n
    background: none;\n
    box-shadow: none;\n
    overflow: hidden;\n
}\n
.board-view .thread-row-board > .monogram { width: 32px; height: 32px; font-size: .6rem; }\n
/* The board is a presentation, not a density. The compact register's one-line\n
   rules belong to the default list, and they reach this row too: they made the\n
   copy column a flex row, so a long meta line squeezed the title into a column\n
   of single clipped words. The copy stacks at every density. */\n
.board-view .thread-row-board .thread-row-main { min-width: 0; display: block; }\n
.board-view .thread-row-board > .unread-slot { display: flex; justify-content: center; }\n
.board-view .thread-row-board > .unread-slot .unread-dot { margin-right: 0; }\n
/* The marker is a real control: 16px of ink inside a 24px hit area that\n
   overflows the 10px track on both sides rather than widening it. */\n
.board-view .unread-form { display: flex; margin: 0; }\n
.board-view .unread-toggle {\n
    display: inline-flex;\n
    align-items: center;\n
    justify-content: center;\n
    width: 24px;\n
    height: 24px;\n
    margin: -4px -7px;\n
    padding: 0;\n
    border: 0;\n
    border-radius: 50%;\n
    background: none;\n
    cursor: pointer;\n
}\n
.board-view .unread-toggle:hover { background: var(--surface-sunken); }\n
.board-view .unread-ring {\n
    width: 7px;\n
    height: 7px;\n
    border: 1.5px solid var(--border-soft);\n
    border-radius: 50%;\n
    box-sizing: border-box;\n
}\n
\n
/* Title line — the title leads, and the marks that qualify it ride beside it.\n
   Status does not: it has its own column, after the title. */\n
.board-view .thread-row-board .thread-title-line {\n
    display: flex;\n
    align-items: baseline;\n
    flex-wrap: wrap;\n
    gap: 3px 9px;\n
    min-width: 0;\n
}\n
.board-view .thread-row-board .thread-title {\n
    flex: 0 1 auto;\n
    min-width: 0;\n
    overflow: visible;\n
    font-size: 1.14rem;\n
    line-height: 1.3;\n
    letter-spacing: -.005em;\n
    text-overflow: clip;\n
    white-space: normal;\n
    text-wrap: pretty;\n
}\n
.board-view .thread-row-board .thread-mark {\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 4px;\n
    font-family: var(--font-label);\n
    font-size: .6rem;\n
    letter-spacing: .12em;\n
    text-transform: uppercase;\n
}\n
.board-view .thread-row-board .thread-mark .icon { width: 9px; height: 9px; }\n
.board-view .thread-row-board .thread-mark.is-pinned { color: var(--gold-ink); }\n
.board-view .thread-row-board .thread-mark.is-locked { color: var(--text-faint); }\n
/* Unread is weight and ink, not a second badge. */\n
.board-view .thread-row-board .thread-title { font-weight: var(--weight-medium); color: var(--text-body); }\n
.board-view .thread-row-board.thread-unread .thread-title { font-weight: var(--weight-semibold); color: var(--text-strong); }\n
\n
.board-view .thread-row-board .thread-meta {\n
    display: flex;\n
    align-items: baseline;\n
    flex-wrap: wrap;\n
    gap: 2px 10px;\n
    margin-top: 3px;\n
    color: var(--text-muted);\n
    font-family: var(--font-body);\n
    font-size: .86rem;\n
    white-space: normal;\n
}\n
/* The design system hides .thread-meta-author by default — the card presentation\n
   carries the author in its own byline — and re-enables it per list variant.\n
   The board list is one of those variants. */\n
.board-view .thread-row-board .thread-meta-author { display: inline; color: var(--text-muted); }\n
.board-view .thread-row-board .thread-meta-aside { color: var(--text-faint); }\n
\n
/* Status, stated once, in a column of its own. Reserved whether or not this\n
   topic has one, so the activity column never shifts between rows. */\n
.board-view .thread-row-status { display: flex; justify-content: flex-end; min-width: 0; }\n
.board-view .thread-row-status .chip {\n
    padding: 2px 9px;\n
    font-size: .58rem;\n
    letter-spacing: .14em;\n
    white-space: nowrap;\n
}\n
.board-view .thread-row-status .chip .icon { width: 9px; height: 9px; }\n
\n
/* Activity — when it last moved, then how much of it there is. */\n
.board-view .thread-row-activity {\n
    display: flex;\n
    flex-direction: column;\n
    align-items: flex-end;\n
    gap: 3px;\n
    width: auto;\n
    font-family: var(--font-mono);\n
    font-size: .68rem;\n
    font-variant-numeric: tabular-nums;\n
    line-height: 1.35;\n
    text-align: right;\n
}\n
.board-view .thread-row-activity time { color: var(--text-body); white-space: nowrap; }\n
.board-view .thread-row-activity .thread-row-replies { color: var(--text-faint); white-space: nowrap; }\n
\n
.board-view .thread-row-star { text-align: center; line-height: 1; }\n
.board-view .thread-row-board .thread-star { margin-left: 0; padding-left: 0; }\n
\n
/* The empty board still shows its heading and its column ruler; only the list\n
   is missing, and the mark says so without a sentence. */\n
.board-view .board-empty { padding: 58px 16px; text-align: center; }\n
.board-view .board-empty-mark { width: 30px; height: 30px; color: var(--gold-600); opacity: .35; }\n
.board-view .board-empty-headline {\n
    margin: 12px 0 4px;\n
    color: var(--text-strong);\n
    font-family: var(--font-display);\n
    font-size: 1.45rem;\n
}\n
.board-view .board-empty-sub { margin: 0 0 18px; color: var(--text-muted); font-size: .97rem; }\n
.board-view .board-empty-cta { display: inline-flex; align-items: center; min-height: 32px; }\n
\n
/* Pagination states where you are, then offers the only two moves. */\n
.pagination-board { display: flex; align-items: center; gap: 12px; margin-top: 20px; }\n
.pagination-board .pagination-count {\n
    flex: 1 1 auto;\n
    color: var(--text-faint);\n
    font-family: var(--font-mono);\n
    font-size: .74rem;\n
}\n
.pagination-board .page {\n
    padding: 6px 14px;\n
    border: 1px solid var(--border-soft);\n
    border-radius: var(--radius-md);\n
    color: var(--text-body);\n
    font-family: var(--font-label);\n
    font-size: .78rem;\n
    text-decoration: none;\n
}\n
.pagination-board a.page:hover { background: var(--surface-sunken); }\n
.pagination-board .page.is-disabled { border-color: var(--border-hair); color: var(--text-faint); }\n
\n
/* show_avatars = false: thread_row.php already omits the monogram; the section\n
   class (not a :has() probe) drops the track for header and rows together. */\n
.board-view .board-topics.is-flat .thread-row-board { min-height: 56px; }\n
\n
/* Hover previews the target by tinting the title, so pointing at the row says\n
   "this row" and not "somewhere in here". Status now owns a column, so the row\n
   no longer carries a 3px status rule on its left edge — stating it twice was\n
   the reason the rule had to survive hover and focus at all.\n
   Focus is drawn INSET: the row clips its own ring (overflow: hidden), so the\n
   global :focus-visible outline on .thread-title is suppressed and re-expressed\n
   here. :has(…:focus-visible) rather than :focus-within so a mouse click\n
   doesn't trigger it. */\n
.board-view .thread-row-board::before { display: none; }\n
.board-view .thread-row-board:hover { background: var(--surface-raised); }\n
.board-view .thread-row-board:hover .thread-title { color: var(--accent); }\n
.board-view .thread-row-board:has(.thread-title:focus-visible) {\n
    background: var(--brand-subtle);\n
    box-shadow: inset 0 0 0 2px var(--accent), inset 0 0 0 5px var(--focus-ring);\n
}\n
/* The suppression carries the same :has() gate as its replacement on purpose: an\n
   engine without :has() drops both together and the global outline survives,\n
   rather than dropping only the ring and leaving focus with no indicator. */\n
.board-view .thread-row-board:has(.thread-title:focus-visible) .thread-title:focus-visible { outline: 0; }\n
\n
\n
.feed-tabs { margin: 0 0 18px; }\n
.feed-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }\n
.feed-item { padding: 15px 17px; border: 1px solid var(--border-hair); border-radius: var(--radius-lg); background: var(--surface-raised); box-shadow: var(--shadow-xs); }\n
.feed-meta { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }\n
.feed-meta .post-author { font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: 1.02rem; color: var(--text-strong); text-decoration: none; }\n
.feed-meta .post-author:hover { color: var(--brand); }\n
.feed-meta .muted { font-family: var(--font-body); font-style: italic; font-size: .9rem; }\n
.feed-meta .post-time { margin-left: auto; font-family: var(--font-mono); font-size: .72rem; color: var(--text-faint); }\n
.feed-thread { display: block; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 1.22rem; color: var(--text-strong); text-decoration: none; line-height: 1.25; }\n
.feed-thread:hover { color: var(--brand); }\n
.feed-item > .muted { display: block; margin-top: 3px; font-family: var(--font-mono); font-size: .76rem; }\n
.feed-item > .muted .hash { color: var(--gold-ink); }\n
.feed-excerpt { margin: 8px 0 0; font-family: var(--font-body); font-size: 1rem; line-height: 1.6; color: var(--text-body); }\n
\n
.search-form { display: flex; gap: 10px; margin-top: 14px; max-width: 560px; }\n
.search-form .input { flex: 1; }\n
.search-results { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }\n
.search-result { padding-bottom: 14px; border-bottom: 1px solid var(--border-hair); }\n
.search-title { display: inline-flex; align-items: baseline; gap: 9px; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 1.2rem; color: var(--brand); text-decoration: none; line-height: 1.3; }\n
.search-title:hover { text-decoration: underline; }\n
.search-board { display: block; margin: 4px 0 6px; font-family: var(--font-mono); font-size: .76rem; }\n
.search-board a { color: var(--gold-ink); text-decoration: none; }\n
.search-board .hash { color: var(--gold-ink); }\n
.search-snippet { margin: 0; font-family: var(--font-body); font-size: 1rem; line-height: 1.6; color: var(--text-muted); }\n
.search-snippet mark { background: var(--gold-100); color: var(--text-strong); border-radius: 2px; padding: 0 2px; }\n
\n
.tag-cloud { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }\n
.tag-cloud li { min-width: 0; }\n
.tag-card {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 4px;\n
    text-decoration: none;\n
    padding: 12px 15px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    background: var(--surface-raised);\n
    box-shadow: var(--shadow-xs);\n
    width: 240px;\n
    transition: box-shadow var(--dur-fast) var(--ease-calm), border-color var(--dur-fast) var(--ease-calm), transform var(--dur-fast) var(--ease-calm);\n
}\n
.tag-card:hover { box-shadow: var(--shadow-md); border-color: var(--green-200); transform: translateY(-1px); }\n
.tag-card .tag-name { display: inline-flex; align-items: baseline; gap: 6px; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 1.1rem; color: var(--text-strong); }\n
.tag-card .tag-name::before { content: "#"; color: var(--gold-ink); }\n
.tag-card .tag-count { font-family: var(--font-mono); font-size: .72rem; color: var(--text-faint); }\n
.tag-card .tag-desc { font-family: var(--font-body); font-size: .9rem; color: var(--text-muted); line-height: 1.45; }\n
\n
.notifications-view .board-header h1 { display: inline-flex; align-items: center; gap: 12px; }\n
/* Per-type icon, stacked text/thread body, and the trailing unread dot (§notifications). */\n
\n
.conn-tabs { margin: 0 0 16px; }\n
.people-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }\n
.person-row { display: flex; align-items: center; gap: 12px; padding: 11px 12px; border-radius: var(--radius-md); }\n
.person-row:hover { background: var(--surface-sunken); }\n
.person-row .monogram { width: 40px; height: 40px; font-size: .86rem; flex: 0 0 auto; }\n
.person-name { font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 1.08rem; color: var(--text-strong); text-decoration: none; }\n
.person-name:hover { color: var(--brand); }\n
.person-row .handle { font-family: var(--font-mono); font-size: .78rem; color: var(--text-muted); }\n
.person-rep { margin-left: auto; font-family: var(--font-mono); font-size: .76rem; color: var(--text-faint); white-space: nowrap; }\n
\n
.compose-page { max-width: 720px; }\n
.compose-page h1 { font-size: 1.9rem; margin: 0 0 6px; }\n
.compose-page .composer.stacked { display: flex; flex-direction: column; gap: 15px; align-items: stretch; }\n
.compose-page .field { width: 100%; max-width: none; }\n
.compose-page .field > span:first-child { display: block; font-family: var(--font-label); letter-spacing: .02em; font-size: .8rem; color: var(--text-muted); margin-bottom: 6px; }\n
.compose-page .composer-input, .compose-page textarea.input { width: 100%; resize: vertical; }\n
.compose-page .checkline { display: flex; align-items: flex-start; gap: 9px; font-family: var(--font-body); font-size: .92rem; color: var(--text-body); line-height: 1.5; }\n
.compose-page .checkline input { margin-top: 4px; flex: 0 0 auto; }\n
.compose-page .md-hint { font-family: var(--font-body); font-size: .9rem; color: var(--text-faint); line-height: 1.5; margin: 0; }\n
.compose-page .md-hint code { font-family: var(--font-mono); font-size: .85em; background: var(--surface-sunken); padding: 1px 5px; border-radius: var(--radius-sm); }\n
\n
/* The 11px chamfer this surface used to override .choice-card with is gone\n
   (ADR 0033). The plain definition further up the file — 1.5px --border-soft\n
   on a 12px radius, --border-strong on hover, --accent when checked, and a\n
   real outline on :focus-within — is the whole paint again. */\n
/* The selected-state marker: a dot, not a diamond (ADR 0033). It reads as the\n
   unread dot the rest of the system already uses, and its offsets no longer\n
   have to dodge an 11px chamfer. */\n
.choice-card::after {\n
    content: "";\n
    position: absolute;\n
    top: 12px;\n
    right: 13px;\n
    width: 7px;\n
    height: 7px;\n
    background: var(--gold-400);\n
    border-radius: 50%;\n
    opacity: .3;\n
    transition: opacity var(--dur-fast) var(--ease-calm), background var(--dur-fast) var(--ease-calm);\n
}\n
\n
.choice-card:has(input:checked) { background-color: var(--brand-subtle); }\n
.choice-card:has(input:checked)::after { opacity: 1; background: var(--gold-500); }\n
.switch {\n
    width: 42px;\n
    height: 24px;\n
    background: var(--surface-page);\n
    border: 1.5px solid var(--border-strong);\n
    box-shadow: var(--shadow-inset);\n
    transition: background var(--dur-base) var(--ease-calm), border-color var(--dur-base) var(--ease-calm);\n
}\n
.switch::before {\n
    top: 2px;\n
    left: 2px;\n
    width: 18px;\n
    height: 18px;\n
    background: var(--parchment-50);\n
    box-shadow: var(--shadow-sm), inset 0 0 0 1.5px var(--gold-200);\n
    transition: transform var(--dur-base) var(--ease-calm), background var(--dur-base) var(--ease-calm), box-shadow var(--dur-base) var(--ease-calm);\n
}\n
.switch:checked { background: var(--accent); border-color: var(--brand-press); }\n
.switch:checked::before { transform: translateX(18px); background: var(--gold-200); box-shadow: var(--shadow-sm), inset 0 0 0 1.5px var(--gold-500); }\n
\n
/* Imladris feature-activation import: concrete server-rendered surfaces for the\n
   feature-ui handoff bundle. */\n
.feature-activation-index {\n
    margin-bottom: 22px;\n
    position: relative;\n
    overflow: hidden;\n
}\n
.feature-activation-lede {\n
    max-width: 68ch;\n
    margin-bottom: 20px;\n
}\n
.feature-activation-lede h2 {\n
    margin: 4px 0 8px;\n
    font-family: var(--font-display);\n
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);\n
    font-weight: 500;\n
    color: var(--text-strong);\n
}\n
.feature-activation-lede p {\n
    margin: 0;\n
    color: var(--text-body);\n
    font-size: 1.04rem;\n
    line-height: 1.58;\n
}\n
.feature-status-legend {\n
    display: flex;\n
    flex-wrap: wrap;\n
    gap: 8px 18px;\n
    margin: 16px 0 22px;\n
    padding: 12px 14px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    background: var(--surface-raised);\n
}\n
.feature-status-legend span,\n
.feature-flag-list li {\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 8px;\n
}\n
.feature-status-dot {\n
    width: 9px;\n
    height: 9px;\n
    border-radius: var(--radius-pill);\n
    flex: none;\n
    background: var(--border-strong);\n
}\n
.feature-status-dot.ready { background: var(--success); box-shadow: 0 0 0 3px var(--surface-done); }\n
.feature-status-dot.near { background: var(--accent-2); box-shadow: 0 0 0 3px var(--gold-soft); }\n
.feature-status-dot.blocked { background: var(--warning); box-shadow: 0 0 0 3px var(--surface-review); }\n
.feature-status-dot.ahead { background: var(--pending); box-shadow: 0 0 0 3px var(--surface-sunken); }\n
.feature-area-grid {\n
    display: grid;\n
    grid-template-columns: repeat(2, minmax(0, 1fr));\n
    gap: 14px;\n
}\n
.feature-area-card {\n
    position: relative;\n
    padding: 18px 20px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    background: var(--surface-raised);\n
    box-shadow: var(--shadow-xs);\n
}\n
.feature-area-top {\n
    display: flex;\n
    align-items: center;\n
    gap: 10px;\n
    margin-bottom: 10px;\n
}\n
.feature-area-num {\n
    font-family: var(--font-mono);\n
    font-size: .76rem;\n
    color: var(--gold-ink);\n
}\n
.feature-area-summary {\n
    margin-left: auto;\n
    padding: 3px 10px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-pill);\n
    background: var(--surface-sunken);\n
    color: var(--text-muted);\n
    font-family: var(--font-label);\n
    font-size: .66rem;\n
    letter-spacing: .08em;\n
    text-transform: uppercase;\n
}\n
.feature-area-card h3 {\n
    margin: 0 0 7px;\n
    font-family: var(--font-display);\n
    font-size: 1.32rem;\n
    font-weight: 500;\n
    color: var(--text-strong);\n
}\n
.feature-area-card p {\n
    margin: 0 0 14px;\n
    color: var(--text-body);\n
    line-height: 1.5;\n
}\n
.feature-flag-list {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 7px;\n
    margin: 0;\n
    padding: 0;\n
    list-style: none;\n
}\n
.feature-flag-list code {\n
    color: var(--text-strong);\n
}\n
.feature-flag-list li > span:last-child {\n
    margin-left: auto;\n
    color: var(--text-muted);\n
    font-family: var(--font-label);\n
    font-size: .68rem;\n
    letter-spacing: .06em;\n
    text-transform: uppercase;\n
}\n
.feature-flag-list li.is-enabled > span:last-child {\n
    color: var(--on-done);\n
}\n
\n
.personal-org-grid {\n
    display: grid;\n
    grid-template-columns: repeat(2, minmax(0, 1fr));\n
    gap: 16px;\n
}\n
.org-card {\n
    padding: 18px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    background: var(--surface-raised);\n
    box-shadow: var(--shadow-xs);\n
}\n
.org-card-head {\n
    display: flex;\n
    align-items: flex-start;\n
    gap: 12px;\n
    margin-bottom: 14px;\n
}\n
.org-card h2 {\n
    margin: 0 0 4px;\n
    font-family: var(--font-display);\n
    font-size: 1.24rem;\n
    font-weight: 500;\n
}\n
.org-card p {\n
    margin: 0;\n
}\n
.org-icon {\n
    display: inline-grid;\n
    place-items: center;\n
    width: 32px;\n
    height: 32px;\n
    border-radius: var(--radius-md);\n
    background: var(--surface-sunken);\n
    border: 1px solid var(--border-hair);\n
    color: var(--gold-ink);\n
    font-family: var(--font-label);\n
}\n
.org-star {\n
    color: var(--star);\n
}\n
.org-empty {\n
    padding: 12px;\n
    border: 1px dashed var(--border-hair);\n
    border-radius: var(--radius-md);\n
    color: var(--text-muted);\n
}\n
.org-folder-list {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 9px;\n
    margin: 0 0 14px;\n
    padding: 0;\n
    list-style: none;\n
}\n
.org-folder {\n
    display: grid;\n
    grid-template-columns: minmax(0, 1fr) auto;\n
    gap: 4px 10px;\n
    padding: 11px 12px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-sunken);\n
}\n
.org-folder-name {\n
    font-weight: 650;\n
    color: var(--text-strong);\n
}\n
.org-count {\n
    color: var(--gold-ink);\n
    font-family: var(--font-mono);\n
    font-size: .78rem;\n
}\n
.org-items {\n
    grid-column: 1 / -1;\n
    display: flex;\n
    flex-wrap: wrap;\n
    gap: 6px 10px;\n
    color: var(--text-muted);\n
    font-size: .92rem;\n
}\n
.org-items a {\n
    color: var(--brand);\n
}\n
.org-form {\n
    margin-top: 8px;\n
}\n
\n
/* The `.wf-*` family (the workflow action bar, its buttons and its history\n
   list) was deleted here: no template, script or test emits any of it. It also\n
   carried the one genuine pill-radius violation in the file — `.wf-btn` is a\n
   button by name and by role, DESIGN.md reserves the pill for tokens, and the\n
   design system's own mock for this class\n
   (feature-ui/moderation/index.html) draws it on a plain radius. */\n
\n
/* The poll is a sunken panel, not a raised card with a gold rule down its edge\n
   (ThreadView.dc.html:453). Raised-on-raised put it at the same elevation as the\n
   post above it, and the rule spent the surface's one --rule-gold on a ballot. */\n
.poll-card {\n
    margin: 14px 0 6px;\n
    padding: 15px 17px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-sunken);\n
}\n
.builder-head {\n
    display: flex;\n
    align-items: center;\n
    gap: 10px;\n
    margin-bottom: 12px;\n
}\n
/* One eyebrow line carries the whole state. It used to be three objects: a gold\n
   ✦ tile, a two-line Poll / Choose-one label beside it, and an OPEN pill on the\n
   far right — three announcements of a control the question below them names. */\n
.poll-eyebrow {\n
    display: flex;\n
    align-items: center;\n
    gap: 7px;\n
    margin: 0 0 6px;\n
    font-family: var(--font-label);\n
    font-size: var(--text-chip);\n
    letter-spacing: .16em;\n
    text-transform: uppercase;\n
    color: var(--text-faint);\n
}\n
.poll-eyebrow-mode { letter-spacing: .12em; }\n
.builder-hint {\n
    display: block;\n
    color: var(--text-muted);\n
    font-size: .9rem;\n
}\n
.poll-question {\n
    margin: 0 0 11px;\n
    font-family: var(--font-display);\n
    font-size: var(--text-size-body);\n
    font-weight: var(--weight-semibold);\n
    line-height: 1.35;\n
    color: var(--text-strong);\n
    text-wrap: pretty;\n
}\n
.poll-options,\n
.poll-read {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 6px;\n
}\n
.poll-read {\n
    margin: 0;\n
    padding: 0;\n
    list-style: none;\n
}\n
.poll-read li {\n
    padding: 10px 13px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-raised);\n
    color: var(--text-body);\n
    font-size: var(--text-sm);\n
    line-height: 1.45;\n
}\n
/* An unchosen option is RAISED on the sunken panel — sunken-on-sunken made three\n
   ballot rows read as one field of tan. Chosen fills --brand-subtle and takes\n
   the evergreen edge, which is how every other selected state in the system\n
   states itself. */\n
.poll-option {\n
    display: flex;\n
    align-items: center;\n
    gap: 10px;\n
    padding: 10px 13px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-raised);\n
    color: var(--text-body);\n
    font-size: var(--text-sm);\n
    line-height: 1.45;\n
    cursor: pointer;\n
}\n
.poll-option:hover { border-color: var(--green-200); background: var(--brand-subtle); }\n
.poll-option:has(input:checked) {\n
    border-color: var(--green-200);\n
    background: var(--brand-subtle);\n
    color: var(--text-strong);\n
}\n
.poll-option input {\n
    accent-color: var(--accent);\n
}\n
.poll-results {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 11px;\n
}\n
/* A result is a line and a bar, not a card: three bordered boxes inside a\n
   bordered panel drew four nested edges for one question. */\n
.poll-result {\n
    display: block;\n
    padding: 0;\n
    border: 0;\n
    border-radius: 0;\n
    background: none;\n
}\n
.poll-result-row {\n
    display: flex;\n
    align-items: baseline;\n
    gap: 8px;\n
    font-size: var(--text-sm);\n
    line-height: 1.4;\n
    color: var(--text-body);\n
}\n
.poll-result-row > strong { font-weight: 400; min-width: 0; }\n
.poll-result.is-mine .poll-result-row > strong { color: var(--text-strong); }\n
.poll-result-count {\n
    flex: 0 0 auto;\n
    margin-left: auto;\n
    color: var(--text-faint);\n
    font-family: var(--font-mono);\n
    font-size: var(--text-eyebrow);\n
    font-variant-numeric: tabular-nums;\n
}\n
.poll-result-mine { flex: 0 0 auto; display: inline-flex; color: var(--star); }\n
.poll-result-mine .icon-commend-star { width: 12px; height: 12px; }\n
.poll-result-bar {\n
    display: block;\n
    width: 100%;\n
    height: 8px;\n
    margin-top: 6px;\n
    overflow: hidden;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-pill);\n
    background: var(--surface-raised);\n
}\n
.poll-result-progress {\n
    display: block;\n
    width: 100%;\n
    height: 100%;\n
}\n
.poll-result-track { fill: transparent; }\n
.poll-result-fill { fill: var(--rule-gold); }\n
.poll-result.is-mine .poll-result-fill { fill: var(--rule-gold); }\n
.poll-foot {\n
    display: flex;\n
    align-items: center;\n
    gap: 12px;\n
    margin-top: 11px;\n
}\n
.poll-meta {\n
    font-family: var(--font-label);\n
    font-size: var(--text-eyebrow);\n
    letter-spacing: .03em;\n
    color: var(--text-faint);\n
}\n
.poll-foot .btn {\n
    margin-left: auto;\n
}\n
.poll-builder {\n
    padding: 14px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    background: var(--surface-raised);\n
}\n
\n
.topic-restructure {\n
    margin-top: 18px;\n
}\n
.sm-panel {\n
    padding: 16px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    background: var(--surface-raised);\n
    box-shadow: var(--shadow-xs);\n
}\n
.sm-panel-head {\n
    display: flex;\n
    align-items: baseline;\n
    gap: 10px;\n
    margin-bottom: 14px;\n
}\n
.sm-panel-title {\n
    font-family: var(--font-display);\n
    font-size: 1.28rem;\n
    font-weight: 500;\n
    color: var(--text-strong);\n
}\n
.sm-grid {\n
    display: grid;\n
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, .8fr);\n
    gap: 16px;\n
}\n
.sm-post-list {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 8px;\n
}\n
.sm-post {\n
    display: flex;\n
    gap: 10px;\n
    padding: 10px;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-sunken);\n
}\n
.sm-post-main {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 3px;\n
}\n
.sm-post-by,\n
.merge-from span,\n
.sm-note {\n
    color: var(--text-muted);\n
    font-size: .88rem;\n
}\n
.sm-post-body {\n
    color: var(--text-body);\n
}\n
.merge-from {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 3px;\n
    margin: 0 0 12px;\n
    padding: 10px 12px;\n
    border-radius: var(--radius-md);\n
    background: var(--surface-sunken);\n
}\n
\n
@media (max-width: 760px) {\n
    .feature-area-grid,\n
    .personal-org-grid,\n
    .sm-grid {\n
        grid-template-columns: 1fr;\n
    }\n
    .read-pad {\n
        padding: 22px 18px 48px;\n
    }\n
    .main > .read-main {\n
        margin: -24px -16px -24px;\n
    }\n
    .tag-card {\n
        width: 100%;\n
    }\n
    .field-grid {\n
        grid-template-columns: 1fr;\n
    }\n
    .settings-screen {\n
