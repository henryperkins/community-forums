[data-density="compact"] .forum-directory__board-description { display: none; }
[data-density="compact"] .forum-directory__peek { padding-bottom: 8px; }

/* Board index — the account-adjacent panes (Tags, Notices, Connections).
   These share the board index's shell rather than a shell of their own
