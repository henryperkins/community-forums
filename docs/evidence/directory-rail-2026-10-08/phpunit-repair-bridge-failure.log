}\n
.admin-console .admin-overview-dashboard .audit,\n
.admin-console .admin-overview-audit .audit {\n
    font-size: .9rem;\n
}\n
.admin-console .admin-overview-dashboard .audit th {\n
    padding: 7px 10px;\n
}\n
.admin-console .admin-overview-dashboard .audit td {\n
    padding: 9px 10px;\n
}\n
.admin-console .admin-overview-audit .audit th {\n
    padding: 11px 10px 9px;\n
}\n
.admin-console .admin-overview-audit .audit td {\n
    padding: 10px;\n
}\n
.admin-overview-audit .audit th:first-child,\n
.admin-overview-audit .audit td:first-child,\n
.admin-overview-dashboard .audit th:first-child,\n
.admin-overview-dashboard .audit td:first-child {\n
    padding-left: 0;\n
}\n
.admin-overview-audit .audit th:last-child,\n
.admin-overview-audit .audit td:last-child,\n
.admin-overview-dashboard .audit th:last-child,\n
.admin-overview-dashboard .audit td:last-child {\n
