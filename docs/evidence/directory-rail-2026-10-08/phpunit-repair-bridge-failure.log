    .notification-icon { width: 28px; height: 28px; }
    .notification-open time { grid-column: 2; font-size: .7rem; }
    .notification-heading { align-items: flex-start; flex-direction: column; gap: 4px; }
}

/* Connections — followers and following. */
.directory-connection-tabs {
    display: flex;
    align-items: center;
    gap: 22px;
    margin: 26px 0 4px;
    border-bottom: 1px solid var(--border-hair);
}
.directory-connection-tabs a {
    padding: 0 0 9px;
    border-bottom: 2px solid transparent;
