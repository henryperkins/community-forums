# Project knowledge archive (source material, not part of the repo)
retroboards-project-knowledge.zip
*.zip

# PHP / Composer
/vendor/
composer.lock

# JavaScript build tooling
/node_modules/

# App runtime
/.env
/storage/logs/
/storage/local-server.log
/storage/cache/*
/storage/ratelimit/*
/storage/packages/*
!/storage/cache/.gitkeep
!/storage/ratelimit/.gitkeep
# Per-run private package/ratelimit stacks. Parallel sessions each need their own
# (see the audit runbooks), so the suffix is arbitrary — match the whole family.
/storage/ratelimit-e2e*/
/storage/ratelimit-*-e2e/
/storage/packages-e2e*/
/storage/packages-*-e2e/
/storage/ratelimit-inbox-*/
/storage/ratelimit-mdpaste/
/storage/packages-inbox-*/
/storage/packages-mdpaste/
/storage/packages-console-e2e/
/storage/ratelimit-console-e2e/

# Test / coverage
/.phpunit.cache/
/coverage/
/output/wrangler-dry-run/

# Browser evidence (Playwright): keep the committed PNGs + lockfile, ignore deps + run artifacts
/tests/browser/node_modules/
/tests/browser/test-results/
/tests/browser/playwright-report/
/docs/evidence/browser/.artifacts/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
/storage/media/*
!/storage/media/.gitkeep

# transient browser-evidence scratch
.playwright-mcp/
.playwright-cli/

# agent tooling installed into the checkout, not part of the repo
.superpowers/

# wrangler local state (the deployment worktree writes this on every deploy)
.wrangler/

# design-pull tooling output (extracted design-system bundles; not used at runtime)
.design-pull/

# Raw design-tool uploads may contain authenticated DOM/session data.
# Existing reviewed assets stay tracked; add future reviewed assets explicitly.
/docs/design-system/imladris/uploads/
