.directory-viewbar > .directory-viewbar__peek { margin-left: auto; }
.directory-viewbar > .directory-viewbar__density { margin-left: 0; }

.board-index .forum-directory__hero > p a,
.directory-viewbar__density a {
    text-decoration: underline;
    text-decoration-thickness: .06em;
    text-underline-offset: .14em;
}
.directory-viewbar-mobile { display: none; }
.directory-order-note,
.search-result-count,
.inbox-shown-count {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: .72rem;
    line-height: 1.5;
}
.directory-order-note { margin: 10px 0 0; }
.directory-guest-note {
    margin: 18px 0 0;
    padding: 10px 14px;
    border-left: 2px solid var(--rule-gold);
    background: var(--surface-sunken);
    color: var(--text-muted);
}
.forum-directory__groups {
    display: flex;
    flex-direction: column;
    gap: 36px;
    margin-top: 34px;
}
.forum-directory__group h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    color: var(--gold-ink);
    font-family: var(--font-label);
    font-size: .72rem;
    font-weight: var(--weight-regular);
