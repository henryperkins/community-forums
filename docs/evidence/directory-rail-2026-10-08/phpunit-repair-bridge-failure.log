}\n
.admin-console .audit td.audit-time {\n
    color: var(--text-faint);\n
}\n
.admin-console .audit .audit-target {\n
    color: var(--text-muted);\n
}\n
.admin-console .audit-target-link {\n
    color: var(--on-info);\n
}\n
.admin-console .audit td.audit-reason {\n
