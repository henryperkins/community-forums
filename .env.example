# RetroBoards environment configuration (copy to .env)
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
# Optional WebAuthn relying-party id. Defaults to the APP_URL host. Set to your
# registrable domain (e.g. example.com for forum.example.com) if you want
# passkeys to survive subdomain moves. Changing it later invalidates passkeys -
# see docs/runbooks/passkeys.md before touching this.
WEBAUTHN_RP_ID=
# 32+ byte random string used to derive CSRF/guest tokens. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Database (MySQL 8 / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=retroboards
DB_USERNAME=retro
DB_PASSWORD=retropw
# TLS for the database connection. Leave false for a same-host or private-network
# database; set true whenever the database is reached over the public internet
# (e.g. managed MySQL from Cloudflare Containers) or credentials and every row
# travel in the clear. Provide the provider's CA bundle as a file path
# (DB_SSL_CA) or inline PEM (DB_SSL_CA_PEM, written to disk by the container
# entrypoint). Without a CA the connection is encrypted but unauthenticated.
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_PEM=
DB_SSL_VERIFY=true

# Writable data paths. On a host with a real volume these can stay under the
# project; on Cloudflare Containers the filesystem is ephemeral and /data must
# be an R2 mount (see docs/runbooks/deployment-cloudflare.md).
UPLOADS_PATH=
PACKAGES_STORAGE_PATH=
RATELIMIT_PATH=
# Set R2_BUCKET to mount an R2 bucket at /data on container start. Unset = no mount.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Run `php bin/console migrate` on container boot instead of as a deploy step.
RUN_MIGRATIONS=false

# Session cookie. Set SESSION_SECURE=false only for local http development.
SESSION_NAME=rb_session
SESSION_SECURE=true
SESSION_LIFETIME_DAYS=30

# Send HSTS header (only meaningful over https)
SECURITY_HSTS=true

# Reverse proxies whose X-Forwarded-For may be believed (comma-separated, CIDRs
# allowed). Leave EMPTY unless something really does sit in front of the app:
# an untrue value lets a client forge its own address. But do NOT leave it empty
# when a proxy IS in front — every visitor then shares one identity, collapsing
# every per-IP rate limit into a single global bucket and recording the proxy's
# address on every session. Cloudflare Containers: 10.0.0.0/8.
TRUSTED_PROXIES=

# Email. Empty MAIL_FROM ⇒ not configured ⇒ email fails closed: in-app
# notifications still deliver, but address verification and password reset
# cannot complete, which locks members (and operators) out of self-service
# recovery. Recover an account without email via `php bin/console user:password`.
#   sendmail   — PHP mail(); needs a local MTA
#   cloudflare — Cloudflare Email Sending REST API; the right driver on
#                Cloudflare Containers, which have no MTA. Onboard the sending
#                domain first: `npx wrangler email sending enable <domain>`.
#   array      — capture in memory (tests)
MAIL_DRIVER=sendmail
MAIL_FROM=
# Defaults to the community's site name when blank.
MAIL_FROM_NAME=
# Only for MAIL_DRIVER=cloudflare. The token needs the email sending permission;
# treat both as secrets.
MAIL_CLOUDFLARE_ACCOUNT_ID=
MAIL_CLOUDFLARE_API_TOKEN=
MAIL_TIMEOUT_SECONDS=10

# Capability resolver posture while features.capabilities is enabled:
# shadow (default; legacy decides, mismatches -> telemetry) or enforce.
CAPABILITIES_MODE=shadow

# Thread Intelligence (AI Living Briefs — docs/runbooks/thread_intelligence.md).
# The provider credential is environment-only: never stored in the database,
# never shown in the UI, never logged. Leave empty to disable AI generation —
# manual community memory and deterministic return context keep working.
OPENAI_API_KEY=
# Model slug and reasoning effort (none|low|medium|high|max). Invalid values
# fall back to these defaults with an operator warning; nothing is clamped.
THREAD_INTELLIGENCE_MODEL=gpt-5.6-luna
THREAD_INTELLIGENCE_REASONING_EFFORT=low
# Site-wide daily budget (UTC day): generation calls and reserved input tokens.
THREAD_INTELLIGENCE_DAILY_CALL_LIMIT=100
THREAD_INTELLIGENCE_DAILY_INPUT_TOKEN_LIMIT=1000000
# Per-request ceilings. MAX_OUTPUT_TOKENS bounds reasoning + output at the API;
# the local 450-word structured-output validator is the visible-content limit.
THREAD_INTELLIGENCE_MAX_INPUT_TOKENS=32000
THREAD_INTELLIGENCE_MAX_OUTPUT_TOKENS=16000
# Transport bounds: TCP connect and full generation-request timeouts (seconds).
THREAD_INTELLIGENCE_CONNECT_TIMEOUT_SECONDS=5
THREAD_INTELLIGENCE_TIMEOUT_SECONDS=60
