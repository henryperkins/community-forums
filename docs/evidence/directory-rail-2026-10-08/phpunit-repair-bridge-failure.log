}\n
.admin-console .admin-roles .role-capability-count {\n
    margin-left: auto;\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    font-size: .74rem;\n
    letter-spacing: .04em;\n
}\n
.admin-console .admin-roles .field-error {\n
    margin: 6px 0 0;\n
}\n
\n
/* Role record. Its area-owned H1 stays in the shared console; the record is\n
   the design's second-level heading and keeps the Roles tab active. */\n
.admin-console .admin-role-record .admin-back {\n
    gap: 6px;\n
    margin-bottom: 14px;\n
    letter-spacing: .04em;\n
}\n
.admin-console .admin-role-record .role-record-heading {\n
    display: flex;\n
    align-items: baseline;\n
    gap: 12px;\n
}\n
.admin-console .admin-role-record .admin-record-title {\n
    margin: 0;\n
}\n
.admin-console .admin-role-record .role-record-heading > span {\n
