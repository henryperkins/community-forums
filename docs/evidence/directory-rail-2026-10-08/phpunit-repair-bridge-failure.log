    font-size: .64rem;
    letter-spacing: .2em;
    text-transform: uppercase;
}
.directory-viewbar__choices,
.directory-viewbar__peek,
.search-scope-options,
.search-order-options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3px;
}
.directory-viewbar form,
.directory-viewbar-mobile-panel form { display: contents; }
.directory-viewbar__choices a,
.directory-viewbar__choices button,
.directory-viewbar__peek a,
.directory-viewbar__peek button,
.search-scope-options a,
.search-order-options a {
    min-height: 30px;
    padding: 5px 12px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-label);
