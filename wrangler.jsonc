{
  // RetroBoards front door.
  // Runbooks: docs/runbooks/deployment-cloud-run.md (the origin),
  //           docs/runbooks/deployment-cloudflare.md (this Worker, domains)
  //
  // The Worker is a thin front door: it enforces the canonical host, serves the
  // compiled assets, fixes up the client-IP header and forwards dynamic requests
  // to the Apache/PHP image on Google Cloud Run (ORIGIN_URL). The app's own
  // configuration and secrets live there (deploy/cloudrun/). The one secret
  // here is GCP_INVOKER_KEY, the key that lets this Worker call the service --
  // set it with `wrangler secret put` (runbook deployment-cloud-run.md §6).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retroboards",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "build": { "command": "npm run build" },
  "assets": {
    // Generated allowlist only: never upload public/index.php or local uploads.
    "directory": "./.build/static",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Preserve the creation record and delete the retired container's class.
  // A pre-Cloud Run version now needs a new deploy instead of rollback (§9).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ForumContainer"] },
    { "tag": "v2", "deleted_classes": ["ForumContainer"] }
  ],

  // Wrangler manages the canonical Custom Domain only. The existing SaaS
  // route boards.hperkins.blog/* belongs to the candidary.online zone and is
  // managed separately through Workers Routes / the zone API (runbook §16).
  // Wrangler's bulk route API rejects that out-of-zone hostname with 10022.
  // With only Custom Domains here it skips the bulk PUT and preserves the
  // existing zone route. Do not add a zone-wide wildcard: it captures the
  // candidary Worker's Custom Domain on the apex.
  "routes": [
    { "pattern": "forum.candidary.online", "custom_domain": true }
  ],

  // No cron triggers: the bin/console workers run as Cloud Run jobs on Cloud
  // Scheduler (deploy/cloudrun/configure.sh). Keep the empty list -- deleting
  // the key would leave the previously deployed schedules firing.
  "triggers": { "crons": [] },

  "vars": {
    // The Cloud Run service every dynamic request is forwarded to. Only
    // callers with an ID token for this URL get in (worker/origin.mjs).
    "ORIGIN_URL": "https://retroboards-616731728350.us-east4.run.app",

    "APP_URL": "https://forum.candidary.online"
  }
}
