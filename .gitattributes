# Shell scripts execute inside Linux containers; a CRLF shebang breaks exec
# (ENOENT for '/bin/sh\r'), so pin them to LF even on Windows checkouts.
*.sh text eol=lf
bin/console text eol=lf
public/assets/dist/** -text
public/assets/app.css text eol=lf
public/assets/app.js text eol=lf
public/assets/fonts/imladris/LICENSES/*.txt text eol=lf
docs/design-system/imladris/components.css text eol=lf
docs/evidence/thread-mobile-followup-2026-10-22/** -text
