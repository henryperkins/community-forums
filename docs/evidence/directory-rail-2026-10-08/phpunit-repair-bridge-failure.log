    gap: 9px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
}
.directory-tag-list a {
    display: inline-flex;
    min-height: 34px;
    align-items: baseline;
    gap: 8px;
    padding: 7px 15px;
    border: 1px solid var(--border-hair);
    border-radius: var(--radius-pill);
    color: var(--text-body);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-calm), background var(--dur-fast) var(--ease-calm);
}
.directory-tag-list a:hover {
    border-color: var(--border-soft);
    background: var(--gold-soft);
    color: var(--text-strong);
    text-decoration: none;
}
.directory-tag-list a > span:first-child { font-family: var(--font-label); font-size: .92rem; }
.directory-tag-list a > span + span { color: var(--text-faint); font-family: var(--font-mono); font-size: .7rem; }

/* Shared notification history: both entry points use these same rows. */
.notification-panel { min-width: 0; }
.notification-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.notification-heading h1 { margin: 0; }
.notification-actions, .notification-history { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.notification-actions form { margin: 0; }
.notification-actions button:disabled { color: var(--text-faint); cursor: default; }
.notification-actions button, .notification-history a { min-height: 44px; display: inline-flex; align-items: center; }
.notification-prose { color: var(--text-muted); line-height: 1.6; }
.notification-prose a, .notification-history a { text-decoration: underline; text-underline-offset: 3px; }
.notification-history { margin: 12px 0; border-bottom: 1px solid var(--border-hair); }
