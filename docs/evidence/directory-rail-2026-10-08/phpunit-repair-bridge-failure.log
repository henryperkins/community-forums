    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: var(--weight-medium);
}
.inbox-list-head .badge {
    padding: 3px 11px;
    border: 1px solid var(--gold-200);
    background: var(--gold-soft);
    color: var(--gold-ink);
    font-size: .72rem;
    letter-spacing: .04em;
    line-height: 1.6;
    text-transform: none;
}
.inbox-view-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-bottom: 6px;
    padding: 0 0 12px;
    border-bottom: 1px solid var(--border-hair);
}
.inbox-menu { position: relative; min-width: 0; }
/* Native disclosures share the toolbar's left edge when no positioning script
   is available, including widths where both triggers fit on the same row. */
html:not(.has-js) .inbox-view-bar { position: relative; }
html:not(.has-js) .inbox-view-bar > .inbox-menu { position: static; }
.inbox-menu > summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--border-hair);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-strong);
    font-family: var(--font-label);
    font-size: .82rem;
    line-height: 1.2;
    list-style: none;
    cursor: pointer;
}
.inbox-menu > summary:hover { border-color: var(--border-soft); background: var(--surface-sunken); }
.inbox-menu > summary::-webkit-details-marker { display: none; }
.inbox-control-label { color: var(--text-muted); }
.inbox-scope-count { color: var(--gold-ink); font-size: .72rem; white-space: nowrap; }
.inbox-scope-count [data-inbox-current-count] { font-family: var(--font-mono); }
.inbox-menu > summary .icon { width: 12px; height: 12px; flex-shrink: 0; }
.inbox-menu-panel {
    position: absolute;
    z-index: 50;
    top: calc(100% + 7px);
    left: 0;
    display: grid;
    width: 280px;
    max-width: calc(100vw - 32px);
    max-height: min(60vh, 420px);
    padding: 8px;
    overflow-y: auto;
    border: 1px solid var(--border-hair);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    box-shadow: var(--shadow-lg);
}
.has-js .inbox-menu[open] > .inbox-menu-panel,
.has-js .thread-row-menu[open] > .thread-row-menu-panel {
    position: fixed;
    top: 0;
    right: auto;
    bottom: auto;
    left: 0;
    visibility: hidden;
}
.has-js .inbox-menu[data-inbox-menu-positioned="1"] > .inbox-menu-panel,
.has-js .thread-row-menu[data-inbox-menu-positioned="1"] > .thread-row-menu-panel { visibility: visible; }
.inbox-scope-group-label {
    padding: 9px 10px 4px;
    color: var(--text-faint);
    font-family: var(--font-label);
    font-size: .58rem;
    letter-spacing: .16em;
    text-transform: uppercase;
}
.inbox-menu-panel > a,
.inbox-mark-all button,
.inbox-help > summary {
    min-height: 44px;
    padding: 10px 8px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-body);
    font-family: var(--font-label);
    font-size: .8rem;
    line-height: 1.4;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
}
.inbox-menu-panel > a { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.inbox-menu-panel > a:hover,
.inbox-mark-all button:hover,
.inbox-help > summary:hover { background: var(--surface-sunken); text-decoration: none; }
.inbox-menu-panel > a.is-active { background: var(--brand-subtle); color: var(--on-brand-subtle); }
.inbox-scope-menu-panel a > span:last-child { color: var(--text-faint); font-family: var(--font-mono); font-size: .66rem; }
.inbox-actions { margin-left: auto; }
.inbox-actions > summary { width: 44px; justify-content: center; padding: 8px; border-color: transparent; border-radius: var(--radius-md); }
.inbox-actions > summary .icon { width: 20px; height: 20px; }
.inbox-actions > .inbox-menu-panel { left: auto; right: 0; }
.inbox-mark-all { margin: 0; }
.inbox-mark-all button { width: 100%; }
.inbox-help > summary { list-style-position: inside; }
.inbox-help p { margin: 8px; font-size: .9rem; line-height: 1.5; }
.inbox-keyboard-help { display: none; }
.has-js .inbox-keyboard-help { display: block; }
.inbox-keyboard-help dl { margin: 8px; font-size: .85rem; }
.inbox-keyboard-help dl > div { display: grid; grid-template-columns: 64px 1fr; gap: 8px; padding-block: 4px; }
.inbox-keyboard-help dd { margin: 0; }
.inbox-sweep {
    position: sticky;
    top: 0;
    z-index: 8;
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 8px 0;
    padding: 8px 10px;
    border: 1px solid var(--green-200);
    border-radius: var(--radius-md);
    background: var(--brand-subtle);
    color: var(--on-brand-subtle);
    box-shadow: var(--shadow-sm);
}
.inbox-sweep.is-active { display: flex; }
.inbox-sweep button {
    min-height: 30px;
    padding: 4px 9px;
    border: 1px solid var(--border-hair);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--text-body);
    font-family: var(--font-label);
    font-size: .7rem;
    cursor: pointer;
}
/* Indented by the row's own 12px so the control lines up with the checkboxes it
   commands, and 22px tall like the design's (ForumInbox.dc.html:157) rather than
   opening a 38px band above the first topic. */
.inbox-select-all {
    display: flex;
    min-height: 22px;
    align-items: center;
    gap: 10px;
    padding: 0 12px 7px;
    color: var(--text-faint);
    font-family: var(--font-label);
    font-size: .7rem;
    letter-spacing: .1em;
    text-transform: uppercase;
}
/* Rows are separated by their own bottom hairline. A grid gap on top of it drew
   a second, wider channel the design does not have. */
.inbox-thread-list {
    display: block;
    margin: 0;
    padding: 0;
    list-style: none;
}
/* The queue presentation of the one topic row (partials/thread_row.php). The
   generic .thread-row rules belong to the default presentation, and several reach
   this row too: the status left-rule, an overflow clip that cuts the row menu
   when JavaScript is off, and the compact register's single-line title. So the
   queue restates the geometry it keeps (ForumInbox.dc.html, ADR 0029), weighted
   to hold against them. */
.thread-row.thread-row-inbox {
    position: relative;
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 12px;
    overflow: visible;
    border-bottom: 1px solid var(--border-hair);
    border-left: 2px solid transparent;
    border-radius: var(--radius-md);
    transition: background var(--dur-fast) var(--ease-calm), border-color var(--dur-fast) var(--ease-calm);
}
.thread-row-inbox::before { content: none; }
.thread-row-inbox:hover { background: var(--surface-raised); }
.thread-row-inbox.is-active {
    border-left-color: var(--gold-500);
    background: var(--brand-subtle);
}
.thread-row-inbox.is-cursor {
    box-shadow: inset 0 0 0 1px var(--gold-500);
}
.thread-row-select {
    display: inline-flex;
    width: 16px;
    min-height: 28px;
    flex: 0 0 16px;
    align-items: center;
}
.thread-row-select input { width: 16px; height: 16px; margin: 0; accent-color: var(--accent); }
.thread-row-inbox .unread-slot {
    display: inline-flex;
    width: 7px;
    min-height: 28px;
    flex: 0 0 7px;
    align-items: center;
}
.thread-row-inbox .unread-dot { width: 7px; height: 7px; }
.thread-row.thread-row-inbox > .monogram,
.thread-row.thread-row-inbox > .avatar-wrap .monogram {
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    font-size: .66rem;
}
.thread-row-inbox .thread-row-main { display: block; min-width: 0; flex: 1; }
.thread-row-inbox .thread-title-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 9px;
}
.thread-row-inbox .thread-title {
    order: 1;
    flex: 0 1 auto;
    min-width: 0;
    overflow: visible;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: var(--weight-medium);
    letter-spacing: -0.005em;
    line-height: 1.3;
    text-decoration: none;
    text-overflow: clip;
    white-space: normal;
    text-wrap: pretty;
}
.thread-row-inbox .thread-title:hover { color: var(--accent); text-decoration: none; }
.thread-row-inbox .thread-row-chips {
    order: 2;
    display: inline-flex;
    flex: 0 1 auto;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 0;
}
.thread-row-inbox .thread-row-chips .chip {
    padding: 1px 7px;
    font-size: .56rem;
    letter-spacing: .14em;
}
/* The inclusion cue is not a status. It answers "why am I being shown this?",
   which the design says in gold, in sentence case, a shade larger and looser
   than the uppercase status pills beside it (ForumInbox.dc.html:176). The class
   had no rules at all, so it inherited the evergreen status pill and shouted a
   sentence. */
.thread-row-inbox .thread-row-chips .chip-reason {
    border-color: var(--gold-200);
    background: var(--gold-soft);
    color: var(--gold-ink);
    font-size: .6rem;
    letter-spacing: .08em;
    text-transform: none;
}
.thread-row-inbox .thread-row-chips .icon { width: 9px; height: 9px; }
/* `.chip svg` paints every mark as a stroked Lucide glyph, and CSS outranks the
   presentation attributes the filled brand stars carry — so the commend star
   inside a chip was drawn hollow, at a stroke width of 2 in a 0-100 viewBox. */
.badge .icon-commend-star,
.chip .icon-commend-star,
.badge .icon-eight-point-star,
.chip .icon-eight-point-star { fill: currentColor; stroke: none; }
/* The commend star is the one esteem glyph. In outline it is the unset state of
   a control that sets it, so a toggle's two states differ in shape as well as
   in ink: the two inks it moves between are close in lightness. */
.icon-commend-star.is-outline { fill: none; stroke: currentColor; stroke-width: 7; stroke-linejoin: round; }
.thread-row-inbox .thread-snippet {
    display: -webkit-box;
    margin: 3px 0 0;
    overflow: hidden;
    color: var(--text-muted);
    font-size: .88rem;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
}
.thread-row-inbox .thread-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 3px;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: .7rem;
    letter-spacing: normal;
    line-height: 1.35;
    white-space: nowrap;
}
/* A board reference in a topic's meta is a citation of the record, and the
   design gives it Bruinen where every other link wears evergreen - the one
   place --artifact-link is spent (ForumInbox.dc.html:187 and 268, the same
   choice Search.dc.html:187 makes). */
.thread-row-inbox .thread-meta a,
.inbox-preview-kicker a { color: var(--artifact-link); text-decoration: none; }
.thread-row-inbox .thread-meta a:hover,
.inbox-preview-kicker a:hover { text-decoration: underline; }
/* Commends are the Commended order's own column of numbers. Printed in every
   order they were a fourth statistic competing with the reply count for the
   same line, and the meta wrapped (ForumInbox.dc.html:190, showCommends). */
.thread-row-inbox .thread-meta-commends {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--gold-ink);
}
.thread-row-inbox .thread-meta-commends .icon { width: 9px; height: 9px; }
.thread-row-inbox .thread-row-star { margin: 0; }
/* The icon size of the one star control (partials/star_toggle.php) shares the
   row menu's square. */
.star-toggle,
.thread-row-menu > summary {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
}
.star-toggle:hover,
.thread-row-menu > summary:hover { background: var(--surface-sunken); color: var(--text-body); }
.star-toggle[aria-pressed="true"] { color: var(--gold-ink); }
.star-toggle .icon { width: 18px; height: 18px; }
.thread-row-menu { position: relative; }
.thread-row-menu > summary { list-style: none; }
.thread-row-menu > summary::-webkit-details-marker { display: none; }
.thread-row-menu-panel {
    position: absolute;
    z-index: 42;
    top: calc(100% + 4px);
    right: 0;
    display: grid;
    width: 196px;
    padding: 6px;
    border: 1px solid var(--border-hair);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    box-shadow: var(--shadow-lg);
}
.thread-row-menu-panel button {
    width: 100%;
    min-height: 32px;
    padding: 6px 8px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-body);
    font: inherit;
    font-size: .78rem;
    text-align: left;
    cursor: pointer;
}
.thread-row-menu-panel button:hover { background: var(--surface-sunken); }
.inbox-shown-count { margin: 22px 0 0; font-size: .74rem; }

[data-density="compact"] .thread-row-inbox { gap: 9px; padding-top: 4px; padding-bottom: 4px; }
[data-density="compact"] .thread-row-inbox .thread-title { margin-top: 0; font-size: .99rem; }
[data-density="compact"] .thread-row-inbox .thread-meta { margin-top: 1px; font-size: .67rem; }
[data-density="compact"] .thread-row-inbox .thread-snippet { display: none; }

.inbox-reading {
    display: none;
    min-width: 0;
    padding: 0;
    overflow-y: auto;
    background: var(--surface-raised);
    scrollbar-gutter: stable;
}
.inbox-reading[aria-busy="true"] { opacity: .55; }
/* The reading column is 760px, not 840: it is a topic being read inside a list
   surface, and it keeps the same measure the topic gets on its own page
   (ForumInbox.dc.html:264). */
.inbox-reading > [data-inbox-reading-content] {
    display: flex;
    max-width: 760px;
    min-height: 100%;
    flex-direction: column;
    margin: 0 auto;
    padding: 26px 40px 72px;
}
.inbox-reading > [data-inbox-reading-content] > * { min-width: 0; }
.inbox-mobile-back { display: none; }
/* Nothing chosen yet is a quiet state in the middle of an empty pane, not a
   headline stacked at the top of it (ForumInbox.dc.html:300). */
.inbox-empty {
    display: flex;
    max-width: 46ch;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: auto;
    padding: 40px 24px;
    text-align: center;
}
.inbox-empty .muted { max-width: 42ch; margin: 0; line-height: 1.55; }
.inbox-empty-title {
    color: var(--text-strong);
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
}
.inbox-empty .inbox-empty-title { margin: 12px 0 3px; font-size: 1.3rem; }
/* The queue's own empty state had no rules at all: an unstyled div under a
   strict CSP is a left-aligned star, a heading and a paragraph stacked against
   the gutter. The design centres it and gives the scope's own name back to the
   reader with a way out (ForumInbox.dc.html:234). */
.inbox-empty-state {
    padding: 58px 16px;
    text-align: center;
}
.inbox-empty-state .inbox-empty-title { margin: 12px 0 4px; font-size: 1.45rem; }
.inbox-empty-state .muted {
    margin: 0 0 18px;
    color: var(--text-muted);
    font-size: .97rem;
}
/* Both empty states drew the eight-pointed house mark as an <img>, which cannot
   take currentColor: the `color` beside this rule was inert and the mark
   rendered in the SVG's own stroke. The design uses the quiet four-point star,
   filled, at 30px (ForumInbox.dc.html:236, 302) - already in the icon map as
   `eight-point-star`, and inline, so the colour lands. A 56px rule left over
   from the pre-Imladris inbox had also been sizing it. */
.inbox-empty-star.icon {
    width: 30px;
    height: 30px;
}
.inbox-empty-star,
.search-state-icon { color: var(--gold-ink); opacity: .45; }
/* The reading pane states who is speaking before it prints what they said: the
   kicker locates the topic, the title names it, and one ruled line carries the
   author, their standing and the size of the conversation (ForumInbox.dc.html:
   268-276). The transfer dropped that line entirely, so a topic could be read
   here without ever learning whose it was. */
.inbox-preview-header { position: relative; }
.inbox-preview-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: .74rem;
}
.inbox-preview-kicker > span { color: var(--text-faint); }
.inbox-preview-header h2 {
    margin: 11px 0 0;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    line-height: 1.16;
    text-wrap: pretty;
}
.inbox-preview-attribution {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 11px;
    margin-top: 12px;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--border-hair);
}
.inbox-preview-attribution .monogram { width: 28px; height: 28px; flex: 0 0 auto; font-size: .66rem; }
.inbox-preview-author { color: var(--text-body); font-family: var(--font-label); font-size: .86rem; }
.inbox-preview-tier {
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--surface-sunken);
    color: var(--text-muted);
    font-family: var(--font-label);
    font-size: .6rem;
    letter-spacing: .12em;
    text-transform: uppercase;
}
.inbox-preview-count {
    margin: 0 0 0 auto;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: .73rem;
}
.inbox-preview-open {
    color: var(--accent);
    font-family: var(--font-label);
    font-size: .76rem;
}
/* The opening post is the topic, not the first of its replies: it is set as the
   lede directly beneath the byline, and the counsel that answers it follows. */
.inbox-preview-lede {
    margin: 18px 0 0;
    color: var(--text-body);
    font-size: 1.03rem;
    line-height: 1.68;
    text-wrap: pretty;
}
.inbox-preview-posts {
    display: flex;
    margin: 22px 0 0;
    flex-direction: column;
    gap: 18px;
    padding: 0;
    list-style: none;
}
.inbox-preview-posts > li {
    display: flex;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--border-hair);
}
.inbox-preview-posts .monogram { width: 28px; height: 28px; flex: 0 0 auto; font-size: .66rem; }
.inbox-preview-posts > li > div { min-width: 0; flex: 1; }
.inbox-preview-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: .72rem;
}
.inbox-preview-byline > span:first-child {
    color: var(--text-body);
    font-family: var(--font-label);
    font-size: .84rem;
}
.inbox-preview-posts .formatted-content {
    margin-top: 6px;
    color: var(--text-body);
    font-size: .99rem;
    line-height: 1.64;
    text-wrap: pretty;
}
.inbox-preview-bounded { margin: 18px 0 0; font-family: var(--font-mono); font-size: .73rem; }
.inbox-preview-reply { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-hair); }
.inbox-preview-reply > .eyebrow {
    display: block;
    margin-bottom: 10px;
    color: var(--gold-ink);
    font-family: var(--font-label);
    font-size: .66rem;
    letter-spacing: .16em;
    text-transform: uppercase;
}

/* Search */
.search-surface,
.compose-surface {
    width: min(100%, 840px);
    margin: 0 auto;
    padding: 26px 40px 90px;
}
.search-column { max-width: 760px; }
.search-column h1,
.compose-column h1 {
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: var(--weight-medium);
    line-height: 1.08;
}
.search-form {
    display: block;
    max-width: none;
    margin: 24px 0 0;
}
.search-input-row {
    display: flex;
    align-items: stretch;
    gap: 14px;
}
.search-query-well,
.compose-title-input,
.compose-board-select {
    width: 100%;
    min-height: 48px;
    padding: 12px 15px;
    border: 0;
    outline: 0;
    background: var(--surface-raised);
    box-shadow: var(--shadow-inset), inset 0 0 0 1.5px var(--gold-200);
    border-radius: var(--radius-md);
    color: var(--text-strong);
    caret-color: var(--gold-600);
    font-family: var(--font-body);
    font-size: 1.05rem;
}
.search-query-well:hover,
.compose-title-input:hover,
.compose-board-select:hover { box-shadow: var(--shadow-inset), inset 0 0 0 1.5px var(--gold-400); }
.search-query-well:focus-visible,
.compose-title-input:focus-visible,
.compose-board-select:focus-visible {
    outline: 0;
    box-shadow: var(--shadow-inset), inset 0 0 0 2px var(--gold-500), inset 0 0 0 5px color-mix(in srgb, var(--gold-100) 60%, transparent), 0 0 0 3px var(--focus-ring);
}
.search-query-well[aria-invalid="true"],
.search-query-well:user-invalid,
.compose-title-input[aria-invalid="true"],
.compose-board-select[aria-invalid="true"] {
    box-shadow: var(--shadow-inset), inset 0 0 0 2px var(--danger), inset 0 0 0 5px color-mix(in srgb, var(--danger) 12%, transparent);
}
.search-input-row .btn { min-width: 82px; }
.search-query-help { margin: 7px 0 0; font-size: .8rem; }
.search-view-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    margin-top: 24px;
    padding: 11px 0;
    border-top: 1px solid var(--border-hair);
    border-bottom: 1px solid var(--border-hair);
}
.search-order-options { margin-left: auto; }
.search-result-count { margin: 10px 0 0; }
.search-results { gap: 0; }
.search-result {
    padding: 17px 0;
    border-bottom: 1px solid var(--border-hair);
}
.search-result-byline {
    display: flex;
    gap: 6px;
    margin: 0 0 4px;
    color: var(--text-faint);
    font-family: var(--font-label);
    font-size: .74rem;
}
.search-result-byline a { color: var(--accent); text-decoration: none; }
.search-result-title {
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: var(--weight-medium);
    line-height: 1.25;
    text-decoration: none;
}
.search-result-title:hover { color: var(--accent); text-decoration: none; }
.search-result-snippet {
    max-width: 62ch;
    margin: 5px 0 0;
    color: var(--text-muted);
    font-size: .96rem;
    line-height: 1.6;
}
.search-empty-state,
.search-initial-state {
    display: grid;
    justify-items: center;
    padding: 62px 24px;
    text-align: center;
}
.search-state-icon { width: 30px; height: 30px; }
.search-empty-title,
.search-initial-state > p:first-of-type {
    margin: 12px 0 3px;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: 1.35rem;
}
.search-empty-state .muted,
.search-initial-state .muted { margin: 0; }

/* Compose */
.compose-surface { width: min(100%, 780px); }
.compose-column { max-width: 700px; }
.compose-column h1 { font-size: 2.2rem; }
.compose-lede {
    max-width: 48ch;
    margin: 6px 0 28px;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
}
.compose-topic-form { margin: 0; }
.compose-topic-form > .field {
    display: block;
    max-width: none;
    margin: 0 0 18px;
}
.compose-topic-form > .field > span:first-child {
    display: block;
    margin-bottom: 6px;
    color: var(--text-muted);
    font-family: var(--font-label);
    font-size: .78rem;
    letter-spacing: .03em;
}
.compose-title-input { font-family: var(--font-display); }
.compose-board-field { max-width: 280px; }
.compose-board-select-wrap {
    position: relative;
    display: block;
    max-width: 280px;
}
.compose-board-select {
    max-width: 280px;
    padding-right: 42px;
    appearance: none;
}
.compose-board-select-wrap > .icon {
    position: absolute;
    top: 50%;
    right: 13px;
    width: 14px;
    height: 14px;
    /* --gold-600 is a primitive: it does not flip, so this chevron stayed
       day-gold at night and measured 2.97:1 on --surface-raised in the day
       register (WCAG 2.2 SC 1.4.11 wants 3:1 for a control affordance).
       --gold-ink is the flipping semantic the system reserves for small gold
       marks: 5.49:1 by day, 7.30:1 by night. */
    color: var(--gold-ink);
    pointer-events: none;
    transform: translateY(-50%);
}
.compose-topic-form .composer-box { margin-top: 7px; }
.compose-topic-form .composer-input { min-height: 180px; }
.compose-topic-form .composer-send .icon { width: 17px; height: 17px; }
.composer-shell.is-submitting .composer-send .icon { animation: composer-quill 700ms linear infinite; }
.compose-footer {
    display: flex;
    min-height: 36px;
    align-items: center;
    gap: 18px;
    margin-top: 12px;
}
.compose-cancel {
    color: var(--text-muted);
    font-family: var(--font-label);
    font-size: .78rem;
}
.compose-draft-copy {
    margin-left: auto;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: .71rem;
}
.compose-draft-copy[hidden],
[data-compose-anonymous][hidden] { display: none; }

/* Focus, responsive floors, and motion */
.forum-directory__tabs a:focus-visible,
.directory-viewbar a:focus-visible,
.directory-viewbar button:focus-visible,
.thread-row-inbox .thread-title:focus-visible,
.star-toggle:focus-visible,
.thread-row-menu > summary:focus-visible,
.inbox-menu > summary:focus-visible,
.inbox-menu-panel :is(a, button, summary):focus-visible,
.search-view-bar a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 3px var(--focus-ring);
}

@media (min-width: 1280px) {
    body.is-reading-open .inbox-shell { grid-template-columns: minmax(430px, 660px) minmax(0, 1fr); }
    body.is-reading-open .inbox-list { border-right: 1px solid var(--border-hair); }
    body.is-reading-open .inbox-reading { display: block; }
    body.is-reading-closed .inbox-shell { grid-template-columns: minmax(0, 1fr); }
    body.is-reading-closed .inbox-reading { display: none; }
}
@media (max-width: 1279px) {
    .inbox-reading.is-open { display: block; }
    .inbox-list.is-hidden { display: none; }
    .has-js .inbox-mobile-back {
        position: sticky;
        top: 0;
        z-index: 5;
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        gap: 6px;
        margin: -8px 0 12px;
        padding: 6px 4px;
        border: 0;
        background: var(--surface-raised);
        color: var(--accent);
        font-family: var(--font-label);
        font-size: .82rem;
        letter-spacing: .02em;
        cursor: pointer;
    }
    .inbox-mobile-back:hover { color: var(--brand-hover); }
    .inbox-mobile-back:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
}
@media (max-width: 860px) {
    body[data-route="boards"] .main,
    body[data-route="search"] .main,
    body[data-route="compose"] .main { padding: 0; }
    .board-index,
    .search-surface,
    .compose-surface { padding: 22px 18px 76px; }
    .forum-directory__tabs { margin-bottom: 24px; }
    .inbox-list { padding: 22px 16px 34px; }
    .inbox-reading > [data-inbox-reading-content] { padding: 20px 18px 62px; }
    .thread-row.thread-row-inbox { padding-inline: 6px; }
    .thread-row-inbox .thread-snippet { display: none; }
}
@media (max-width: 760px) {
    .forum-directory__hero h1 { font-size: 2.1rem; }
    .directory-viewbar { display: none; }
    .directory-viewbar-mobile {
        position: relative;
        z-index: 30;
        display: block;
        margin-top: 24px;
    }
    .directory-viewbar-mobile > summary {
        display: flex;
        min-height: 44px;
        align-items: center;
        gap: 5px;
        padding: 9px 12px;
        border-top: 1px solid var(--border-hair);
        border-bottom: 1px solid var(--border-hair);
        color: var(--text-muted);
        font-family: var(--font-label);
        font-size: .78rem;
        list-style: none;
        cursor: pointer;
    }
    .directory-viewbar-mobile > summary::-webkit-details-marker { display: none; }
    .directory-viewbar-mobile[open]::before {
        position: fixed;
        z-index: 70;
        inset: 0;
        background: color-mix(in srgb, var(--text-strong) 42%, transparent);
        content: "";
    }
    /* Without JavaScript a <details> can only be closed by its own <summary>,
       so the summary must never sit under the scrim. It did — the scrim is a
       child of this element and outranked it — which left the sheet with no
       way back. Raising the open disclosure into its own stacking context and
       lifting the summary above both scrim and panel restores the close path
       and reads as a lit hole in the scrim. */
    .directory-viewbar-mobile[open] { z-index: 70; }
    .directory-viewbar-mobile[open] > summary {
        position: relative;
        z-index: 72;
        border-radius: var(--radius-sm) var(--radius-sm) 0 0;
        background: var(--surface-raised);
        color: var(--text-strong);
    }
    .directory-viewbar-mobile-panel {
        position: fixed;
        z-index: 71;
        right: 0;
        bottom: 0;
        left: 0;
        display: grid;
        max-height: min(78vh, 620px);
        max-height: min(78dvh, 620px);
        gap: 9px;
        padding: 18px 18px max(18px, env(safe-area-inset-bottom));
        overflow-y: auto;
        border-radius: var(--radius-xl) var(--radius-xl) 0 0;
        background: var(--surface-raised);
        box-shadow: var(--shadow-xl);
    }
    .directory-viewbar-mobile-panel .directory-viewbar__choices { display: grid; grid-template-columns: 1fr 1fr; }
    .directory-viewbar-mobile-panel .directory-viewbar__choices a,
    .directory-viewbar-mobile-panel .directory-viewbar__choices button,
    .directory-viewbar-mobile-panel .directory-viewbar__peek a,
    .directory-viewbar-mobile-panel .directory-viewbar__peek button {
        min-height: 44px;
        justify-content: center;
    }
    .directory-viewbar-mobile-settings { min-height: 44px; padding: 11px 4px; font-family: var(--font-label); font-size: .78rem; }
    .forum-directory__board-row > a { flex-wrap: wrap; gap: 3px; }
    .forum-directory__board-description { flex-basis: 100%; }
    .forum-directory__board-facts { margin-left: 0; }
    .forum-directory__board-description { white-space: normal; }
    .forum-directory__board-facts { flex-wrap: wrap; white-space: normal; }
    .forum-directory__peek li { grid-template-columns: 4px minmax(0, 1fr); }
    .forum-directory__peek li > span:last-child { grid-column: 2; white-space: normal; }
    .inbox-view-bar { gap-inline: 8px; }
    .thread-row-inbox > .monogram,
    .thread-row-inbox > .avatar-wrap { display: none; }
    .thread-row-inbox .thread-meta { font-size: .65rem; }
    .star-toggle,
    .thread-row-menu > summary { width: 34px; height: 34px; }
    .search-input-row { flex-direction: column; }
    .search-input-row .btn { min-height: 44px; }
    .search-order-options { margin-left: 0; }
    .compose-lede { margin-bottom: 22px; }
}
@media (max-width: 520px) {
    .forum-directory__tabs { gap: 16px; }
    .forum-directory__tabs a { font-size: .78rem; }
    .forum-directory__stats { gap: 4px 10px; }
    .forum-directory__stats span + span::before { margin-right: 7px; }
    .thread-row-select { width: 18px; flex-basis: 18px; }
    /* The dot stays. It is the queue's primary signal and the only unread cue a
       row carries - the queue's title keeps one weight - so hiding it to buy 17px
       left an unread-triage surface with no way to see what is unread on a phone. */
    .thread-row-inbox .thread-row-chips { flex-basis: 100%; }
    .compose-topic-form .composer-actions-bar { flex-wrap: wrap; }
    .compose-topic-form .composer-actions-start {
        flex: 1 1 100%;
        flex-wrap: wrap;
        overflow: visible;
    }
    .compose-topic-form .composer-actions-end {
        flex: 1 1 100%;
        justify-content: flex-end;
        padding-top: 6px;
        border-top: 1px solid var(--border-hair);
    }
}
@media (prefers-reduced-motion: reduce) {
    .forum-directory__board-row > a,
    .thread-row.thread-row-inbox,
    .composer-box { transition: none; }
    .composer-shell.is-submitting .composer-send .icon { animation: none; }
