    color: var(--text-strong);\n
    font-family: var(--font-mono);\n
    font-size: .78rem;\n
}\n
.admin-console .admin-roles .role-capability-description {\n
    color: var(--text-muted);\n
}\n
.admin-console .admin-roles .role-risk {\n
    margin-left: 6px;\n
    padding: 0 7px;\n
