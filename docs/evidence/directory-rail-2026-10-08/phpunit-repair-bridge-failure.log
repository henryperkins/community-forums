}
.directory-connection-tabs a:hover { color: var(--text-body); text-decoration: none; }
.directory-connection-tabs a[aria-current="page"] {
    border-bottom-color: var(--gold-ink);
    color: var(--text-strong);
}
.directory-people-list {
    margin: 0;
