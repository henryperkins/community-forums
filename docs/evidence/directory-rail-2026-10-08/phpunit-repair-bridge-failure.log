    font-weight: var(--weight-medium);
    letter-spacing: -.015em;
    line-height: 1.06;
    text-wrap: balance;
}
.board-index .forum-directory__hero > p:not(.forum-directory__stats) {
    max-width: 50ch;
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    text-wrap: pretty;
}
.forum-directory__stats {
    display: flex;
