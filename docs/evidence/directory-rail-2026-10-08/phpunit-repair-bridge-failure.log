/* ── The prose contract ────────────────────────────────────────────────────\n
   ONE definition of how sanitised body_html reads, shared by every surface\n
   that renders it: thread posts, the composer preview, DM bodies, profile\n
   bios. Anything that wants to differ overrides deliberately below and says\n
   why — this block is the baseline, so the surfaces can't drift apart again.\n
   Reading type is the Imladris book size (--text-size-body, 17px) at generous\n
   leading; the surrounding shell chrome is what sits smaller. */\n
.formatted-content {\n
    min-inline-size: 0;\n
    overflow-wrap: anywhere;\n
    font-family: var(--font-body);\n
    font-size: var(--text-size-body);\n
    line-height: 1.7;\n
    color: var(--text-body);\n
}\n
.formatted-content > :first-child { margin-block-start: 0; }\n
.formatted-content > :last-child { margin-block-end: 0; }\n
/* One-directional margins: the gap between two blocks is stated once, so it\n
   can't be halved by collapsing or doubled by a sibling. 1em against 1.7\n
   leading makes a paragraph break read as roughly 2.4x an in-paragraph line\n
   break — the separation the flat post stream has to carry on its own. */\n
.formatted-content p { margin-block: 0 1em; }\n
/* A link inside a sentence is underlined at rest (WCAG 1.4.1): evergreen on the\n
   prose ink measures ~1.2:1 by day and ~1.5:1 by night, so colour alone cannot\n
   mark it. Longhands only, so the global `a` rule's translucent-gold underline\n
   colour and its warm-on-hover still paint; hover also thickens the rule, and\n
   focus keeps the shared outline. A mention (`a.mention`) is a plain link with\n
   no chip of its own, so it is ruled too. Only a link whose content is an image\n
   goes without — there is no text to rule. */\n
.formatted-content a {\n
    text-decoration-line: underline;\n
    text-decoration-thickness: .08em;\n
    text-underline-offset: .18em;\n
}\n
.formatted-content a:hover { text-decoration-thickness: .14em; }\n
.formatted-content a:has(> img:not(.custom-emoji)) { text-decoration-line: none; }\n
/* The sanitiser clamps every heading into [h2, h3], so these two are the whole\n
   hierarchy a post can express. Cormorant is a high-contrast display serif:\n
   at weight 500 it carries LESS optical weight than bold body text, which is\n
   why headings stopped announcing themselves. Semibold + a real gap above\n
   restores the "this belongs to what follows" read. */\n
.formatted-content h2,\n
.formatted-content h3 {\n
    /* rem, not em, for the lead-in: em resolves against the heading's OWN size,\n
       which makes an h2 open a bigger hole than an h3 and pushes a section break\n
       past the gap that separates two posts. A section must stay quieter than a\n
       speaker change. Bottom stays em so it hugs its own text. */\n
    margin-block: 1.75rem .32em;\n
    font-weight: var(--weight-semibold);\n
    line-height: 1.25;\n
    letter-spacing: 0;\n
    color: var(--text-strong);\n
    overflow-wrap: anywhere;\n
}\n
.formatted-content h2 { font-size: 1.5em; }\n
.formatted-content h3 { font-size: 1.22em; }\n
.formatted-content ul,\n
.formatted-content ol {\n
    margin-block: 0 1em;\n
    padding-inline-start: 1.5em;\n
}\n
.formatted-content li + li { margin-block-start: .35em; }\n
.formatted-content li:has(> input[type="checkbox"]) { list-style: none; }\n
.formatted-content li > input[type="checkbox"] {\n
    inline-size: 1em;\n
    block-size: 1em;\n
    margin: 0 .45em 0 -1.45em;\n
    vertical-align: -.08em;\n
    accent-color: var(--accent);\n
}\n
.formatted-content img:not(.custom-emoji) {\n
    display: block;\n
    max-inline-size: 100%;\n
    block-size: auto;\n
    margin-block: 0 1em;\n
    border-radius: var(--radius-md);\n
}\n
.formatted-content .custom-emoji {\n
    display: inline-block;\n
    inline-size: 1.2em;\n
    block-size: 1.2em;\n
    max-inline-size: none;\n
    margin: 0 .06em;\n
    object-fit: contain;\n
    vertical-align: -.22em;\n
}\n
/* Code. The sunken fill alone sits at only ~1.10:1 by day and ~1.34:1 by night\n
   against the page, so the container needs the strong semantic edge as well as\n
   the tint. Block and inline share one size — JetBrains Mono has a much larger\n
   x-height than EB Garamond, so mono set at the serif's size reads oversized\n
   and breaks the line rhythm. */\n
.formatted-content pre {\n
    margin-block: 0 1em;\n
    padding: 12px 14px;\n
    border: 1px solid var(--border-strong);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-sunken);\n
    overflow-x: auto;\n
    font-family: var(--font-mono);\n
    font-size: .875em;\n
    line-height: 1.6;\n
}\n
/* A code block scrolls horizontally, so it is a keyboard-operable scroll region\n
   (WCAG 2.1.1). The sanitizer stamps tabindex/role/label; the ring is ours, and\n
   matches the scrollable-table treatment below. */\n
.formatted-content pre:focus-visible {\n
    outline: 2px solid var(--accent);\n
    outline-offset: 3px;\n
}\n
.formatted-content code {\n
    padding: .1em .35em;\n
    border: 1px solid var(--border-strong);\n
    border-radius: var(--radius-sm);\n
    background: var(--surface-sunken);\n
    font-family: var(--font-mono);\n
    font-size: .875em;\n
}\n
.formatted-content pre code { background: none; border: 0; padding: 0; font-size: inherit; }\n
/* A quotation is someone else's voice, so it recedes — it must never be set\n
   darker or heavier than the prose carrying it. The gold rule and the italic\n
   do the marking; the ink stays exactly the prose ink. */\n
.formatted-content blockquote {\n
    margin-block: 0 1em;\n
    padding: .15em 0 .15em 1em;\n
    border-inline-start: 2px solid var(--rule-gold);\n
    color: inherit;\n
    font-style: italic;\n
}\n
.formatted-content blockquote > :last-child { margin-block-end: 0; }\n
.formatted-content hr {\n
    margin-block: 2em;\n
    border: 0;\n
    border-block-start: 1px solid var(--border);\n
}\n
.formatted-content .formatted-table {\n
    max-inline-size: 100%;\n
    margin-block: 0 1em;\n
    overflow-x: auto;\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-md);\n
    -webkit-overflow-scrolling: touch;\n
}\n
.formatted-content .formatted-table:focus-visible {\n
    outline: 2px solid var(--accent);\n
    outline-offset: 3px;\n
}\n
.formatted-content .formatted-table > table {\n
    inline-size: max-content;\n
    min-inline-size: 100%;\n
    border-collapse: collapse;\n
    font-size: .92em;\n
}\n
.formatted-content th,\n
.formatted-content td {\n
    padding: .5em .7em;\n
    border-block-end: 1px solid var(--border-hair);\n
    text-align: start;\n
    vertical-align: top;\n
}\n
.formatted-content th {\n
    background: var(--surface-sunken);\n
    color: var(--text-strong);\n
    font-family: var(--font-label);\n
    font-weight: var(--weight-semibold);\n
}\n
.formatted-content tr:last-child > td { border-block-end: 0; }\n
.formatted-content th[align="left"],\n
.formatted-content td[align="left"] { text-align: left; }\n
.formatted-content th[align="center"],\n
.formatted-content td[align="center"] { text-align: center; }\n
.formatted-content th[align="right"],\n
.formatted-content td[align="right"] { text-align: right; }\n
.post-actions { margin-top: 8px; display: flex; gap: 14px; align-items: flex-start; }\n
.post-edit { margin: 0; }\n
\n
/* Composer */\n
.composer { margin-top: 16px; }\n
.composer.stacked { display: block; }\n
.composer-label { margin: 0 0 6px; color: var(--text-muted); font-size: .9rem; }\n
.composer-details { margin: 12px 0; }\n
.composer-details > summary { display: inline-block; margin-bottom: 8px; cursor: pointer; }\n
.composer .btn { margin-top: 8px; }\n
\n
/* Pagination */\n
.pagination { display: flex; gap: 6px; margin: 20px 0; flex-wrap: wrap; }\n
.page {\n
    padding: 5px 10px;\n
    border: 1px solid var(--border);\n
    border-radius: var(--radius-md);\n
    background: var(--surface);\n
    color: var(--text);\n
}\n
.page.current { background: var(--accent); color: var(--accent-contrast); border-color: var(--accent); }\n
\n
/* Profile */\n
.profile-id h1 { margin: 0; }\n
.profile-stats { display: flex; gap: 28px; margin: 18px 0; }\n
.profile-stats dt { color: var(--text-muted); font-size: .8rem; }\n
.profile-stats dd { margin: 0; font-size: 1.3rem; font-weight: 700; }\n
.prose p:first-child { margin-top: 0; }\n
.link-list { list-style: none; padding: 0; }\n
.link-list li { padding: 6px 0; border-bottom: 1px solid var(--border); }\n
\n
/* Admin */\n
.admin-cat { }\n
/* Category card header: rename form left, reorder/delete actions pushed right. */\n
.admin-cat-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 4px; }\n
.admin-cat-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\n
.admin-board-list { list-style: none; padding: 0; margin: 12px 0 0; }\n
.admin-board-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 8px 0; border-top: 1px solid var(--border); }\n
.admin-board-actions { display: flex; gap: 12px; align-items: center; }\n
.audit { width: 100%; border-collapse: collapse; font-size: .88rem; table-layout: fixed; }\n
.audit th, .audit td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: top; overflow-wrap: anywhere; }\n
.audit code { background: var(--surface-3); padding: 1px 5px; border-radius: var(--radius-sm); }\n
\n
/* Destructive-action confirmation pages (structure delete/archive/unarchive). */\n
.confirm-card { max-width: 640px; }\n
.confirm-card code { background: var(--surface-3); padding: 1px 6px; border-radius: var(--radius-sm); }\n
.impact-list { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 12px 0 16px; }\n
.impact-list dt { color: var(--text-muted); font-size: .88rem; }\n
.impact-list dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }\n
.confirm-form { margin-top: 4px; }\n
\n
/* Responsive: one column ≤ 860px */\n
@media (max-width: 860px) {\n
    .app-shell { grid-template-columns: 1fr; }\n
}\n
\n
/* ── Phase 2: engagement (reactions, stars, unread, inbox) ── */\n
.reactions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; align-items: center; }\n
.reaction {\n
    display: inline-flex; align-items: center; gap: 4px;\n
    font: inherit; font-size: .85rem; line-height: 1;\n
    padding: 4px 8px; border: 1px solid var(--border); border-radius: var(--radius-pill);\n
    background: var(--surface); color: var(--text); cursor: pointer;\n
}\n
.reaction:hover { background: var(--surface-3); }\n
.reaction-on { border-color: var(--gold-500); background: var(--gold-soft); color: var(--gold-700); }\n
.reaction-static { cursor: default; }\n
.reaction-n { font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--text-muted); }\n
.reaction-on .reaction-n { color: var(--gold-700); }\n
.reaction-add { position: relative; display: inline-block; }\n
.reaction-add > summary { list-style: none; }\n
.reaction-add > summary::-webkit-details-marker { display: none; }\n
.reaction-pick { font-weight: 700; }\n
.reaction-mark { display: inline-flex; flex: 0 0 auto; color: var(--star); }\n
.reaction-mark .icon { width: 13px; height: 13px; }\n
.reaction-name { font-family: var(--font-label); letter-spacing: .02em; }\n
.reaction-on .reaction-mark { color: inherit; }\n
.reaction-menu {\n
    position: absolute; z-index: 20; margin-top: 4px; padding: 6px;\n
    display: flex; flex-direction: column; align-items: stretch; gap: 4px;\n
    width: max-content; max-width: min(240px, 70vw); max-height: 280px; overflow: auto;\n
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);\n
    box-shadow: var(--shadow-lg);\n
}\n
.reaction-menu .reaction { justify-content: flex-start; width: 100%; border-radius: var(--radius-sm); }\n
.reaction-form { margin: 0; }\n
\n
.star-btn { font-size: .9rem; }\n
.star-on { color: var(--star); }\n
.star-marker { color: var(--star); margin-right: 4px; }\n
\n
.thread-unread .thread-title { font-weight: 700; }\n
.unread-dot {\n
    display: inline-block; width: 8px; height: 8px; border-radius: 50%;\n
    background: var(--accent-2); margin-right: 6px; flex: 0 0 auto;\n
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-2) 22%, transparent);\n
}\n
.thread-board { color: var(--text-muted); }\n
\n
.inbox-tabs { display: flex; flex-wrap: wrap; gap: 4px; margin: 12px 0 16px; border-bottom: 1px solid var(--border); }\n
.inbox-tab { padding: 8px 12px; border-radius: var(--radius) var(--radius) 0 0; color: var(--text-muted); }\n
.inbox-tab:hover { background: var(--surface-3); }\n
.inbox-tab.is-active { color: var(--text); font-weight: 600; border-bottom: 2px solid var(--accent-2); }\n
\n
/* ── Phase 2: notifications + bell ── */\n
.bell { position: relative; }\n
.bell-count {\n
    /* Imladris: the unread cue is the mallorn-gold marker (--accent-2), never a\n
       red alert badge — kept in sync with the Imladris topbar rule below so the\n
       two .bell-count definitions can't disagree (handoff §10: gold = unread). */\n
    position: absolute; top: -4px; right: -8px; min-width: 16px; height: 16px;\n
    padding: 0 4px; border-radius: var(--radius-pill); background: var(--accent-2); color: var(--ink-900);\n
    font-size: 11px; line-height: 16px; text-align: center; font-weight: 700;\n
}\n
.subscribe-form .input-small { padding: 2px 6px; font-size: .85rem; }\n
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n
\n
/* ── Phase 2 (M5): community identity, member controls, presence ── */\n
\n
/* Profile */\n
.profile-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 8px; }\n
.profile-stats { display: flex; flex-wrap: wrap; gap: 20px; margin: 16px 0; }\n
.profile-stats dt { color: var(--text-muted); font-size: .8rem; }\n
.profile-stats dd { margin: 0; font-size: 1.2rem; font-weight: 700; font-variant-numeric: tabular-nums; }\n
.profile-web a { word-break: break-all; }\n
.badge-title { background: var(--surface-3); color: var(--text); }\n
.pill-online { background: var(--surface-done); color: var(--on-done); }\n
.btn-on { border-color: var(--gold-500); background: var(--gold-soft); color: var(--gold-700); }\n
\n
/* Badges */\n
.profile-badges { margin: 16px 0; }\n
.badge-row { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 8px 0 0; }\n
.badge-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border: 1px solid var(--border); border-radius: var(--radius-pill); background: var(--surface); font-size: .85rem; }\n
.badge-icon { font-size: 1rem; }\n
.badge-solved { background: var(--surface-raised); color: var(--on-done); border-color: var(--green-200); }\n
.post-accepted {\n
    border: 1px solid var(--green-200);\n
    border-left: 3px solid var(--success);\n
    background: var(--surface-done);\n
    box-shadow: var(--shadow-sm);\n
}\n
.solved-action { margin-top: 6px; }\n
\n
/* Following feed */\n
.feed-list { list-style: none; padding: 0; margin: 16px 0; }\n
.feed-item { padding: 12px 0; border-top: 1px solid var(--border); }\n
.feed-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; font-size: .85rem; color: var(--text-muted); }\n
.feed-thread { display: inline-block; font-weight: 600; margin-top: 2px; }\n
.feed-excerpt { color: var(--text-muted); margin: 4px 0 0; }\n
.pager { display: flex; gap: 10px; margin-top: 16px; }\n
\n
/* Leaderboard + people lists */\n
.leaderboard-list, .people-list { list-style: none; padding: 0; margin: 16px 0; }\n
.leaderboard-row, .person-row { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-top: 1px solid var(--border); }\n
.lb-rank { font-weight: 700; color: var(--text-muted); min-width: 2.5em; }\n
.lb-name, .person-name { font-weight: 600; }\n
.lb-rep, .person-rep { margin-left: auto; color: var(--text-muted); font-variant-numeric: tabular-nums; }\n
\n
/* Settings: board preferences.\n
   Slice 16 moved connections, sessions and subscriptions onto the design's\n
   shared `.account-ruled-*` row, so only the board-preference names are left\n
   here. `boards.php` is Slice 17's file and migrates with it; until then this\n
   rule is what keeps that one list styled. */\n
.board-pref-list { list-style: none; padding: 0; margin: 12px 0 0; }\n
.board-pref-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 10px 0; border-top: 1px solid var(--border); }\n
.board-pref-name { font-weight: 600; min-width: 8em; }\n
/* The design keeps the sign-out-everywhere control on the panel head line, to\n
   the right of the eyebrow's hairline (:411-415). */\n
.sessions-head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }\n
.sessions-head .scribe-panel-head { flex: 1; margin-bottom: 0; }\n
.checkline { display: flex; align-items: center; gap: 8px; padding: 6px 0; }\n
.checkline input { width: 18px; height: 18px; }\n
\n
/* OAuth buttons */\n
.oauth-buttons { margin: 16px 0; text-align: center; }\n
.oauth-sep { margin: 12px 0 8px; }\n
.btn-oauth { display: block; margin: 8px 0; }\n
\n
/* ── Accessibility + mobile polish (P2-11) ── */\n
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n
/* No border-radius here. The layer's own :focus-visible rounds what has no\n
   radius of its own (2px); restated unlayered, it beat every control's radius,\n
   so a focused pill, search field or button squared off to 2px. */\n
.skip-link { position: absolute; left: -999px; top: 0; z-index: 100; background: var(--surface); padding: 8px 12px; border: 1px solid var(--border); }\n
.skip-link:focus { left: 8px; top: 8px; }\n
\n
@media (max-width: 860px) {\n
    /* Comfortable touch targets on small screens (≥44px). */\n
    .btn, .linkbtn, .topbar-link, .reaction, .subnav a, .subnav .subnav-action, .inbox-tab { min-height: 44px; display: inline-flex; align-items: center; }\n
    .profile-stats { gap: 14px; }\n
    .profile-stats dd { font-size: 1.05rem; }\n
    .feed-meta { font-size: .8rem; }\n
    /* Floating "back to top / compose" affordance room. */\n
    .main { padding-bottom: 72px; }\n
}\n
\n
@media (prefers-reduced-motion: reduce) {\n
    * { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; scroll-behavior: auto !important; }\n
}\n
\n
/* ── Application-owned semantic tokens (ADR 0039) ─────────────────────────\n
   Values the Imladris layer does not carry. Primitives appear here, in token\n
   definitions, and never in the rules that paint from them (DESIGN.md, the\n
   Semantic-Only Rule).\n
\n
   --field-rule is the edge of an engraved frame. The layer's --gold-200\n
   measured 1.30:1 against the parchment card, and WCAG 1.4.11 asks 3:1 of a\n
   field's boundary; in twilight the same primitive drew a near-white 10.8:1\n
   line. gold-700 holds 3.92:1 against the card and 3.69:1 against the field's\n
   own fill by day; twilight takes gold-600 (4.71:1 / 5.30:1), restated in both\n
   twilight registers below.\n
\n
   --stage-* paint the auth gate's stage, which is twilight in both registers,\n
   so they do not flip. The page's --accent is evergreen by day, drawn for\n
   parchment: on this ground its focus ring measured 1.75:1.\n
\n
   --z-* order the member shell. Page content stays at or below 30 (the post\n
   toolbar and the phone directory bar are the highest); the sticky chrome sits\n
   above it, so nothing on the page paints over the bar or its account menu;\n
   the phone drawer's scrim and rail come next. Popovers, sheets and dialogs\n
   that must cover the chrome already start at 42. The layer's own 20 put the\n
   bar under the page's 30. */\n
:root {\n
    --field-rule: var(--gold-700);\n
    --stage-ground: var(--twilight-900);\n
    --stage-raised: var(--twilight-800);\n
    --stage-ink: var(--parchment-50);\n
    --stage-accent: var(--gold-400);\n
    --z-chrome: 40;\n
    --z-scrim: 55;\n
    --z-drawer: 60;\n
}\n
\n
/* ── Phase 3: appearance preferences (P3-01) ──────────────────────────────\n
   Theme/density/font-size/reduced-motion are stamped on <html> by the server\n
   from the user's resolved preferences, so there is no flash and the no-JS\n
   path is themed too. Dark tokens apply on an explicit dark choice, or on\n
   "system" when the device prefers dark. All driven by CSS variables; no\n
   inline styles (the strict CSP forbids them). */\n
\n
/* Imladris "twilight" night register. Gold is the actionable colour on dark\n
   (links/buttons), parchment is the ink, evergreen the quiet brand. */\n
[data-theme="dark"] {\n
    --surface: var(--twilight-700);\n
    --surface-2: var(--twilight-900);\n
    --surface-3: var(--twilight-800);\n
    --border: #36434f;\n
    --text: #ECE4D2;\n
    --text-muted: #AEB8B4;\n
    --text-strong: var(--parchment-50);\n
    --text-body: #D7DCD2;\n
    --text-faint: var(--ink-300);\n
    --text-inverse: var(--ink-900);\n
    --on-brand-subtle: #BCD0BF;\n
    --gold-ink: var(--gold-400);\n
    --accent: var(--gold-400);\n
    --accent-contrast: var(--twilight-900);\n
    --accent-2: var(--gold-500);\n
    --danger: #DB8C73;\n
    --surface-page: var(--twilight-900);\n
    --surface-raised: var(--twilight-800);\n
    --surface-sunken: var(--twilight-700);\n
    --surface-inverse: var(--parchment-100);\n
    --border-hair: #36434f;\n
    --border-soft: #2C3742;\n
    --border-strong: #51606C;\n
    --brand: var(--green-500);\n
    --brand-hover: var(--green-400);\n
    --brand-subtle: rgba(78,116,89,.20);\n
    --gold-soft: rgba(194,154,68,.16);\n
    --rule-gold: var(--gold-400);\n
    --success: var(--green-400);\n
    --surface-done: rgba(78,116,89,.20); --on-done: #BCD0BF;\n
    --warning: var(--gold-400);\n
    --surface-review: rgba(194,154,68,.16); --on-review: #DCC68A;\n
    --surface-staff: rgba(194,154,68,.16); --on-staff: var(--gold-200);\n
    --pending: var(--ink-300);\n
    --surface-pending: var(--twilight-700); --on-pending: #AEB8B4;\n
    --info: var(--river-400);\n
    --surface-info: rgba(63,110,137,.20); --on-info: var(--river-200);\n
    --star: var(--gold-400);\n
    --presence: var(--green-400);\n
    --focus-ring: rgba(210,176,98,.75);\n
    --field-rule: var(--gold-600);\n
    /* Restated in BOTH dark registers on purpose. imladris.css declares --scrim\n
       under [data-theme="dark"] only and carries no [data-theme="system"] block,\n
       so a member on the default `system` theme with a dark OS was getting the\n
       LIGHT scrim behind every overlay. Declaring it in one block alone would\n
       swap that bug for an asymmetry — which is exactly what\n
       ImladrisRuntimeAssetTest::test_both_application_dark_registers_declare_the_same_tokens\n
       exists to catch. Same value as imladris.css's twilight scrim. */\n
    --scrim: rgba(9,13,17,.58);\n
}\n
@media (prefers-color-scheme: dark) {\n
    [data-theme="system"] {\n
        --surface: var(--twilight-700);\n
        --surface-2: var(--twilight-900);\n
        --surface-3: var(--twilight-800);\n
        --border: #36434f;\n
        --text: #ECE4D2;\n
        --text-muted: #AEB8B4;\n
        --text-strong: var(--parchment-50);\n
        --text-body: #D7DCD2;\n
        --text-faint: var(--ink-300);\n
        --text-inverse: var(--ink-900);\n
        --on-brand-subtle: #BCD0BF;\n
        --gold-ink: var(--gold-400);\n
        --accent: var(--gold-400);\n
        --accent-contrast: var(--twilight-900);\n
        --accent-2: var(--gold-500);\n
        --danger: #DB8C73;\n
        --surface-page: var(--twilight-900);\n
        --surface-raised: var(--twilight-800);\n
        --surface-sunken: var(--twilight-700);\n
        --surface-inverse: var(--parchment-100);\n
        --border-hair: #36434f;\n
        --border-soft: #2C3742;\n
        --border-strong: #51606C;\n
        --brand: var(--green-500);\n
        --brand-hover: var(--green-400);\n
        --brand-subtle: rgba(78,116,89,.20);\n
        --gold-soft: rgba(194,154,68,.16);\n
        --rule-gold: var(--gold-400);\n
        --success: var(--green-400);\n
        --surface-done: rgba(78,116,89,.20); --on-done: #BCD0BF;\n
        --warning: var(--gold-400);\n
        --surface-review: rgba(194,154,68,.16); --on-review: #DCC68A;\n
        --surface-staff: rgba(194,154,68,.16); --on-staff: var(--gold-200);\n
        --pending: var(--ink-300);\n
        --surface-pending: var(--twilight-700); --on-pending: #AEB8B4;\n
        --info: var(--river-400);\n
        --surface-info: rgba(63,110,137,.20); --on-info: var(--river-200);\n
        --star: var(--gold-400);\n
        --presence: var(--green-400);\n
        --focus-ring: rgba(210,176,98,.75);\n
        --field-rule: var(--gold-600);\n
        /* See the twilight block above: this is the audience that needed it. */\n
        --scrim: rgba(9,13,17,.58);\n
    }\n
}\n
\n
[data-font-size="small"]  { font-size: 14px; }\n
[data-font-size="medium"] { font-size: 16px; }\n
[data-font-size="large"]  { font-size: 18px; }\n
\n
[data-density="compact"] .post,\n
[data-density="compact"] .thread-row,\n
[data-density="compact"] .card { padding-top: 8px; padding-bottom: 8px; }\n
[data-density="compact"] { --radius: 6px; }\n
\n
[data-reduced-motion="1"] *,\n
[data-reduced-motion="1"] *::before,\n
[data-reduced-motion="1"] *::after {\n
    animation-duration: 0.001ms !important;\n
    animation-iteration-count: 1 !important;\n
    transition-duration: 0.001ms !important;\n
    scroll-behavior: auto !important;\n
}\n
@media (prefers-reduced-motion: reduce) {\n
    *, *::before, *::after {\n
        animation-duration: 0.001ms !important;\n
        transition-duration: 0.001ms !important;\n
    }\n
}\n
\n
/* Spoilers (P3-02): hidden until clicked/focused; keyboard accessible. */\n
.spoiler {\n
    background: var(--text);\n
    color: transparent;\n
    border-radius: var(--radius-sm);\n
    cursor: pointer;\n
    padding: 0 2px;\n
}\n
.spoiler.is-revealed,\n
.spoiler:focus { color: var(--accent-contrast); background: var(--surface-3); }\n
\n
/* Contained composer shell. Every enhancement mounts in a named server slot so\n
   stale fragments degrade independently to their textarea and submit button. */\n
.composer-shell { min-width: 0; }\n
.composer-box {\n
    position: relative;\n
    min-width: 0;\n
    border: 1px solid var(--border-strong);\n
    border-radius: var(--radius-lg);\n
    background: var(--surface-raised);\n
    box-shadow: var(--shadow-inset);\n
    transition: border-color 140ms var(--ease-calm), box-shadow 140ms var(--ease-calm);\n
}\n
.composer-box:focus-within {\n
    border-color: var(--gold-400);\n
    box-shadow: var(--shadow-inset), 0 0 0 3px var(--focus-ring);\n
}\n
.composer-box .composer-input {\n
    display: block;\n
    min-width: 0;\n
    min-height: 82px;\n
    max-height: min(42dvh, 360px);\n
    padding: 10px 12px;\n
    resize: none;\n
    overflow-y: auto;\n
    border: 0;\n
    border-radius: 0;\n
    background: transparent;\n
    box-shadow: none;\n
}\n
.composer-box .composer-input:focus { border: 0; outline: 0; box-shadow: none; }\n
.composer-box > .field-error { margin: 0; padding: 8px 12px 0; }\n
/* The rich editor is the same body region as the textarea, wearing the same\n
   inset and the same height budget — one container, one border, one focus ring\n
   (the box's). Its own framing is neutralised in the WYSIWYG bundle. */\n
.composer-box .wysiwyg-composer .ProseMirror {\n
    min-height: 82px;\n
    max-height: min(42dvh, 360px);\n
    padding: 10px 12px;\n
    overflow-y: auto;\n
}\n
\n
/* Inline media is a PREVIEW, not the published rendering. Unconstrained, an\n
   uploaded photo laid itself out at natural size — a 1600x1200 upload rendered\n
   1600px wide inside a ~550px editor that clips, so the author saw a 1:1 crop of\n
   the top-left corner and had to scroll a 336px-tall editor past it. That\n
   misreports both the size and the framing of a post that will scale the whole\n
   image down to the column.\n
   Fit it to the column and cap the height so the image stays in the text flow,\n
   at its insertion point, without swallowing the surface. Scaling both bounds\n
   with width/height:auto keeps the aspect ratio, so the preview is a faithful\n
   miniature. Preview (the action bar toggle) remains the full-fidelity view and\n
   is deliberately NOT capped. */\n
.composer-box .wysiwyg-composer .ProseMirror img {\n
    max-width: 100%;\n
    max-height: 240px;\n
    width: auto;\n
    height: auto;\n
}\n
\n
/* A mount's own header field (the New Topic title) sits inside the box and\n
   shares its inset, so the composer reads as one surface instead of a detached\n
   input stacked above a framed component. The box owns the only focus ring. */\n
.composer-header { min-width: 0; border-bottom: 1px solid var(--border-hair); }\n
.composer-header > .input {\n
    min-width: 0;\n
    padding: 10px 12px;\n
    border: 0;\n
    border-radius: 0;\n
    background: transparent;\n
    /* The box owns the inset (see .composer-box above), so the header field must\n
       not restate the one it now inherits from the base .input rule — two insets\n
       print a shading band under the header hairline and the composer stops\n
       reading as one surface. Zeroing border/radius/background is not enough. */\n
    box-shadow: none;\n
    font-weight: var(--weight-semibold);\n
}\n
.composer-header > .input:focus { outline: 0; box-shadow: none; }\n
.composer-header > .field-error { margin: 0; padding: 8px 12px 0; }\n
\n
.composer-format-slot { position: relative; display: flex; align-items: center; gap: 6px; min-width: 0; padding: 7px 8px 0; }\n
.composer-format-aside { order: 2; display: inline-flex; align-items: center; flex: 0 0 auto; gap: 4px; margin-left: auto; }\n
/* Without JS the row holds only its empty slots; without a mode control or a\n
   usable minimise button it has nothing to show. */\n
.composer-format-slot:empty,\n
.composer-format-slot:not(:has(.composer-toolbar, .composer-mode-toggle, [data-composer-minimize]:not([hidden]))) { display: none; }\n
.composer-toolbar {\n
    order: 1;\n
    display: flex;\n
    flex: 1 1 auto;\n
    flex-wrap: nowrap;\n
    align-items: center;\n
    gap: 3px;\n
    min-width: 0;\n
    margin: 0;\n
    overflow: visible;\n
}\n
.composer-toolbar[hidden] { display: none; }\n
.composer-toolbar-action,\n
.composer-more-toggle {\n
    position: relative;\n
    display: inline-flex;\n
    flex: 0 0 auto;\n
    align-items: center;\n
    justify-content: center;\n
    width: 28px;\n
    height: 28px;\n
    padding: 0;\n
    border: 1px solid transparent;\n
    border-radius: var(--radius-sm);\n
    background: transparent;\n
    color: var(--text-muted);\n
    cursor: pointer;\n
}\n
.composer-toolbar-action svg {\n
    width: 17px;\n
    height: 17px;\n
    fill: none;\n
    stroke: currentColor;\n
    stroke-width: 1.8;\n
    stroke-linecap: round;\n
    stroke-linejoin: round;\n
}\n
.composer-toolbar-action:hover,\n
.composer-more-toggle:hover,\n
.composer-toolbar-action[aria-pressed="true"] {\n
    border-color: var(--border-hair);\n
    background: var(--surface-sunken);\n
    color: var(--text-strong);\n
}\n
.composer-toolbar-action[aria-pressed="true"] { border-color: var(--accent-2); color: var(--gold-700); }\n
.composer-toolbar-action:focus-visible,\n
.composer-more-toggle:focus-visible,\n
.composer-format-toggle:focus-visible,\n
.composer-attach-toggle:focus-visible,\n
.composer-emoji-toggle:focus-visible,\n
.composer-mode-toggle:focus-visible,\n
.composer-minimize:focus-visible,\n
.composer-preview-toggle:focus-visible {\n
    outline: 2px solid var(--accent);\n
    outline-offset: 2px;\n
}\n
.composer-toolbar-action[data-tip]::after,\n
.composer-format-toggle[data-tip]::after {\n
    content: attr(data-tip);\n
    position: absolute;\n
    z-index: 70;\n
    left: 50%;\n
    bottom: calc(100% + 7px);\n
    translate: -50% 2px;\n
    width: max-content;\n
    max-width: 220px;\n
    padding: 4px 7px;\n
    border-radius: var(--radius-sm);\n
    background: var(--surface-inverse);\n
    color: var(--text-inverse);\n
    box-shadow: var(--shadow-md);\n
    font: .72rem/1.3 var(--font-label);\n
    letter-spacing: .01em;\n
    opacity: 0;\n
    pointer-events: none;\n
    transition: opacity 120ms var(--ease-calm), translate 120ms var(--ease-calm);\n
}\n
.composer-toolbar-action[data-tip]:hover::after,\n
.composer-toolbar-action[data-tip]:focus-visible::after { translate: -50% 0; opacity: 1; }\n
/* The action-bar toggle sits near the left edge of the mobile dock. */\n
.composer-format-toggle[data-tip]::after { left: 0; translate: 0 2px; }\n
.composer-format-toggle[data-tip]:hover::after,\n
.composer-format-toggle[data-tip]:focus-visible::after { translate: 0 0; opacity: 1; }\n
.composer-toolbar-sep { width: 1px; height: 20px; flex: 0 0 1px; margin: 0 2px; background: var(--border-hair); }\n
.composer-more-wrap { display: none; }\n
.composer-format-overflow {\n
    position: absolute;\n
    z-index: 65;\n
    top: calc(100% + 5px);\n
    right: 8px;\n
    display: grid;\n
    min-width: 190px;\n
    padding: 5px;\n
    border: 1px solid var(--border);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-raised);\n
    box-shadow: var(--shadow-lg);\n
}\n
.composer-format-overflow[hidden] { display: none; }\n
.composer-overflow-action {\n
    width: 100%;\n
    padding: 7px 9px;\n
    border: 0;\n
    border-radius: var(--radius-sm);\n
    background: transparent;\n
    color: var(--text);\n
    text-align: left;\n
    cursor: pointer;\n
}\n
.composer-overflow-action:hover,\n
.composer-overflow-action[aria-pressed="true"] { background: var(--surface-sunken); }\n
\n
.composer-upload-tray { display: grid; gap: 8px; min-width: 0; padding: 0 10px 8px; }\n
.composer-upload-tray:empty { display: none; }\n
.composer-upload-card {\n
    display: grid;\n
    grid-template-columns: 48px minmax(0, 1fr);\n
    gap: 8px;\n
    align-items: center;\n
    min-width: 0;\n
    border: 1px solid var(--border);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-sunken);\n
    padding: 6px;\n
}\n
/* The thumbnail is [hidden] until the upload resolves, so pin the meta block to\n
   the flexible track instead of letting it auto-place into the 48px thumb track. */\n
.composer-upload-thumb { width: 48px; height: 48px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--surface); }\n
.composer-upload-meta { grid-column: 2; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 8px; align-items: center; min-width: 0; }\n
.composer-upload-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-strong); font-size: .82rem; font-weight: var(--weight-semibold); }\n
.composer-upload-status { min-width: 0; overflow-wrap: anywhere; color: var(--text-muted); font-size: .78rem; }\n
.composer-upload-card.is-failed .composer-upload-status { color: var(--danger); }\n
.composer-upload-summary { margin: 0; padding: 4px 10px 8px; color: var(--text-muted); font-size: .8rem; overflow-wrap: anywhere; }\n
.composer-upload-hint { color: var(--text-muted); font-size: .75rem; }\n
.composer-upload-card progress { width: 100%; height: 6px; grid-column: 1 / -1; appearance: none; border: 0; border-radius: var(--radius-pill); background: var(--surface); overflow: hidden; }\n
.composer-upload-card progress[hidden] { display: block !important; visibility: hidden; }\n
.composer-upload-card progress::-webkit-progress-bar { border-radius: var(--radius-pill); background: var(--surface); }\n
.composer-upload-card progress::-webkit-progress-value { border-radius: var(--radius-pill); background: var(--accent); }\n
.composer-upload-card progress::-moz-progress-bar { border-radius: var(--radius-pill); background: var(--accent); }\n
.composer-upload-card .input { min-width: 0; height: 30px; grid-column: 1 / -1; margin: 0; padding: 4px 7px; font-size: .78rem; }\n
.composer-upload-actions { display: flex; grid-column: 1 / -1; flex-wrap: wrap; justify-content: flex-end; gap: 4px; }\n
.composer-upload-actions .btn { min-height: 28px; margin: 0; padding: 3px 7px; font-size: .72rem; }\n
.composer-upload-actions [hidden] { display: none; }\n
\n
.composer-actions-bar {\n
    display: flex;\n
    align-items: center;\n
    justify-content: space-between;\n
    gap: 8px;\n
    min-width: 0;\n
    padding: 6px 8px;\n
    border-top: 1px solid var(--border-hair);\n
}\n
.composer-actions-start,\n
.composer-actions-end { display: flex; align-items: center; gap: 7px; min-width: 0; }\n
.composer-actions-start { flex: 1 1 auto; overflow: hidden; }\n
.composer-actions-end { flex: 0 0 auto; }\n
.composer-actions-start > [data-composer-actions-start-slot],\n
.composer-actions-end > [data-composer-actions-end-slot] { display: inline-flex; align-items: center; flex: 0 0 auto; }\n
.composer-format-toggle { position: relative; }\n
.composer-format-toggle,\n
.composer-attach-toggle,\n
.composer-emoji-toggle,\n
.composer-preview-toggle {\n
    min-height: 28px;\n
    padding: 3px 7px;\n
    border: 1px solid transparent;\n
    border-radius: var(--radius-sm);\n
    background: transparent;\n
    color: var(--text-muted);\n
    font: .78rem/1 var(--font-label);\n
    cursor: pointer;\n
}\n
.composer-format-toggle:hover,\n
.composer-attach-toggle:hover,\n
.composer-emoji-toggle:hover,\n
.composer-preview-toggle:hover,\n
.composer-format-toggle[aria-expanded="true"],\n
.composer-emoji-toggle[aria-expanded="true"],\n
.composer-preview-toggle[aria-expanded="true"] { border-color: var(--border-hair); background: var(--surface-sunken); color: var(--text-strong); }\n
.composer-actions-start:has(.composer-format-toggle[data-tip]:hover),\n
.composer-actions-start:has(.composer-format-toggle[data-tip]:focus-visible) { overflow: visible; }\n
/* Keep identity text inside its flex item when the tooltip opens above the row. */\n
.composer-actions-start .composer-identity,\n
.composer-actions-start .composer-anonymous-chip { overflow: hidden; }\n
.composer-attach-toggle { min-width: 30px; padding-inline: 5px; font-size: 1rem; }\n
.composer-emoji-toggle { min-width: 30px; padding-inline: 5px; font-size: 1rem; }\n
/* Editor mode and minimise are tertiary: they ride at the quiet end of the\n
   formatting row and must not read as peers of Preview, Cancel or Send. */\n
.composer-mode-toggle,\n
.composer-minimize {\n
    display: inline-flex;\n
    align-items: center;\n
    justify-content: center;\n
    min-height: 26px;\n
    padding: 3px 7px;\n
    border: 1px solid transparent;\n
    border-radius: var(--radius-sm);\n
    background: transparent;\n
    color: var(--text-muted);\n
    font: .74rem/1 var(--font-label);\n
    letter-spacing: .02em;\n
    cursor: pointer;\n
}\n
.composer-minimize[hidden] { display: none; }\n
.composer-mode-toggle:hover,\n
.composer-minimize:hover { border-color: var(--border-hair); background: var(--surface-sunken); color: var(--text-strong); }\n
.composer-minimize { width: 26px; min-width: 26px; padding: 0; }\n
.composer-minimize .icon { width: 15px; height: 15px; }\n
.composer-identity { display: inline-flex; align-items: center; gap: 6px; min-width: 0; max-width: min(250px, 32vw); color: var(--text-muted); font-size: .8rem; }\n
.composer-identity .monogram { width: 24px; height: 24px; flex: 0 0 24px; font-size: .58rem; }\n
.composer-identity-copy { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n
.composer-anonymous-chip { display: inline-flex; align-items: center; gap: 5px; min-width: 0; padding: 3px 7px; border: 1px solid var(--border-hair); border-radius: var(--radius-pill); font-size: .78rem; }\n
.composer-anonymous-chip input { width: 15px; height: 15px; margin: 0; accent-color: var(--accent); }\n
.composer-anonymous-chip label { margin: 0; white-space: nowrap; cursor: pointer; }\n
.composer-anonymous-chip:has(input:checked) { border-color: var(--accent-2); background: var(--gold-soft); color: var(--text-strong); }\n
.composer-shell .composer-send {\n
    display: inline-flex;\n
    align-items: center;\n
    justify-content: center;\n
    width: 36px;\n
    height: 36px;\n
    min-width: 36px;\n
    margin: 0;\n
    padding: 0;\n
    border-radius: 50%;\n
    font-size: 1rem;\n
}\n
/* The word is the accessible name's visible twin. It stays clipped until the\n
   dock is at rest, where an arrow alone does not say Reply. */\n
.composer-send-word {\n
    position: absolute;\n
    width: 1px;\n
    height: 1px;\n
    padding: 0;\n
    margin: -1px;\n
    overflow: hidden;\n
    clip: rect(0, 0, 0, 0);\n
    white-space: nowrap;\n
    border: 0;\n
}\n
.composer-send-mark { display: inline-flex; }\n
.composer-send:disabled { cursor: not-allowed; opacity: .48; }\n
.composer-shell.is-submitting .composer-send-mark .icon { animation: composer-quill 700ms linear infinite; }\n
@keyframes composer-quill { to { transform: rotate(360deg); } }\n
\n
.composer-meta-row {\n
    display: grid;\n
    grid-template-columns: auto minmax(0, 1fr) auto;\n
    align-items: start;\n
    gap: 5px 10px;\n
    min-width: 0;\n
    padding: 5px 4px 0;\n
    color: var(--text-muted);\n
    font-size: .78rem;\n
}\n
.composer-meta-draft { white-space: nowrap; }\n
.composer-meta-draft[hidden],\n
.composer-meta-draft:empty { display: none; }\n
.composer-discard { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }\n
.composer-anonymous-disclosure { min-width: 0; overflow-wrap: anywhere; }\n
.composer-count { font-family: var(--font-mono); color: var(--text-muted); font-size: .76rem; white-space: nowrap; }\n
.composer-count[hidden] { display: none; }\n
.composer-count.over { color: var(--danger); font-weight: var(--weight-semibold); }\n
/* The preview re-uses the server's render pipeline, so it must also re-use the\n
   published reading measure — otherwise what you proof is not what you post. */\n
.composer-preview {\n
    /* Global border-box sizing means the preview's 12px inline padding and 1px\n
       edges must sit OUTSIDE the same 66ch content measure as a published post. */\n
    max-width: calc(66ch + 26px);\n
    border: 1px solid var(--border);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-page);\n
    padding: 12px;\n
    margin-top: 8px;\n
    overflow-wrap: anywhere;\n
}\n
.composer-preview[hidden],\n
.composer-preview:empty { display: none; }\n
.composer-draft-sync {\n
    display: grid;\n
    gap: 8px;\n
    margin-top: 8px;\n
    padding: 8px 10px;\n
    border: 1px solid var(--border);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-sunken);\n
    color: var(--text-muted);\n
    font-size: .9rem;\n
}\n
.composer-draft-sync[hidden] { display: none; }\n
.composer-draft-sync.is-conflict { border-color: var(--warning); background: var(--gold-soft); color: var(--text-strong); }\n
.composer-draft-sync p { margin: 0; }\n
.composer-draft-sync-actions { display: flex; flex-wrap: wrap; gap: 6px; }\n
\n
.composer-suggestion-popover {\n
    position: absolute;\n
    z-index: 60;\n
    left: 8px;\n
    right: 8px;\n
    bottom: calc(100% + 7px);\n
    max-height: min(280px, 45vh);\n
    overflow: auto;\n
    border: 1px solid var(--border);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-raised);\n
    box-shadow: var(--shadow-lg);\n
    padding: 5px;\n
}\n
.composer-suggestion-popover[hidden] { display: none; }\n
.composer-slash-menu { display: flex; flex-wrap: wrap; gap: 6px; }\n
.composer-slash-command,\n
.composer-slash-gif { font: inherit; color: var(--text); cursor: pointer; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); padding: 6px 9px; }\n
.composer-slash-command:hover,\n
.composer-slash-gif:hover { background: var(--surface-3); }\n
.composer-slash-command[aria-selected="true"],\n
.composer-slash-gif[aria-selected="true"] { background: var(--surface-3); outline: 2px solid var(--accent); outline-offset: -2px; }\n
.composer-slash-status { margin: 0; padding: 5px 9px; color: var(--text-muted); }\n
.composer-slash-gif { display: grid; grid-template-columns: 56px minmax(0, 1fr); align-items: center; gap: 8px; text-align: left; }\n
.composer-slash-gif img { width: 56px; height: 56px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--border); }\n
.composer-reference-option { width: 100%; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 8px; border: 0; background: transparent; color: var(--text); text-align: left; padding: 7px 9px; border-radius: var(--radius-md); }\n
.composer-reference-option[aria-selected="true"],\n
.composer-reference-option:hover { background: var(--surface-3); }\n
.composer-reference-option .badge { grid-row: span 2; align-self: center; }\n
.composer-reference-meta { min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--text-muted); font-size: .86rem; }\n
.composer-reference-option.is-emoji .badge { min-width: 28px; padding: 2px; text-align: center; font-size: 1.2rem; }\n
.composer-reference-option.is-emoji .badge img { display: block; width: 24px; height: 24px; object-fit: contain; }\n
\n
.composer-emoji-dialog {\n
    position: absolute;\n
    z-index: 85;\n
    left: 8px;\n
    bottom: calc(100% + 7px);\n
    display: flex;\n
    width: min(440px, calc(100% - 16px));\n
    max-height: min(440px, 30vh);\n
    flex-direction: column;\n
    gap: 9px;\n
    padding: 12px;\n
    overflow: hidden;\n
    border: 1px solid var(--border);\n
    border-radius: var(--radius-lg);\n
    background: var(--surface-raised);\n
    box-shadow: var(--shadow-lg);\n
    transition: opacity 140ms var(--ease-calm), translate 140ms var(--ease-calm);\n
}\n
.composer-emoji-dialog[hidden] { display: none; }\n
.composer-emoji-dialog.is-below { top: calc(100% + 7px); bottom: auto; }\n
.composer-emoji-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n
.composer-emoji-title,\n
.composer-emoji-group-title { margin: 0; font-family: var(--font-label); color: var(--text-strong); }\n
.composer-emoji-title { font-size: .95rem; }\n
.composer-emoji-close {\n
    display: inline-flex;\n
    width: 30px;\n
    height: 30px;\n
    align-items: center;\n
    justify-content: center;\n
    padding: 0;\n
    border: 1px solid transparent;\n
    border-radius: var(--radius-sm);\n
    background: transparent;\n
    color: var(--text-muted);\n
    font-size: 1.3rem;\n
    cursor: pointer;\n
}\n
.composer-emoji-close:hover { border-color: var(--border-hair); background: var(--surface-sunken); color: var(--text-strong); }\n
.composer-emoji-search {\n
    width: 100%;\n
    min-height: 38px;\n
    margin: 0;\n
    padding: 7px 10px;\n
    border: 1px solid var(--border);\n
    border-radius: var(--radius-md);\n
    background: var(--surface);\n
    color: var(--text);\n
}\n
.composer-emoji-status { margin: 0; color: var(--text-muted); font-size: .84rem; }\n
.composer-emoji-status:empty { display: none; }\n
.composer-emoji-groups { display: grid; gap: 13px; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }\n
.composer-emoji-group { display: grid; gap: 6px; min-width: 0; }\n
.composer-emoji-group-title { font-size: .74rem; letter-spacing: .035em; text-transform: uppercase; }\n
.composer-emoji-grid-cells {\n
    display: grid;\n
    grid-template-columns: repeat(auto-fill, minmax(42px, 1fr));\n
    gap: 4px;\n
}\n
.composer-emoji-cell {\n
    display: inline-flex;\n
    min-width: 42px;\n
    height: 42px;\n
    align-items: center;\n
    justify-content: center;\n
    padding: 3px;\n
    border: 1px solid transparent;\n
    border-radius: var(--radius-sm);\n
    background: transparent;\n
    color: var(--text);\n
    font-size: 1.45rem;\n
    line-height: 1;\n
    cursor: pointer;\n
}\n
.composer-emoji-cell img { width: 27px; height: 27px; object-fit: contain; }\n
.composer-emoji-cell:hover { border-color: var(--border-hair); background: var(--surface-sunken); }\n
.composer-emoji-cell:focus-visible,\n
.composer-emoji-close:focus-visible,\n
.composer-emoji-search:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n
\n
@media (max-width: 640px) {\n
    .composer-toolbar { overflow: hidden; }\n
    .composer-toolbar-action:not(.is-essential),\n
    .composer-toolbar-sep { display: none; }\n
    .composer-more-wrap { display: inline-flex; flex: 0 0 auto; }\n
    .composer-suggestion-popover {\n
        position: fixed;\n
        left: 8px;\n
        right: 8px;\n
        bottom: max(8px, env(safe-area-inset-bottom));\n
        z-index: 90;\n
        max-height: 50dvh;\n
        border-radius: var(--radius-lg);\n
    }\n
    .composer-emoji-dialog {\n
        position: fixed;\n
        z-index: 95;\n
        left: 8px;\n
        right: 8px;\n
        bottom: max(8px, env(safe-area-inset-bottom));\n
        width: auto;\n
        max-height: min(70dvh, 620px);\n
        border-radius: var(--radius-lg);\n
    }\n
    .composer-emoji-dialog.is-below { top: auto; }\n
    .composer-meta-row { grid-template-columns: minmax(0, 1fr) auto; }\n
    .composer-anonymous-disclosure { grid-column: 1 / -1; }\n
}\n
\n
@media (hover: none), (pointer: coarse) {\n
    .composer-toolbar-action,\n
    .composer-more-toggle,\n
    .composer-format-toggle,\n
    .composer-attach-toggle,\n
    .composer-emoji-toggle,\n
    .composer-emoji-close,\n
    .composer-emoji-cell,\n
    .composer-mode-toggle,\n
    .composer-minimize,\n
    .composer-preview-toggle { min-width: 44px; min-height: 44px; }\n
}\n
\n
@media (prefers-reduced-motion: reduce) {\n
    .composer-box,\n
    .composer-suggestion-popover { transition: none; }\n
    .composer-toolbar-action[data-tip]::after { transition: none; }\n
    .composer-emoji-dialog { transition: none; }\n
    .composer-shell.is-submitting .composer-send-mark .icon { animation: none; }\n
}\n
\n
/* Uploaded media (P3-04). */\n
.post-media { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }\n
.post-media img { max-width: 320px; max-height: 320px; border-radius: var(--radius); border: 1px solid var(--border); }\n
\n
/* Pending-approval banner (P3-05). */\n
.pending-banner {\n
    background: var(--surface-3); border: 1px solid var(--border);\n
    border-radius: var(--radius); padding: 8px 12px; margin: 8px 0; color: var(--text-muted);\n
}\n
\n
/* Deleted-reply stub (ADMIN §3.3 Restore) — staff-only render. */\n
.post-deleted {\n
    background: var(--surface-3); border: 1px dashed var(--border);\n
    border-radius: var(--radius); padding: 8px 12px; color: var(--text-muted);\n
}\n
.post-deleted .post-author { color: var(--text-muted); }\n
.post-deleted-body { opacity: 0.75; margin-top: 8px; }\n
.post-deleted-restore { margin-top: 8px; }\n
\n
/* ── Phase 3: product tour (P3-11) ────────────────────────────────────────\n
   Enhancement only; the forum is fully usable without it. No inline styles\n
   (the strict CSP forbids them) — the popover is positioned by class. */\n
.tour-popover {\n
    position: fixed;\n
    left: 50%;\n
    bottom: 24px;\n
    transform: translateX(-50%);\n
    max-width: 420px;\n
    width: calc(100% - 32px);\n
    background: var(--surface);\n
    border: 1px solid var(--border);\n
    border-radius: var(--radius);\n
    box-shadow: var(--shadow-xl);\n
    padding: 16px;\n
    z-index: 1000;\n
}\n
.tour-popover h3 { margin: 0 0 6px; font-size: 1.05em; }\n
.tour-popover p { margin: 0 0 12px; color: var(--text-muted); }\n
.tour-actions { display: flex; gap: 8px; justify-content: flex-end; align-items: center; }\n
.tour-actions .tour-progress { margin-right: auto; color: var(--text-muted); font-size: 0.85em; }\n
.tour-highlight { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: var(--radius-sm); }\n
[data-reduced-motion="1"] .tour-popover { box-shadow: none; }\n
.subnav-action { align-self: center; }\n
\n
/* Site announcement banner (ADMIN §7.4) */\n
.site-announcement {\n
    display: flex;\n
    align-items: center;\n
    gap: .75rem;\n
    padding: .6rem 1rem;\n
    background: var(--accent);\n
    color: var(--accent-contrast);\n
}\n
.site-announcement-message { margin: 0; flex: 1; }\n
.site-announcement-dismiss {\n
    background: transparent;\n
    border: 0;\n
    color: inherit;\n
    font-size: 1.25rem;\n
    line-height: 1;\n
    cursor: pointer;\n
}\n
.site-announcement[hidden] { display: none; }\n
\n
/* ══════════════════════════════════════════════════════════════════════════\n
   Imladris — Phase 1: shell chrome (topbar, sidebar rail, brand mark).\n
   Appended so same-specificity rules override earlier ones by source order.\n
   No inline styles (CSP-safe); SVG marks use presentation attributes only.\n
   ══════════════════════════════════════════════════════════════════════════ */\n
\n
/* Top bar — parchment at ~90% with a candlelit blur. */\n
.topbar-link {\n
    color: var(--text-muted); font-family: var(--font-label);\n
    letter-spacing: .03em; font-size: .85rem;\n
}\n
.topbar-link:hover { color: var(--brand); text-decoration: none; }\n
\n
.bell { position: relative; display: inline-flex; align-items: center; color: var(--text-muted); }\n
.bell:hover { color: var(--brand); }\n
.bell-ic { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; display: block; }\n
.bell-count { background: var(--accent-2); color: var(--ink-900); }\n
\n
\n
.pill { font-family: var(--font-label); letter-spacing: .04em; text-transform: uppercase; font-size: .72rem; }\n
\n
.hash { color: var(--gold-ink); font-weight: var(--weight-medium); width: 11px; text-align: center; display: inline-block; }\n
\n
.presence-title { font-family: var(--font-label); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-muted); }\n
\n
/* ══════════════════════════════════════════════════════════════════════════\n
   Imladris — Phase 2: thread list, conversation & composer.\n
   ══════════════════════════════════════════════════════════════════════════ */\n
\n
/* Chips (status / role) — lapidary Marcellus pills. */\n
.badge, .chip {\n
    display: inline-flex; align-items: center; gap: 4px;\n
    font-family: var(--font-label); font-size: .62rem; letter-spacing: .1em;\n
    text-transform: uppercase; line-height: 1;\n
    padding: 3px 9px; border-radius: var(--radius-pill);\n
    background: var(--brand-subtle); color: var(--on-brand-subtle);\n
    border: 1px solid var(--green-200); vertical-align: middle;\n
}\n
.chip-solved  { color: var(--on-done);   background: var(--surface-done);   border-color: var(--green-200); }\n
.chip-needs   { color: var(--on-review); background: var(--surface-review); border-color: var(--gold-200); }\n
/* Pinned groups with Locked as a neutral marker (§10); the gold pinned cue is the\n
   card left-rule (.thread-pinned::before), not the chip. */\n
.chip-pinned,\n
.chip-locked,\n
.badge-muted  { color: var(--text-muted); background: var(--surface-sunken); border-color: var(--border-hair); }\n
/* Archived = the ghost of the set: faded, transparent, dashed (§10). */\n
.chip-archived { color: var(--text-faint); background: transparent; border-style: dashed; border-color: var(--border-strong); }\n
/* Staff = gold so it never reads as the green OP badge (§10). The pair is semantic,\n
   not the numbered primitives: --gold-700 on --gold-100 measured 3.55:1 and, because\n
   the dark register never remaps the numbered golds, shipped a light-register chip on\n
   a twilight page. --on-staff/--surface-staff flip and clear AA in both. */\n
.badge-staff  { color: var(--on-staff); background: var(--surface-staff); border-color: var(--gold-200); }\n
/* Accepted answer = outlined on the card surface, distinct from the filled Solved chip (§10). */\n
.badge-solved { color: var(--on-done);   background: var(--surface-raised); border-color: var(--green-200); }\n
.tag {\n
    font-family: var(--font-label); font-size: .6rem; letter-spacing: .08em;\n
    text-transform: uppercase; background: var(--surface-sunken); color: var(--text-muted);\n
    border-radius: var(--radius-pill); padding: 2px 8px; margin-left: 6px;\n
}\n
\n
/* Board header + index cards. */\n
.board-header { margin-bottom: 14px; border-bottom: 1px solid var(--border-hair); padding-bottom: 14px; }\n
.board-header h1 { display: flex; align-items: center; gap: 8px; margin: 0; }\n
.board-header h1 .hash { color: var(--gold-ink); font-size: 1.6rem; width: auto; }\n
.cat-title { font-family: var(--font-label); color: var(--gold-ink); letter-spacing: var(--tracking-caps); }\n
.board-row { border-radius: var(--radius-lg); box-shadow: var(--shadow-xs); transition: box-shadow var(--dur-fast) var(--ease-calm), transform var(--dur-fast) var(--ease-calm); }\n
.board-row:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); }\n
.board-name { font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 1.15rem; }\n
.board-stats { font-family: var(--font-mono); }\n
\n
/* Thread list — parchment cards with a status left-rule (::before, so hover\n
   shadows never clobber the rule). */\n
/* Topic rows are quiet rows, not cards (consolidation pass §5a): hairline\n
   dividers over per-row boxes; the 3px status rule and the chips stay as the\n
   word+colour signals; unread is the dot + the semibold title. */\n
.thread-list { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 0; }\n
.thread-row {\n
    position: relative;\n
    display: flex; gap: 13px; align-items: flex-start;\n
    padding: 14px 16px; border: 0;\n
    background: none; box-shadow: none; overflow: hidden;\n
    transition: background var(--dur-fast) var(--ease-calm);\n
}\n
.thread-list > .thread-row + .thread-row { border-top: 1px solid var(--border-hair); }\n
.thread-row::before {\n
    content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: transparent;\n
}\n
.thread-row:hover { background: var(--surface-sunken); transform: none; }\n
.thread-pinned::before              { background: var(--gold-400); }\n
.thread-status-solved::before       { background: var(--leaf); }\n
.thread-status-needs_answer::before { background: var(--amber); }\n
.thread-row-main { min-width: 0; flex: 1; }\n
.thread-row-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 4px; }\n
.thread-row-chips:empty { display: none; }\n
.thread-title {\n
    display: block; font-family: var(--font-display); font-weight: var(--weight-medium);\n
    font-size: 1.2rem; line-height: 1.2; color: var(--text-strong); letter-spacing: -0.01em;\n
}\n
.thread-title:hover { text-decoration: none; color: var(--brand); }\n
.thread-unread .thread-title { font-weight: var(--weight-semibold); }\n
.thread-meta { font-family: var(--font-label); font-size: .75rem; letter-spacing: .02em; color: var(--text-faint); margin-top: 6px; display: block; }\n
.thread-board, .thread-board .hash { color: var(--gold-ink); }\n
.thread-meta .thread-board { text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 1px; }\n
\n
/* Thread page header + post stream. */\n
.thread-head { margin-bottom: 16px; padding-bottom: 14px; border-bottom: 1px solid var(--border-hair); }\n
.breadcrumb { font-family: var(--font-mono); font-size: .8rem; color: var(--text-faint); margin: 0 0 8px; }\n
.post {\n
    display: flex; gap: 13px; background: var(--surface-raised);\n
    border: 1px solid var(--border-hair); border-radius: var(--radius-lg); padding: 16px 18px;\n
    box-shadow: var(--shadow-xs);\n
}\n
.post-author { font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: 1.05rem; color: var(--text-strong); }\n
.post-time, .post-edited { font-family: var(--font-mono); font-size: .72rem; color: var(--text-faint); }\n
/* .post-body carries the reading MEASURE only — family, size, leading, ink and\n
   every block-element rule come from the shared .formatted-content contract so\n
   a post, a live preview and a bio can't drift apart. Do not restate type here. */\n
.post-body { max-width: 66ch; }\n
.post-signature { border-top: 1px solid var(--border-hair); font-family: var(--font-body); }\n
\n
/* Composer card + serif inputs with a gold focus ring. */\n
.composer-input, textarea.input {\n
    font-family: var(--font-body);\n
    border-radius: var(--radius-md); border: 1.5px solid var(--border-soft);\n
    background: var(--surface-raised); box-shadow: var(--shadow-inset);\n
}\n
.composer-input:focus,\n
.input:focus, textarea:focus, select:focus {\n
    border-color: var(--gold-400);\n
    outline: 2px solid var(--accent); outline-offset: 1px;  /* high-contrast (>=3:1) focus ring */\n
    /* Layered OVER the inset, per DESIGN.md "Inputs and fields" -> Focus. The\n
       halo alone would replace the base field's inset for exactly as long as the\n
       field is focused — the same failure the .input-engraved:focus comment\n
       below records and restates the inset to avoid. */\n
    box-shadow: var(--shadow-inset), 0 0 0 3px var(--focus-ring);\n
}\n
.composer-label { font-family: var(--font-label); letter-spacing: .03em; color: var(--text-muted); }\n
\n
/* Guest join-bar — the open hall. */\n
.joinbar { background: var(--brand-subtle); border: 1px solid var(--green-200); border-radius: var(--radius-lg); color: var(--text-body); }\n
.joinbar-archived { background: var(--surface-sunken); border-color: var(--border-hair); }\n
\n
/* ══════════════════════════════════════════════════════════════════════════\n
   What is left of Phase 3's Community Inbox. The surface itself was rewritten\n
   against ForumInbox.dc.html and now lives in the member-surfaces block below\n
   (search "Forum inbox"); everything that block owns has been removed from here.\n
\n
   What was removed was either markup this route no longer emits or a rule its\n
   own replacement had to outrank — including a 56px `.inbox-empty-star`, which\n
   the replacement re-coloured but never resized, so the reading pane's quiet\n
   mark printed at nearly twice the size the design asks for. A superseded\n
   rule left upstream of its replacement is how a rewritten surface silently\n
   keeps a slice of the surface it replaced.\n
   ══════════════════════════════════════════════════════════════════════════ */\n
/* The one shell decision this route still makes: the three panes are\n
   full-bleed where every other member surface is capped and centred. */\n
body[data-route="inbox"] .app-shell { max-width: none; }\n
\n
/* Marcellus pill tabs. The inbox's own filter tabs are retired — /feed and\n
   /leaderboard still wear them, so the pills stay. */\n
.inbox-tabs { display: flex; gap: 6px; margin: 12px 0 4px; }\n
.inbox-tab {\n
    flex: none; white-space: nowrap; border-radius: var(--radius-pill);\n
    padding: 6px 13px; font-family: var(--font-label); font-size: .78rem; letter-spacing: .03em;\n
    color: var(--text-muted); border: 1px solid transparent;\n
}\n
.inbox-tab:hover { background: var(--surface-sunken); text-decoration: none; }\n
.inbox-tab.is-active { background: var(--brand); color: var(--parchment-50); font-weight: var(--weight-medium); border-color: var(--brand); }\n
\n
.mobile-only { display: none; }\n
/* A whole topic injected into the reading pane keeps the measure it gets on its\n
   own page — the same 760px the pane's own content column uses. */\n
.inbox-reading .thread-view, .inbox-reading .board-view { max-width: 760px; }\n
\n
/* ══════════════════════════════════════════════════════════════════════════\n
   Imladris — Phase 4: mobile (off-canvas drawer, FAB, touch targets).\n
   Scripting capability fixes the geometry before deferred scripts arrive.\n
   Native fragment links keep a slow/failed bundle usable; with scripting\n
   disabled the rail still stacks above the content.\n
   ══════════════════════════════════════════════════════════════════════════ */\n
.nav-toggle {\n
    display: none; align-items: center; justify-content: center;\n
    flex: none;\n
    width: 44px; height: 44px; margin-right: 2px;\n
    background: transparent; border: 1.5px solid transparent; border-radius: var(--radius-md);\n
    color: var(--text-body); cursor: pointer;\n
}\n
.nav-toggle-ic { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }\n
.nav-toggle[hidden], .nav-close { display: none; }\n
body.variant-plain .nav-toggle { display: none; }  /* no rail on auth/error pages → no dead control */\n
\n
/* Floating "new topic" affordance (mobile, board context). */\n
.fab {\n
    display: none; position: fixed; right: 18px; bottom: 22px; z-index: 45;\n
    width: 56px; height: 56px; border-radius: 50%;\n
    align-items: center; justify-content: center;\n
    background: var(--brand); color: var(--accent-contrast);\n
    box-shadow: var(--shadow-lg), var(--gilt);\n
}\n
.fab:hover { background: var(--brand-hover); text-decoration: none; }\n
.fab svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n
\n
@media (max-width: 860px) and (scripting: enabled) {\n
    .nav-toggle:not([hidden]) { display: inline-flex; }\n
    body[data-nav-ready] [data-nav-fallback] { display: none; }\n
    /* The drawer's own close control, in its Tab loop before the enhancement\n
       arrives and after: Topic tools' grammar, a 44px cross at the top corner\n
       that takes focus when the drawer opens. Escape and the scrim still close\n
       it too. */\n
    .nav-close {\n
        display: inline-flex; align-self: flex-end; align-items: center; justify-content: center;\n
        flex: none; width: 44px; height: 44px; margin: -14px -6px 0 0;\n
        border-radius: var(--radius-pill); color: var(--text-faint);\n
    }\n
    .nav-close .icon { width: 20px; height: 20px; }\n
    .nav-close:hover, .nav-close:focus-visible { background: var(--surface-page); color: var(--text-strong); }\n
    .nav-close:focus-visible { border-radius: var(--radius-pill); }\n
\n
    /* The layer's .board-rail is a column in a\n
       fixed-height flex shell; on a phone it becomes this fixed drawer, which\n
       undoes the sticky desktop geometry the "Member chrome" block gives it. */\n
    :root .app-shell { display: block; height: calc(100vh - var(--topbar-h)); height: calc(100dvh - var(--topbar-h)); }\n
    .app-shell > .board-rail {\n
        position: fixed; top: var(--topbar-h); bottom: 0; left: 0;\n
        display: flex; width: 322px; max-width: 86vw; max-height: none; z-index: var(--z-drawer);\n
        transform: translateX(-100%);\n
        /* A translated rail still participates in keyboard navigation. */\n
        visibility: hidden;\n
        transition: transform var(--dur-base) var(--ease-calm);\n
        box-shadow: var(--shadow-xl); overflow-y: auto;\n
    }\n
    body.nav-open .board-rail,\n
    body:not([data-nav-ready]) .board-rail:target { transform: none; visibility: visible; }\n
    .main { width: 100%; }\n
    .nav-scrim:not([hidden]) {\n
        position: fixed; inset: 0; top: var(--topbar-h);\n
        background: var(--scrim); z-index: var(--z-scrim);\n
    }\n
}\n
@media (max-width: 860px) {\n
    .fab { display: inline-flex; }\n
\n
    /* The inbox's own phone rules now collapse at 1279px, not 860 — where the\n
       reading pane actually runs out of room — and live with the rest of the\n
       surface in the member-surfaces block below. */\n
\n
    /* Comfortable touch targets + room for the FAB. */\n
    .inbox-tab { min-height: 44px; }\n
    .main { padding: 16px 14px 88px; }\n
    .thread-title { font-size: 1.1rem; }\n
}\n
\n
/* ══════════════════════════════════════════════════════════════════════════\n
   Imladris — Phase 5: leaderboard, profile, workflow bars (canvas-referenced\n
   surfaces; everything else inherits the tokens + typography).\n
   ══════════════════════════════════════════════════════════════════════════ */\n
.leaderboard-list { list-style: none; padding: 0; margin: 18px 0; }\n
.leaderboard-row { display: flex; align-items: center; gap: 14px; padding: 12px 4px; border-top: 1px solid var(--border-hair); }\n
.lb-rank { font-family: var(--font-mono); color: var(--text-faint); min-width: 2.2em; text-align: center; }\n
.lb-rank-roman { font-family: var(--font-display); font-size: 1.6rem; font-weight: var(--weight-medium); color: var(--gold-600); }\n
.lb-top {\n
    border: 1px solid var(--green-200); border-top: 1px solid var(--green-200);\n
    border-radius: var(--radius-lg); background: var(--surface-raised);\n
    box-shadow: var(--shadow-xs); padding: 14px 16px; margin-bottom: 8px;\n
}\n
.lb-top .monogram { width: 44px; height: 44px; font-size: .95rem; }\n
.lb-name { font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 1.1rem; }\n
.lb-top .lb-name { font-size: 1.25rem; }\n
.lb-rep { margin-left: auto; font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: 1.1rem; color: var(--text-strong); display: inline-flex; align-items: center; gap: 5px; font-variant-numeric: tabular-nums; }\n
.lb-rep .star-marker { color: var(--star); margin: 0; }\n
\n
/* Workflow / mod action bars — keep them on one calm line. */\n
.workflow-bar, .workflow-actions, .mod-bar { align-items: center; }\n
.workflow-bar .linkbtn, .mod-bar .linkbtn { font-family: var(--font-label); letter-spacing: .02em; }\n
\n
/* Profile — display-serif stats. */\n
.profile-stats dd { font-family: var(--font-display); }\n
\n
/* ══════════════════════════════════════════════════════════════════════════\n
   Imladris — Engineering-Handoff fidelity pass.\n
   Visual-only; hooks existing markup/tokens. Strict CSP (classes, no inline).\n
   ══════════════════════════════════════════════════════════════════════════ */\n
\n
/* — Compact "Watch" density: one scannable line per topic, status on the left rule (§4) — */\n
[data-density="compact"] .thread-list { gap: 0; }\n
[data-density="compact"] .thread-row {\n
    flex-direction: row; align-items: center; gap: 10px;\n
    border: 0; border-radius: 0;\n
    box-shadow: none; background: transparent; padding: 9px 16px;\n
}\n
[data-density="compact"] .thread-row .monogram { width: 26px; height: 26px; font-size: .68rem; }\n
[data-density="compact"] .thread-row-main { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }\n
[data-density="compact"] .thread-title { order: 1; flex: 1; min-width: 0; font-size: 1rem; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n
[data-density="compact"] .thread-row-chips { order: 2; flex: 0 0 auto; margin-bottom: 0; }\n
[data-density="compact"] .thread-meta { order: 3; flex: 0 0 auto; margin-top: 0; white-space: nowrap; }\n
[data-density="compact"] .thread-unread::before { background: var(--accent-2); }\n
[data-density="compact"] .thread-star { align-self: center; }\n
\n
/* — Topic rows: the starred marker is the commend star, pinned to the trailing\n
   edge; quiet on a list, where the queue's star is a control (§4) — */\n
.thread-star { display: inline-flex; margin-left: auto; align-self: flex-start; flex: 0 0 auto; padding-left: 8px; color: var(--star); }\n
.thread-star .icon { width: 14px; height: 14px; }\n
\n
/* — Guest join-bar: a flex card with a primary Log in button (§5.3) — */\n
.joinbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }\n
.joinbar > span { min-width: 0; }\n
.joinbar .btn { flex: 0 0 auto; }\n
\n
/* — Conversation: precious (OP / accepted) avatars + composer card + byline + star pill (§5.1) — */\n
.post-op .monogram, .post-accepted .monogram { box-shadow: var(--gilt); width: 44px; height: 44px; font-size: .95rem; }\n
#reply.composer {\n
    background: transparent; border: 0;\n
    border-radius: 0; box-shadow: none; padding: 0; margin-top: 18px;\n
}\n
.thread-conversation { display: flex; flex-direction: column; min-width: 0; min-height: 0; }\n
/* The document owns thread scrolling, including native post fragments. A short\n
   topic still fills the pane; longer topics grow around the sticky reply dock. */\n
body[data-route="thread"] .thread-conversation {\n
    min-height: calc(100vh - var(--topbar-h) - 48px);\n
    min-height: calc(100dvh - var(--topbar-h) - 48px);\n
}\n
.thread-scroll { flex: 1 0 auto; min-width: 0; padding-bottom: 12px; }\n
.thread-dock {\n
    position: sticky; bottom: 0; z-index: 2; flex: 0 0 auto; min-width: 0;\n
    margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-hair);\n
    background: var(--surface-raised);\n
}\n
.thread-dock #reply.composer, .thread-dock .joinbar { margin: 0; }\n
.inbox-reading.is-open { overflow: hidden; }\n
.inbox-reading.is-open [data-inbox-reading-content],\n
.inbox-reading.is-open .thread-conversation { height: 100%; min-height: 0; }\n
@media (max-width: 860px) {\n
    /* Let the shell grow with a document-scrolling topic so the sticky header\n
       remains inside its containing block all the way through the stream. */\n
    body[data-route="thread"] .app-shell { height: auto; }\n
    body[data-route="thread"] .main { padding-bottom: 16px; }\n
    body[data-route="thread"] .thread-conversation {\n
        min-height: calc(100vh - var(--topbar-h) - 32px);\n
        min-height: calc(100dvh - var(--topbar-h) - 32px);\n
    }\n
    .thread-dock { margin-top: 8px; padding-top: 8px; }\n
    .inbox-reading.is-open {\n
        height: calc(100vh - var(--topbar-h));\n
        height: calc(100dvh - var(--topbar-h));\n
        padding: 10px 14px 14px;\n
    }\n
    .inbox-reading.is-open [data-inbox-reading-content] { height: calc(100% - 48px); }\n
}\n
/* The topic dock rests at every width: one line until someone is answering.\n
   .is-expanded keeps a draft or a validation error open. Before wireExpansion\n
   installs, native focus and typed text expose the full form. Messages keeps\n
   its own rest inside the 860px block below — a desktop conversation is not\n
   this reading column. */\n
@media (scripting: enabled) {\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-box {\n
        display: grid;\n
        grid-template-columns: minmax(0, 1fr) auto;\n
        align-items: center;\n
        gap: 4px;\n
        padding: 3px;\n
        border-radius: var(--radius-pill);\n
    }\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-header,\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-format-slot,\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-upload-tray,\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-actions-start,\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-actions-end > :not(.composer-send),\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-meta-row,\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) [data-composer-after-box],\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .wysiwyg-source-toggle { display: none; }\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-input,\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .wysiwyg-composer {\n
        grid-column: 1;\n
        grid-row: 1;\n
        width: 100%;\n
        height: 44px;\n
        min-height: 44px;\n
        max-height: 44px;\n
        margin: 0;\n
        resize: none;\n
        overflow: hidden;\n
    }\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .wysiwyg-composer .ProseMirror {\n
        height: 44px; min-height: 44px; max-height: 44px; padding: 10px 12px; overflow: hidden;\n
    }\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-actions-bar {\n
        grid-column: 2;\n
        grid-row: 1;\n
        padding: 0;\n
        border: 0;\n
    }\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-send {\n
        width: auto;\n
        min-width: 0;\n
        height: 36px;\n
        padding: 0 14px;\n
        border-radius: var(--radius-md);\n
    }\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-send-word {\n
        position: static;\n
        width: auto;\n
        height: auto;\n
        margin: 0;\n
        overflow: visible;\n
        clip: auto;\n
    }\n
    .thread-dock .reply-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-send-mark { display: none; }\n
}\n
@media (max-width: 860px) and (scripting: enabled) {\n
    /* A Messages conversation's .dm-composer is the same shared dock (COMPOSER.md\n
       §2, §13) on a phone. The topic dock above already rests at every width. */\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-box {\n
        display: grid;\n
        grid-template-columns: minmax(0, 1fr) auto;\n
        align-items: center;\n
        gap: 4px;\n
        padding: 3px;\n
        border-radius: var(--radius-pill);\n
    }\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-header,\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-format-slot,\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-upload-tray,\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-actions-start,\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-actions-end > :not(.composer-send),\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-meta-row,\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) [data-composer-after-box],\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .wysiwyg-source-toggle { display: none; }\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-input,\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .wysiwyg-composer {\n
        grid-column: 1;\n
        grid-row: 1;\n
        width: 100%;\n
        height: 44px;\n
        min-height: 44px;\n
        max-height: 44px;\n
        margin: 0;\n
        resize: none;\n
        overflow: hidden;\n
    }\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .wysiwyg-composer .ProseMirror {\n
        height: 44px; min-height: 44px; max-height: 44px; padding: 10px 12px; overflow: hidden;\n
    }\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-actions-bar {\n
        grid-column: 2;\n
        grid-row: 1;\n
        padding: 0;\n
        border: 0;\n
    }\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-send {\n
        width: auto;\n
        min-width: 0;\n
        height: 36px;\n
        padding: 0 14px;\n
        border-radius: var(--radius-md);\n
    }\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-send-word {\n
        position: static;\n
        width: auto;\n
        height: auto;\n
        margin: 0;\n
        overflow: visible;\n
        clip: auto;\n
    }\n
    .dm-composer:not(.is-expanded):is([data-composer-dock="1"], :not(:focus-within):not(:has(.composer-input:not(:placeholder-shown)))) .composer-send-mark { display: none; }\n
}\n
.thread-byline { font-family: var(--font-label); font-size: .78rem; letter-spacing: .02em; color: var(--text-muted); margin: 4px 0 0; }\n
.star-btn {\n
    font-family: var(--font-label); font-size: .78rem; letter-spacing: .03em;\n
    background: var(--surface-raised); color: var(--text-body);\n
    border: 1.5px solid var(--border-soft); border-radius: var(--radius-md); padding: 6px 13px;\n
}\n
.star-btn:hover { border-color: var(--border-strong); background: var(--surface-sunken); text-decoration: none; }\n
.star-btn.star-on { color: var(--gold-700); border-color: var(--gold-200); background: var(--gold-100); }\n
\n
/* — Thread breadcrumb reads as a back control (the figure's back chevron, §6) — */\n
.breadcrumb-back-ic { width: 13px; height: 13px; vertical-align: -1px; margin-right: 3px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n
\n
/* — Member profile: the twilight identity cover (§5.4) — */\n
.profile { max-width: 1000px; margin: 0 auto; padding-bottom: 96px; }\n
.profile-cover {\n
    position: relative; z-index: 2; overflow: visible;\n
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 22px; align-items: start;\n
    /* The approved profile cover stays twilight in both theme registers. The\n
       semantic inverse tokens intentionally swap to parchment in dark mode. */\n
    background: var(--twilight-800); color: var(--parchment-50);\n
    border: 1px solid color-mix(in srgb, var(--gold-500) 16%, transparent);\n
    border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);\n
    padding: 26px 28px 24px; margin: 2px 0 0;\n
}\n
/* The star is clipped to the rounded cover. The cover itself stays overflow\n
   visible so the action menu can leave the card on a short profile and on a phone;\n
   z-index 2 keeps that open menu above the tab panel's own z-index 1 search icon. */\n
.profile-cover-canvas {\n
    position: absolute; inset: 0; overflow: hidden; border-radius: inherit; pointer-events: none;\n
}\n
.profile-cover-star { position: absolute; top: -58px; right: -46px; width: 230px; height: 230px; color: var(--gold-500); opacity: .11; pointer-events: none; }\n
.profile-avatar { position: relative; display: inline-flex; }\n
.profile-avatar .monogram { width: 84px; height: 84px; font-size: 1.9rem; box-shadow: var(--gilt); }\n
.profile-avatar .presence-dot { position: absolute; right: 4px; bottom: 4px; width: 14px; height: 14px; border-radius: 50%; background: var(--presence); box-shadow: 0 0 0 3px var(--twilight-800); }\n
/* Nothing clips the cover, so an unbroken name or handle must wrap inside it. */\n
.profile-cover .profile-id { min-width: 0; overflow-wrap: anywhere; }\n
.profile-name { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; margin: 2px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); color: var(--parchment-50); font-size: 2.25rem; line-height: 1.08; letter-spacing: -.01em; }\n
.profile-tier { font-family: var(--font-label); text-transform: uppercase; letter-spacing: .1em; font-size: .68rem; color: var(--gold-800); background: var(--gold-100); border: 1px solid var(--gold-200); border-radius: var(--radius-pill); padding: 3px 10px; }\n
.profile-handle { font-family: var(--font-mono); font-size: .82rem; color: var(--mist-200); margin: 7px 0 0; }\n
.profile-meta { font-family: var(--font-label); letter-spacing: .02em; font-size: .76rem; color: var(--mist-200); margin: 4px 0 0; opacity: .85; }\n
.profile-cover .profile-web { margin: 4px 0 0; }\n
.profile-cover .profile-web a { color: var(--gold-400); }\n
.profile-cover .profile-stats { display: flex; flex-wrap: wrap; gap: 22px; margin: 16px 0 0; }\n
.profile-cover .profile-stats dt { color: var(--mist-200); font-size: .64rem; font-family: var(--font-label); text-transform: uppercase; letter-spacing: .14em; }\n
.profile-cover .profile-stats dt a { color: var(--mist-200); }\n
.profile-cover .profile-stats dd { color: var(--parchment-50); font-family: var(--font-mono); font-size: 1.05rem; font-weight: var(--weight-medium); font-variant-numeric: tabular-nums; margin: 3px 0 0; }\n
.profile-aside { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }\n
.profile-cover-note { max-width: 26ch; margin: 0; font-size: .93rem; line-height: 1.5; text-align: right; overflow-wrap: anywhere; }\n
.profile-cover-note a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }\n
.profile-rep { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 10px 18px; background: var(--gold-100); border: 1px solid var(--gold-200); border-radius: var(--radius-lg); }\n
.profile-rep-value { display: inline-flex; align-items: baseline; gap: 6px; font-family: var(--font-mono); font-weight: var(--weight-medium); font-size: 1.35rem; line-height: 1; color: var(--ink-900); font-variant-numeric: tabular-nums; }\n
.profile-rep-value .star-marker { width: 15px; height: 15px; align-self: center; color: var(--star); margin: 0; }\n
.profile-rep-label { display: block; font-family: var(--font-label); text-transform: uppercase; letter-spacing: .16em; font-size: .62rem; color: var(--gold-800); margin-top: 2px; }\n
.profile-cover .profile-actions { margin: 0; justify-content: flex-end; align-items: stretch; color: var(--mist-200); }\n
.profile-actions > form { display: flex; }\n
.profile-actions > .btn { display: inline-flex; align-items: center; }\n
.profile-cover .profile-actions .linkbtn { color: var(--mist-200); }\n
/* The ··· trigger takes the twilight cover's ink; its own muted ink is drawn\n
   for a light panel and measures 2.2:1 here. Hover (sticky after a tap) keeps\n
   it too, over a chip of the same ink, not the panel's sunken chip. */\n
.profile-cover-action,\n
.profile-cover .dm-iconbtn {\n
    padding: 6px 13px; font-family: var(--font-label); font-size: .82rem; letter-spacing: .03em;\n
    border: 1.5px solid color-mix(in srgb, var(--mist-200) 34%, transparent);\n
    border-radius: var(--radius-md); background: transparent; color: var(--mist-200);\n
}\n
.profile-cover .dm-iconbtn { width: 32px; height: 100%; min-height: 32px; padding: 0; }\n
.profile-cover-action:hover,\n
.profile-cover .dm-iconbtn:hover { background: color-mix(in srgb, var(--parchment-50) 8%, transparent); color: var(--parchment-50); }\n
.profile-cover-action.btn-on { display: inline-flex; align-items: center; gap: 6px; }\n
.profile-cover-action.btn-on .icon { width: 13px; height: 13px; }\n
.profile-cover .profile-actions .btn-on { color: var(--on-brand-subtle); background: var(--brand-subtle); border-color: var(--green-200); }\n
/* Baseline, not centre: an open description grows the chip row, and the label\n
   belongs to the row's first line of chips rather than to its middle. */\n
.profile-badges { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; margin: 14px 0 0; }\n
.profile-badges-label { font-family: var(--font-label); text-transform: uppercase; letter-spacing: .16em; font-size: .62rem; color: var(--text-faint); margin: 0 4px 0 0; }\n
.profile-badges .badge-row { margin: 0; }\n
/* Marks of esteem use the supplied Imladris Commend Star, never seed emoji. */\n
.badge-chip { border: 1px solid var(--border-hair); border-radius: var(--radius-pill); background: var(--surface-raised); font-family: var(--font-label); font-size: .74rem; letter-spacing: .03em; color: var(--text-body); gap: 6px; padding: 4px 11px; }\n
.badge-chip .badge-star { width: 13px; height: 13px; color: var(--star); flex: 0 0 auto; }\n
.badge-chip.is-locked { background: transparent; border: 1px dashed var(--border-strong); color: var(--text-muted); }\n
.badge-row > li { min-width: 0; max-width: 100%; }\n
/* A block-level chip whose name sets its baseline: the label then sits on the\n
   chip's text, not on the star icon's lower edge, with no line box around it. */\n
.badge-info > summary { display: flex; width: fit-content; list-style: none; cursor: pointer; }\n
.badge-info .badge-name { align-self: baseline; }\n
.badge-info > summary::-webkit-details-marker { display: none; }\n
.badge-disclosure { width: 12px; height: 12px; flex: none; }\n
.badge-info[open] .badge-disclosure { transform: rotate(180deg); }\n
/* Width 0 with a 100% floor: the description wraps at its chip's width, so it\n
   never widens the list item and the neighbouring chips stay where they were. */\n
.badge-description { width: 0; min-width: 100%; margin: 8px 0 0; font-size: .93rem; line-height: 1.5; color: var(--text-muted); overflow-wrap: anywhere; }\n
\n
/* — Leaderboard: footnote card + headline top-3 reputation (§5.5) — */\n
.lb-top .lb-rep { font-size: 1.5rem; }\n
[data-theme="dark"] .lb-rank-roman { color: var(--gold-400); }\n
.lb-note {\n
    margin-top: 22px; padding: 14px 18px; background: var(--brand-subtle);\n
    border-left: 3px solid var(--rule-gold); border-radius: var(--radius-md);\n
    font-family: var(--font-body); font-style: italic; color: var(--text-muted);\n
    line-height: 1.55; max-width: 64ch;\n
}\n
/* — Leaderboard fidelity (Imladris UI kit: retroboards Leaderboard): the council\n
   eyebrow, top-3 identity cards with a "@handle · title" sub-line, and a smaller\n
   mono regard on the compact rows. Values from the design system's kit.css. — */\n
.board-header .eyebrow { display: block; margin: 0 0 4px; }\n
.lb-id { display: flex; flex-direction: column; min-width: 0; }\n
.lb-handle { font-family: var(--font-mono); font-size: .76rem; color: var(--text-muted); }\n
.lb-row-rep { margin-left: auto; font-family: var(--font-mono); color: var(--text-muted); font-variant-numeric: tabular-nums; display: inline-flex; align-items: center; gap: 5px; }\n
.lb-row-rep .star-marker { color: var(--star); }\n
.leaderboard-row:not(.lb-top) .monogram { width: 28px; height: 28px; font-size: .72rem; }\n
\n
/* — Settings: theme/density choice cards, switches, left-rail subnav (§5.6) — */\n
.choice-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 4px 0 6px; }\n
.choice-card { position: relative; display: block; border: 1.5px solid var(--border-soft); border-radius: var(--radius-lg); background: var(--surface-raised); padding: 12px 14px; cursor: pointer; transition: border-color var(--dur-fast) var(--ease-calm), box-shadow var(--dur-fast) var(--ease-calm); }\n
.choice-card:hover { border-color: var(--border-strong); }\n
.choice-card input { position: absolute; opacity: 0; width: 1px; height: 1px; }\n
.choice-card:has(input:checked) { border-color: var(--accent); background: var(--brand-subtle); box-shadow: inset 0 0 0 1px var(--accent); }\n
.choice-card:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }\n
.choice-card-title { display: block; font-family: var(--font-label); letter-spacing: .04em; font-size: .82rem; color: var(--text-strong); }\n
.choice-card-desc { display: block; font-size: .78rem; color: var(--text-muted); margin-top: 2px; }\n
.theme-swatch { display: flex; height: 30px; border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--border-hair); margin-bottom: 9px; }\n
.theme-swatch span { flex: 1; }\n
.theme-swatch .sw-accent { flex: 0 0 8px; }\n
.swatch-parchment .sw-bg { background: var(--parchment-100); } .swatch-parchment .sw-card { background: var(--parchment-50); } .swatch-parchment .sw-accent { background: var(--green-700); }\n
.swatch-twilight .sw-bg { background: var(--twilight-900); } .swatch-twilight .sw-card { background: var(--twilight-700); } .swatch-twilight .sw-accent { background: var(--green-500); }\n
.swatch-system .sw-bg { background: var(--parchment-100); } .swatch-system .sw-card { background: var(--twilight-800); } .swatch-system .sw-accent { background: var(--gold-500); }\n
.density-prev { display: flex; flex-direction: column; gap: 4px; margin-bottom: 9px; }\n
.density-prev span { height: 8px; border-radius: 3px; background: var(--surface-sunken); }\n
.density-prev.is-compact span { height: 4px; }\n
.switchline { display: flex; align-items: flex-start; gap: 11px; padding: 8px 0; cursor: pointer; }\n
.switch {\n
    appearance: none; -webkit-appearance: none; flex: 0 0 auto; position: relative;\n
    width: 38px; height: 22px; margin-top: 1px; border-radius: var(--radius-pill);\n
    background: var(--surface-sunken); border: 1px solid var(--border-strong); cursor: pointer;\n
    transition: background var(--dur-fast) var(--ease-calm), border-color var(--dur-fast) var(--ease-calm);\n
}\n
.switch::before {\n
    content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px;\n
    border-radius: 50%; background: var(--parchment-50); box-shadow: var(--shadow-xs);\n
    transition: transform var(--dur-fast) var(--ease-calm);\n
}\n
.switch:checked { background: var(--accent); border-color: var(--accent); }\n
.switch:checked::before { transform: translateX(16px); background: var(--accent-contrast); }\n
.switch:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n
.switch-text { font-size: .95rem; line-height: 1.4; }\n
@media (min-width: 720px) {\n
    .settings { display: grid; grid-template-columns: 232px minmax(0, 1fr); gap: 30px; align-items: start; }\n
    .settings > * { grid-column: 2; min-width: 0; }\n
    .settings > .settings-rail {\n
        grid-column: 1;\n
        grid-row: 1 / span 60;\n
        align-self: start;\n
        position: sticky;\n
        top: calc(var(--topbar-h) + 22px);\n
        width: 232px;\n
    }\n
}\n
\n
/* — Profile cover: stack on mobile — */\n
@media (max-width: 860px) {\n
    .profile-cover { grid-template-columns: auto minmax(0, 1fr); padding: 20px 18px; }\n
    .profile-avatar .monogram { width: 64px; height: 64px; font-size: 1.5rem; }\n
    .profile-aside { grid-column: 1 / -1; align-items: flex-start; margin-top: 12px; }\n
    .profile-rep { text-align: left; }\n
    /* The button is not at the screen edge. The row spans the aside and the\n
       pop opens from the row's start, under the actions that hold its\n
       trigger, so it stays inside the cover however few actions there are. */\n
    .profile-cover .profile-actions { position: relative; align-self: stretch; justify-content: flex-start; }\n
    .profile-cover .dm-menu { position: static; }\n
    .profile-cover .dm-menu-pop { left: 0; right: auto; width: min(260px, calc(100% - 8px)); }\n
    .profile-cover .dm-iconbtn { width: 44px; height: 44px; }\n
    /* 44px taps without taller boxes: the stat numbers keep one baseline. The\n
       guest's Log in link is the cover's only action for a guest, so it gets the\n
       same target. */\n
    .profile-cover .profile-stats dt a,\n
    .profile-cover .profile-web a,\n
    .profile-cover .profile-cover-note a { position: relative; }\n
    .profile-cover .profile-stats dt a::after,\n
    .profile-cover .profile-web a::after,\n
    .profile-cover .profile-cover-note a::after {\n
        content: "";\n
        position: absolute;\n
        inset: min(0px, calc((100% - 44px) / 2));\n
    }\n
}\n
\n
/* ══════════════════════════════════════════════════════════════════════════\n
   Imladris — Engineering-Handoff fidelity pass, part 2.\n
   Conversation header action bar, accepted-answer plate, participant stack,\n
   grouped (same-author) posts, reaction "name · count" chips, profile tabs,\n
   and the New-Topic modal. Visual-only + light markup hooks; strict CSP\n
   (classes, no inline); semantic tokens so the twilight register flips cleanly.\n
   ══════════════════════════════════════════════════════════════════════════ */\n
\n
/* — Topic status: the "Decision made" left rule + chip (handoff §10) — */\n
.thread-status-decision_made::before { background: var(--green-600); }\n
/* --on-brand-subtle, not the raw --green-800 it resolves to in the day register:\n
   the numbered greens never flip, so the literal painted dark-green ink on the\n
   twilight brand wash and the word vanished. Same colour in light, legible in\n
   both. Surfaced by the board row, where Decision is a pill in its own column. */\n
.chip-decision_made { color: var(--on-brand-subtle); background: var(--brand-subtle); border-color: var(--green-200); }\n
\n
/* — Reactions read "emoji · count"; the dot is the lapidary separator (§5.1) — */\n
.reaction-n::before { content: "· "; color: inherit; opacity: .7; }\n
/* The "·" separates a reaction's NAME from its count. Production reactions are raw\n
   emoji with no name (ReactionService::ALLOWED), so on a bare chip the separator has\n
   nothing to separate and reads as a stray dot — "👍 · 4". Dropped with the label.\n
   This rule has to live here, unlayered: the identical ::before ships inside\n
   @layer imladris.components, and a layered override would lose to app.css. */\n
.reaction-bare .reaction-n::before { content: none; }\n
\n
/* — Conversation header: one calm action bar instead of stacked raw links (§5.1) —\n
   The star is already a pill (.star-btn); the notify <select> and the\n
   clear-accepted / pin / lock controls join it on the same quiet line. */\n
.thread-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 9px; margin: 12px 0 0; }\n
.thread-actions form { margin: 0; display: inline-flex; align-items: center; gap: 6px; }\n
.thread-actions .linkbtn,\n
.thread-actions .subscribe-form select {\n
    font-family: var(--font-label); font-size: .78rem; letter-spacing: .03em;\n
    border: 1.5px solid var(--border-soft); border-radius: var(--radius-md);\n
    background: var(--surface-raised); color: var(--text-body); padding: 6px 12px;\n
}\n
.thread-actions .linkbtn:hover { border-color: var(--border-strong); background: var(--surface-sunken); text-decoration: none; }\n
.thread-actions .linkbtn.danger:hover { border-color: var(--rust); color: var(--rust); }\n
\n
/* — Participant avatar stack on the topic header (§5.1) — */\n
.thread-participants-label { display: block; font-family: var(--font-label); text-transform: uppercase; letter-spacing: .1em; font-size: .58rem; color: var(--text-faint); margin: 10px 0 5px; }\n
.thread-participants { display: inline-flex; align-items: center; margin: 0; padding: 0; list-style: none; }\n
.thread-participants .participant { display: inline-flex; margin-left: -8px; border-radius: 50%; box-shadow: 0 0 0 2px var(--surface-page); }\n
.thread-participants .participant:first-child { margin-left: 0; }\n
.thread-participants .monogram { width: 28px; height: 28px; font-size: .68rem; }\n
.participant-more {\n
    margin-left: 7px; font-family: var(--font-label); font-size: .72rem;\n
    letter-spacing: .03em; color: var(--text-muted);\n
}\n
\n
/* — Accepted answer: the green "plate" caption + gilt avatar (already set) (§5.1) — */\n
.accepted-flag {\n
    display: inline-flex; align-items: center; gap: 6px; margin: 0 0 8px;\n
    font-family: var(--font-label); text-transform: uppercase; letter-spacing: .09em;\n
    font-size: .64rem; color: var(--on-done);\n
}\n
.accepted-flag svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }\n
.accepted-flag .star-marker { color: var(--star); margin-left: 2px; }\n
\n
/* — Consecutive posts by one author drop the repeated avatar + name (§5.1).\n
   A 56px spacer keeps the body aligned under the author's earlier post. */\n
.post-avatar-spacer { flex: 0 0 56px; width: 56px; }\n
.post-grouped { margin-top: -4px; box-shadow: none; border-color: transparent; background: transparent; }\n
.post-grouped .post-head { margin-bottom: 2px; }\n
\n
/* — Conversation fidelity (Imladris UI kit: retroboards Conversation + forum Post).\n
   The post's identity column is a 56px gilt avatar over a "regard" plinth — the\n
   commends the author has earned. Values lifted verbatim from the design system's\n
   components.css. The plinth markup is masked-aware (suppressed for anon posts in\n
   templates/partials/post.php), so it never leaks a hidden author's reputation. */\n
.post-avatar { display: flex; flex-direction: column; align-items: center; gap: 3px; flex: 0 0 auto; width: 56px; }\n
.post-avatar > .monogram, .post-avatar > .avatar-wrap > .monogram { width: 56px; height: 56px; font-size: 1.25rem; }\n
.regard-block { display: flex; flex-direction: column; align-items: center; gap: 1px; margin-top: 8px; text-align: center; }\n
.regard-block .regard-n {\n
    font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: 1.1rem;\n
    color: var(--text-strong); font-variant-numeric: tabular-nums; line-height: 1;\n
    display: inline-flex; align-items: center; gap: 4px;\n
}\n
.regard-block .regard-n .star-marker { color: var(--star); font-size: .85rem; }\n
.regard-block .regard-label {\n
    font-family: var(--font-label); text-transform: uppercase; letter-spacing: .1em;\n
    font-size: .53rem; color: var(--text-faint);\n
}\n
/* The timestamp sits at the trailing edge of the post head (the kit's right-aligned time). */\n
.post-head .post-time { margin-left: auto; }\n
/* Guest join-bar: the ceremonial emphasis on the council's invitation. */\n
.joinbar em { font-style: italic; color: var(--text-strong); }\n
/* Breadcrumb back-trail: "‹ Inbox / #board" as one calm mono line. */\n
.breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; }\n
.breadcrumb a { color: var(--text-faint); text-decoration: none; }\n
.breadcrumb a:hover { color: var(--text-muted); }\n
.breadcrumb .breadcrumb-board .hash { color: var(--gold-ink); }\n
.breadcrumb-sep { color: var(--border-strong); }\n
\n
/* — Member profile: complete Imladris activity surface (§5.4) — */\n
.profile-rep-value { position: relative; }\n
.profile-moderator {\n
    display: flex; align-items: center; gap: 14px;\n
}\n
.profile-moderator-icon { flex: 0 0 auto; width: 16px; height: 16px; }\n
.profile-moderator-copy { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; gap: 4px 8px; font-size: .9rem; }\n
.profile-moderator-copy strong { font-family: var(--font-label); font-size: .76rem; letter-spacing: .04em; font-weight: var(--weight-semibold); }\n
.profile-moderator a { flex: 0 0 auto; font-family: var(--font-label); font-size: .76rem; letter-spacing: .04em; color: var(--on-info); }\n
\n
/* Profile controls use the shared system classes; hooks retain layout only. */\n
.profile-tabs { margin: 26px 0 0; }\n
.profile-tab { flex: 0 0 auto; }\n
/* Plain anchors get an unlayered accent color; these link components own ink. */\n
.profile :is(.text-tab, .segmented-item) { color: revert-layer; text-decoration: revert-layer; }\n
\n
.profile-overview,\n
.profile-list,\n
.profile-commends,\n
.profile-connections { padding-top: 26px; }\n
.profile-overview { display: flex; flex-wrap: wrap; gap: 30px; align-items: flex-start; }\n
.profile-overview-main { flex: 999 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }\n
/* Direct child only: this is the page's own section eyebrow. An unscoped\n
   descendant selector reaches into the bio and restyles a member's ## heading\n
   as chrome — user prose is never the page's furniture. */\n
.profile-overview-main > section > h2,\n
.profile-activity-heading > h2,\n
.profile-commend-list > h2,\n
.profile-overview-aside h2 {\n
    margin: 0 0 11px; font-family: var(--font-label); font-size: .68rem; letter-spacing: .16em;\n
    text-transform: uppercase; font-weight: var(--weight-regular); color: var(--text-faint);\n
}\n
/* Type comes from .formatted-content; the bio only states its own measure. */\n
.profile-bio .prose { max-width: 66ch; }\n
.profile-overview-aside {\n
    flex: 1 1 292px; min-width: 0; container: profile-details / inline-size;\n
}\n
.profile-details { display: grid; gap: 18px; }\n
/* The legacy unlayered .card otherwise overrides the system's edge and radius. */\n
.profile .card { background: revert-layer; border: revert-layer; border-radius: revert-layer; margin-bottom: 0; overflow: visible; }\n
.profile-overview-aside section + section { padding-top: 18px; border-top: 1px solid var(--border-hair); }\n
@container profile-details (min-width: 540px) {\n
    .profile-details { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }\n
    .profile-details > section:only-child { grid-column: 1 / -1; }\n
    .profile-details > section + section { padding: 0 0 0 24px; border-top: 0; border-left: 1px solid var(--border-hair); }\n
}\n
.profile-overview-aside h2 { margin-bottom: 10px; font-size: .64rem; }\n
.profile-custom-fields { display: flex; flex-direction: column; gap: 10px; margin: 0; }\n
.profile-custom-fields dt { font-family: var(--font-label); font-size: .68rem; letter-spacing: .06em; color: var(--text-faint); }\n
.profile-custom-fields dd { margin: 2px 0 0; font-size: .93rem; color: var(--text-body); overflow-wrap: anywhere; }\n
.profile-active-boards { list-style: none; display: flex; flex-direction: column; gap: 7px; margin: 0; padding: 0; }\n
.profile-active-boards li { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }\n
.profile-active-boards a { font-size: .93rem; color: var(--text-body); text-decoration: none; }\n
.profile-active-boards a::first-letter { color: var(--gold-ink); }\n
.profile-active-boards a:hover { color: var(--accent); }\n
.profile-active-boards span { font-family: var(--font-mono); font-size: .76rem; color: var(--text-faint); }\n
\n
.profile-rows,\n
.profile-commend-rows,\n
.profile-conn-grid { list-style: none; margin: 0; padding: 0; }\n
.profile-row { padding: 11px 0; border-bottom: 1px solid var(--border-hair); }\n
.profile-rows-lg .profile-row { display: flex; align-items: baseline; gap: 16px; padding: 13px 2px; }\n
.profile-row-body { flex: 1; min-width: 0; }\n
.profile-row-title { font-size: 1rem; line-height: 1.4; color: var(--text-strong); text-decoration: none; overflow-wrap: anywhere; }\n
.profile-rows-lg .profile-row-title { font-size: 1.02rem; line-height: 1.35; }\n
.profile-row-title:hover { color: var(--accent); }\n
.profile-row-excerpt { margin: 5px 0 0; font-size: .93rem; line-height: 1.5; color: var(--text-muted); text-wrap: pretty; overflow-wrap: anywhere; }\n
.profile-row-meta { display: flex; flex-wrap: wrap; gap: 12px; margin: 5px 0 0; font-family: var(--font-label); font-size: .72rem; letter-spacing: .03em; color: var(--text-faint); }\n
.profile-number,\n
.profile-row-meta time { font-family: var(--font-mono); font-variant-numeric: tabular-nums; letter-spacing: normal; }\n
.profile-row-commends { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-mono); font-size: .82rem; color: var(--text-muted); }\n
.profile-row-commends .star-marker,\n
.profile-commend-count .star-marker { flex: 0 0 auto; width: 13px; height: 13px; color: var(--star); }\n
\n
/* Recent activity: URL-backed filters and optional disclosure of each excerpt. */\n
.profile-activity-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; margin-bottom: 4px; }\n
.profile-activity-heading > h2 { margin: 0; }\n
/* Retired global inbox-tab styles would add a baseline and change pill sizing. */\n
.profile-activity .inbox-tabs { display: revert-layer; margin: 0; border: 0; }\n
.profile-activity .inbox-tab { padding: revert-layer; border: revert-layer; border-radius: revert-layer; }\n
.profile-activity-rows { list-style: none; margin: 0; padding: 0; }\n
.profile-activity-row { border-bottom: 1px solid var(--border-hair); }\n
.profile-activity-line { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 4px 0; }\n
.profile-activity-kind { flex: 0 0 44px; font-family: var(--font-label); font-size: .6rem; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-ink); }\n
.profile-activity-title { flex: 1 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: .98rem; line-height: 1.4; color: var(--text-strong); text-decoration: none; }\n
.profile-activity-title:hover { color: var(--accent); text-decoration: none; }\n
.profile-activity-line time { flex: none; font-family: var(--font-mono); font-size: .72rem; color: var(--text-faint); }\n
.profile-activity-toggle { display: none; flex: none; align-items: center; justify-content: center; width: 28px; height: 28px; padding: 0; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--text-faint); cursor: pointer; }\n
.has-js .profile-activity-toggle:not([hidden]) { display: inline-flex; }\n
.profile-activity-toggle:hover { background: var(--surface-sunken); color: var(--text-body); }\n
.profile-activity-detail { padding: 0 38px 12px 54px; animation: profile-detail-enter 160ms var(--ease-calm); }\n
.profile-activity-detail .profile-row-excerpt { margin-top: 0; }\n
.profile-activity-detail .profile-row-meta { margin-top: 6px; }\n
@keyframes profile-detail-enter { from { opacity: 0; transform: translateY(7px); } to { opacity: 1; transform: translateY(0); } }\n
@media (prefers-reduced-motion: reduce) { .profile-activity-detail { animation: none; } }\n
\n
.profile-list { padding-top: 22px; }\n
.profile-list-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin: 0 0 4px; }\n
.profile-search { flex: 1 1 240px; min-width: 0; max-width: 380px; }\n
/* Generic .input and its focus rule are unlayered; return these properties to\n
   Input pill + affix, including its inset focus ring, without copying values. */\n
.profile-search .input { padding: revert-layer; border-radius: revert-layer; background: revert-layer; }\n
.profile-search .input:focus { box-shadow: revert-layer; }\n
.profile-list-tools > .btn,\n
.profile-conn-search > .btn { flex: 0 0 auto; align-self: stretch; }\n
.profile-list-count { flex: 0 0 auto; font-family: var(--font-label); font-size: .74rem; letter-spacing: .04em; color: var(--text-faint); }\n
.profile-sort { margin-left: auto; }\n
.profile-pager { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 18px; }\n
.profile-pager-label { font-family: var(--font-label); font-size: .76rem; letter-spacing: .06em; color: var(--text-faint); }\n
\n
/* The empty-state frame. Dashed is the system's word for an absence ("dashed\n
   borders mean locked, empty, or archived"); the token and the radius are the\n
   CONTAINER's, not a control's — 1px --border-hair at 12px, per DESIGN.md\n
   "Cards and containers". --border-soft belongs to the control register, which\n
   DESIGN.md spends on a secondary button and on a field. Shared with\n
   .content-empty-state and .living-brief-empty, and with .org-empty at\n
   --radius-md, where a nested one-line note sits inside an --radius-lg card. */\n
.profile-panel-empty {\n
    padding: 44px 26px; text-align: center; color: var(--text-muted); background: var(--surface-raised);\n
    border: 1px dashed var(--border-hair); border-radius: var(--radius-lg);\n
}\n
.profile-panel-empty :is(h2, h3) { margin: 0; font-family: var(--font-display); font-size: 1.25rem; line-height: 1.25; font-weight: var(--weight-medium); color: var(--text-strong); }\n
.profile-panel-empty p { margin: 7px auto 0; max-width: 42ch; font-size: .95rem; line-height: 1.5; }\n
.profile-panel-empty .btn { margin-top: 16px; }\n
\n
.profile-commends { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 30px; align-items: start; }\n
/* Gold stays the star, the word, and the hairline. The field is the raised\n
   surface so the ink tokens flip with it; a gold wash does not, and twilight\n
   then paints dark gold-800 on a light gold-100. */\n
.profile-regard-card { padding: 24px; text-align: center; background: var(--surface-raised); border: 1px solid var(--gold-200); border-radius: var(--radius-lg); }\n
.profile-regard-value { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 2rem; color: var(--text-strong); }\n
.profile-regard-value .star-marker { width: 22px; height: 22px; color: var(--star); }\n
.profile-regard-label { margin: 4px 0 0; font-family: var(--font-label); font-size: .64rem; letter-spacing: .16em; text-transform: uppercase; color: var(--gold-ink); }\n
.profile-regard-note { margin: 14px 0 0; font-size: .93rem; line-height: 1.55; color: var(--text-muted); text-wrap: pretty; }\n
.profile-commend-rows li { display: flex; align-items: baseline; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--border-hair); }\n
.profile-commend-count { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 5px; min-width: 58px; font-family: var(--font-mono); font-size: .9rem; color: var(--gold-ink); }\n
.profile-commend-body { min-width: 0; }\n
.profile-commend-body a { font-size: 1rem; color: var(--text-strong); text-decoration: none; overflow-wrap: anywhere; }\n
.profile-commend-body a:hover { color: var(--accent); }\n
\n
.profile-connections { padding-top: 22px; }\n
.profile-conn-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin-bottom: 14px; }\n
.profile-conn-search { flex: 1 1 310px; min-width: 0; display: flex; align-items: center; gap: 8px; margin: 0; }\n
.profile-conn-search .profile-search { flex-basis: 220px; max-width: 300px; }\n
.profile-conn-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 10px; }\n
.profile-conn-card { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 12px 14px; background: var(--surface-raised); border: 1px solid var(--border-hair); border-radius: var(--radius-lg); }\n
.profile-conn-card > .monogram { flex: 0 0 auto; width: 38px; height: 38px; font-size: .82rem; }\n
.profile-conn-id { min-width: 0; flex: 1; }\n
.profile-conn-id > a { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .96rem; color: var(--text-strong); text-decoration: none; }\n
.profile-conn-id > a:hover { color: var(--accent); }\n
.profile-conn-meta { display: block; margin: 2px 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-label); font-size: .7rem; letter-spacing: .03em; color: var(--text-faint); }\n
.profile-conn-card .linkbtn { flex: 0 0 auto; padding: 5px 0; font-family: var(--font-label); font-size: .72rem; letter-spacing: .04em; }\n
\n
.profile-gated { max-width: 560px; padding-top: 60px; }\n
.profile-gated-card { padding: 40px 34px; text-align: center; }\n
.profile-gated-ic { width: 34px; height: 34px; color: var(--gold-ink); stroke-width: 1.4; }\n
.profile-gated-card h1 { margin: 15px 0 0; font-family: var(--font-display); font-size: 1.6rem; font-weight: var(--weight-medium); color: var(--text-strong); }\n
.profile-gated-card > p:not(.profile-gated-actions) { max-width: 44ch; margin: 9px auto 0; font-size: 1rem; line-height: 1.55; color: var(--text-muted); text-wrap: pretty; }\n
.profile-gated-actions { margin: 22px 0 0; }\n
.profile-gated-audience { white-space: nowrap; }\n
\n
@media (max-width: 860px) {\n
    .profile-commends { grid-template-columns: minmax(0, 1fr); }\n
    .profile-overview-aside { width: 100%; }\n
    .profile-cover-note { max-width: 100%; text-align: left; }\n
}\n
/* A clipped title's only other copy is its title tooltip, which a touch screen\n
   never shows. The query is a union: at 820px a tablet sets the details card\n
   beside the list and its titles clip, yet it matches only the pointer terms;\n
   a mouse keeps the one-line title above the 760px step. */\n
@media (max-width: 760px), (hover: none), (pointer: coarse) {\n
    .profile-activity-line { align-items: baseline; }\n
    .profile-activity-title { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }\n
    .profile-activity-toggle { align-self: flex-start; }\n
}\n
@media (max-width: 700px) {\n
    .profile-list-tools,\n
    .profile-conn-tools { align-items: stretch; flex-wrap: wrap; }\n
    .profile-list-tools .profile-search { min-width: min(100%, 260px); }\n
    .profile-list-count { align-self: center; }\n
    .profile-sort { margin-left: 0; }\n
    .profile-conn-search { min-width: 100%; }\n
    .profile-conn-search .profile-search { max-width: none; }\n
}\n
@media (max-width: 560px) {\n
    .profile { padding-bottom: 64px; }\n
    .profile-cover { gap: 14px; }\n
    .profile-name { font-size: 1.9rem; }\n
    .profile-moderator { align-items: flex-start; flex-wrap: wrap; }\n
    .profile-moderator-copy { flex-basis: calc(100% - 34px); }\n
    .profile-moderator a { margin-left: 30px; }\n
    .profile-rows-lg .profile-row { align-items: flex-start; }\n
    .profile-conn-grid { grid-template-columns: minmax(0, 1fr); }\n
    .profile-conn-card { flex-wrap: wrap; }\n
    .profile-conn-id { flex-basis: calc(100% - 50px); }\n
    .profile-conn-id > a,\n
    .profile-conn-meta { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }\n
    .profile-conn-card form { margin-left: 50px; }\n
    .profile-gated { padding-top: 28px; }\n
    .profile-gated-card { padding: 34px 22px; }\n
}\n
\n
/* — New-Topic disclosure becomes a centred modal once JS is present (§5.2).\n
   No-JS keeps the native <details> inline expand, so navigation never traps. */\n
.composer-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n
.composer-cancel { display: none; }\n
.has-js .composer-details[open]::before {\n
    content: ""; position: fixed; inset: 0; z-index: 80;\n
    background: var(--scrim); backdrop-filter: blur(2px);\n
}\n
.has-js .composer-details[open] > .composer {\n
    position: fixed; z-index: 81; top: 50%; left: 50%;\n
    transform: translate(-50%, -50%);\n
    width: min(640px, calc(100vw - 32px)); max-height: calc(100vh - 64px); overflow-y: auto;\n
    background: var(--surface-raised); border: 1px solid var(--border-strong);\n
    border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); padding: 22px 24px;\n
    animation: rb-rise var(--dur-base) var(--ease-calm);\n
}\n
.has-js .composer-details[open] > .composer:has(.composer-suggestion-popover:not([hidden]), .composer-emoji-dialog:not([hidden])) {\n
    overflow: visible;\n
}\n
.has-js .composer-details[open]:has(.composer-suggestion-popover:not([hidden]), .composer-emoji-dialog:not([hidden]))::before {\n
    backdrop-filter: none;\n
}\n
.has-js .composer-details[open] > .composer .composer-cancel { display: inline-flex; }\n
@keyframes rb-rise {\n
    from { opacity: 0; transform: translate(-50%, calc(-50% + 12px)) scale(.985); }\n
    to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }\n
}\n
@media (prefers-reduced-motion: reduce) {\n
    .has-js .composer-details[open] > .composer { animation: none; }\n
}\n
\n
/* ══════════════════════════════════════════════════════════════════════════\n
   Imladris Design System import — auth gate, settings console, admin desk.\n
   Translated from the attached design-system UI kits into the strict-CSP PHP app:\n
   server-rendered forms stay real; the imported layer supplies structure,\n
   lapidary form treatments, and operator-console density.\n
   ══════════════════════════════════════════════════════════════════════════ */\n
\n
/* — Auth gate: ceremonial twilight stage with parchment seal card. — */\n
/* The stage is twilight in both registers, so it paints from the --stage-*\n
   tokens, which do not flip; the seal card on it still does. */\n
.variant-auth {\n
    background: var(--stage-ground);\n
}\n
.variant-auth .skip-link:focus {\n
    color: var(--stage-ink);\n
    background: var(--stage-raised);\n
}\n
/* Focus on the stage takes the stage's gold: the page's --accent is evergreen\n
   by day and measured 1.75:1 here. Focus inside the card keeps --accent. */\n
.variant-auth .auth-brand:focus-visible,\n
.variant-auth .skip-link:focus-visible {\n
    outline-color: var(--stage-accent);\n
}\n
.auth-stage {\n
    min-height: 100vh;\n
    min-height: 100dvh;\n
    position: relative;\n
    overflow: hidden;\n
    background: var(--stage-ground);\n
    display: flex;\n
    flex-direction: column;\n
    align-items: center;\n
    justify-content: center;\n
    padding: 40px 20px;\n
    gap: 22px;\n
}\n
.auth-stage-star {\n
    position: absolute;\n
    top: 50%;\n
    left: 50%;\n
    width: 760px;\n
    height: 760px;\n
    transform: translate(-50%, -50%);\n
    color: var(--gold);\n
    opacity: .07;\n
    pointer-events: none;\n
}\n
.auth-stage > *:not(.auth-stage-star) {\n
    position: relative;\n
    z-index: 1;\n
}\n
.auth-brand {\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 12px;\n
    color: var(--stage-accent);\n
    text-decoration: none;\n
}\n
.auth-brand:hover {\n
    text-decoration: none;\n
}\n
.auth-brand-star {\n
    width: 30px;\n
    height: 30px;\n
    flex: 0 0 auto;\n
}\n
.auth-brand-name {\n
    font-family: var(--font-display);\n
    font-weight: var(--weight-medium);\n
    font-size: 1.7rem;\n
    color: var(--stage-ink);\n
    line-height: 1;\n
    letter-spacing: .005em;\n
}\n
/* The seal card. It carried a chamfered octagon plus a second, parallel\n
   octagon on a ::before at inset:5px — the "doubled gold rule". Both are gone\n
   (ADR 0033); the frame is one gold hairline on a 12px radius, and the card's\n
   lift off the twilight stage is still --shadow-xl rather than an outline,\n
   because .auth-stage clips (overflow: hidden at .auth-stage). */\n
.variant-auth .auth-card {\n
    position: relative;\n
    width: 100%;\n
    max-width: 432px;\n
    margin: 0;\n
    padding: 30px 30px 26px;\n
    border: 1.5px solid var(--stage-accent);\n
    border-radius: var(--radius-lg);\n
    background: var(--surface-raised);\n
    box-shadow: var(--shadow-xl);\n
}\n
.variant-auth .auth-card.wide {\n
    max-width: 520px;\n
}\n
.variant-auth .auth-card h1 {\n
    font-size: 1.75rem;\n
    margin: 0 0 4px;\n
    text-align: center;\n
}\n
.auth-eyebrow {\n
    display: block;\n
    text-align: center;\n
    font-family: var(--font-label);\n
    text-transform: uppercase;\n
    letter-spacing: var(--tracking-caps);\n
    font-size: .64rem;\n
    color: var(--gold-ink);\n
    margin-bottom: 8px;\n
}\n
.auth-lede {\n
    color: var(--text-muted);\n
    text-align: center;\n
    margin: 8px 0 18px;\n
    font-size: .96rem;\n
    line-height: 1.5;\n
}\n
.auth-form {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 13px;\n
}\n
.auth-form .field {\n
    display: block;\n
    margin-bottom: 0;\n
}\n
.auth-form .field > span:first-child {\n
    display: block;\n
    font-family: var(--font-label);\n
    letter-spacing: .02em;\n
    font-size: .8rem;\n
    color: var(--text-muted);\n
    margin-bottom: 5px;\n
}\n
.auth-form .btn {\n
    margin-top: 4px;\n
    width: 100%;\n
}\n
.auth-error {\n
    text-align: center;\n
    margin: 0 0 14px;\n
}\n
/* ── Engraved frames ──────────────────────────────────────────────────────\n
   These five frames used to cut their corners at 45°. The edge was a clip-path\n
   octagon whose outline could not be a border — a border follows the border\n
   BOX, so the clip sliced its runs into stubs — and was therefore drawn as\n
   eight background layers, four corner tiles plus four stretched edges, every\n
   one of them restated by every state.\n
\n
   The chamfer was retired on 2026-09-13 (ADR 0033). A radius needs no clip, so\n
   the edge is a real border again: a state changes one colour instead of ten\n
   declarations, the outer focus ring the clip-path silently ate is back, and\n
   the frames differ from the plain register only in ink. Geometry is kept in\n
   step with docs/design-system/imladris/components.css, which carries the same\n
   frames; these are the production copies that actually paint. */\n
/* `textarea.textarea-engraved` is type-qualified on purpose, and only here. The\n
   engraved frame used to be drawn with `clip-path` + `background-image`, which\n
   nothing else in this file sets, so a bare class selector was enough to win.\n
   A real border is not so lucky: `.composer-input, textarea.input` above reaches\n
   (0,1,1) and would outrank a bare `.textarea-engraved` at (0,1,0) — which is\n
   exactly what /appeals renders (`<textarea class="input textarea-engraved">`),\n
   so its appeal reasons would take --border-soft on --surface-raised while the\n
   engraved inputs beside them stayed gold. The qualified selector ties at\n
   (0,1,1) and wins on source order. The design system needs no such qualifier:\n
   it has no `textarea.input` rule, so its copy stays a bare class list. */\n
.input-engraved,\n
.textarea-engraved,\n
textarea.textarea-engraved {\n
    border: 1.5px solid var(--field-rule);\n
    border-radius: var(--radius-md);\n
    background-color: var(--surface-page);\n
    box-shadow: var(--shadow-inset);\n
}\n
/* The outer ring renders now. .input:focus above already supplies the accent\n
   outline and the gold halo, but it sets `box-shadow` alone — matching at the\n
   same (0,2,0), it would cost the well its inset depth for exactly as long as\n
   it is focused. So the halo is restated here on top of the inset, and the\n
   rule goes to --gold-500. Same reason the :user-invalid rule below restates\n
   it. */\n
.input-engraved:focus,\n
.textarea-engraved:focus {\n
    border-color: var(--gold-500);\n
    outline: 2px solid var(--accent);\n
    outline-offset: 1px;\n
    box-shadow: var(--shadow-inset), 0 0 0 3px var(--focus-ring);\n
}\n
\n
/* ── Client-side validity ─────────────────────────────────────────────────\n
   :user-invalid styles a control only AFTER the member has interacted with it\n
   — that is the whole difference from :invalid, which would paint every empty\n
   required field on first paint. The server's ValidationException -> 422\n
   re-render stays authoritative; this only stops the round-trip from being the\n
   FIRST feedback. Pure CSS, so the strict CSP is untouched and the no-JS path\n
   is unchanged. Deliberately no :user-valid success colour: green borders on\n
   every satisfied field would compete with the error signal.\n
\n
   These live below .input-engraved:focus because that rule matches at the same\n
   (0,2,0) specificity — source order is what settles a focused invalid field. */\n
.input:user-invalid,\n
.composer-input:user-invalid,\n
.row-input:user-invalid,\n
.input.is-invalid,\n
.composer-input.is-invalid,\n
.row-input.is-invalid,\n
.input[aria-invalid="true"],\n
.composer-input[aria-invalid="true"],\n
.row-input[aria-invalid="true"] {\n
    border-color: var(--danger);\n
}\n
/* .input-engraved carries a real border now, so the generic border-color rule\n
   above would very nearly do — but it does not restate box-shadow, and at the\n
   same (0,2,0) it would strip the well's inset depth. Restate both, and add\n
   the danger halo so the state survives a colour-blind read at a glance and\n
   so :user-invalid changes more than one property.\n
\n
   One rule covers the focused invalid field too: it sits below :focus, both\n
   match at (0,2,0), and source order settles it. */\n
.input-engraved:user-invalid,\n
.textarea-engraved:user-invalid,\n
.input-engraved.is-invalid,\n
.textarea-engraved.is-invalid,\n
.input-engraved[aria-invalid="true"],\n
.textarea-engraved[aria-invalid="true"] {\n
    border-color: var(--danger);\n
    box-shadow: var(--shadow-inset), 0 0 0 3px color-mix(in srgb, var(--danger) 22%, transparent);\n
}\n
/* Never colour alone. .field is <label class="field"><span>Label</span><input>,\n
   so :has() reaches the label text to carry a non-colour second indicator —\n
   which is also the only signal a screen reader gets for this client-side\n
   state, since there is no JS to mirror it into aria-invalid. */\n
.field:has(:user-invalid) > span:first-of-type::after {\n
    content: " — check this field";\n
    color: var(--danger);\n
    font-weight: 400;\n
}\n
.auth-links {\n
    margin: 16px 0 0;\n
    text-align: center;\n
}\n
.auth-links p {\n
    margin: 6px 0;\n
    color: var(--text-muted);\n
    font-size: .92rem;\n
}\n
/* Links inside muted/notice prose can miss the 3:1 link-vs-text contrast\n
   (WCAG 1.4.1 / axe link-in-text-block) when relying on color alone — one\n
   shared rule instead of per-surface patches, so the next muted-prose link\n
   ships compliant by default. The index's guest note is such prose. These\n
   links keep the page's link colour, --accent: `.auth-links a` once took\n
   --brand, a fill token that is green-500 by night and measured 2.86:1 on\n
   the twilight card. */\n
.auth-links a,\n
.callout a,\n
.muted a,\n
.empty a,\n
.directory-guest-note a {\n
    text-decoration: underline;\n
    text-underline-offset: 2px;\n
}\n
.oauth-buttons {\n
    margin: 18px 0 4px;\n
}\n
.oauth-sep {\n
    position: relative;\n
    text-align: center;\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    text-transform: uppercase;\n
    letter-spacing: .12em;\n
    font-size: .64rem;\n
    margin: 0 0 14px;\n
}\n
.oauth-sep::before,\n
.oauth-sep::after {\n
    content: "";\n
    position: absolute;\n
    top: 50%;\n
    width: 32%;\n
    height: 1px;\n
    background: var(--border-hair);\n
}\n
.oauth-sep::before {\n
    left: 0;\n
}\n
.oauth-sep::after {\n
    right: 0;\n
}\n
.oauth-row {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 9px;\n
}\n
.btn-oauth {\n
    display: flex;\n
    align-items: center;\n
    justify-content: center;\n
    gap: 9px;\n
    width: 100%;\n
    padding: 9px 14px;\n
    background: var(--surface-raised);\n
    color: var(--text-body);\n
    border: 1.5px solid var(--border-soft);\n
    border-radius: var(--radius-md);\n
    box-shadow: none;\n
}\n
.btn-oauth:hover {\n
    background: var(--surface-sunken);\n
    border-color: var(--border-strong);\n
}\n
.auth-emblem {\n
    display: flex;\n
    justify-content: center;\n
    margin-bottom: 6px;\n
    color: var(--success);\n
}\n
.auth-emblem.warn {\n
    color: var(--rust);\n
}\n
.auth-emblem svg {\n
    width: 46px;\n
    height: 46px;\n
    fill: none;\n
    stroke: currentColor;\n
    stroke-width: 1.8;\n
    stroke-linecap: round;\n
    stroke-linejoin: round;\n
}\n
/* — Settings: account console shell and lapidary form register. — */\n
.settings-screen {\n
    max-width: 1064px;\n
    margin: 0 auto;\n
    width: 100%;\n
    padding: 30px 28px 132px;\n
}\n
.settings-head {\n
    margin-bottom: 24px;\n
}\n
.settings-head .eyebrow {\n
    display: block;\n
    font-family: var(--font-label);\n
    font-size: .68rem;\n
    letter-spacing: .18em;\n
    text-transform: uppercase;\n
    color: var(--gold-ink);\n
}\n
.settings-head h1 {\n
    margin: 7px 0 0;\n
    font-family: var(--font-display);\n
    font-size: 2.4rem;\n
    font-weight: 500;\n
    line-height: 1.1;\n
    letter-spacing: -.01em;\n
    color: var(--text-strong);\n
}\n
.settings-head p {\n
    margin: 8px 0 0;\n
    max-width: 62ch;\n
    font-size: 1rem;\n
    line-height: 1.55;\n
    color: var(--text-muted);\n
    text-wrap: pretty;\n
}\n
.settings-pane {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 18px;\n
    min-width: 0;\n
}\n
.settings-pane .card,\n
.settings-pane .scribe-panel {\n
    margin: 0;\n
}\n
.settings-rail {\n
    display: flex;\n
    flex-direction: column;\n
    min-width: 0;\n
}\n
.settings-rail-group {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 2px;\n
}\n
.settings-rail-title {\n
    padding: 0 0 6px 12px;\n
    font-family: var(--font-label);\n
    font-size: .62rem;\n
    letter-spacing: .18em;\n
    text-transform: uppercase;\n
    color: var(--text-faint);\n
}\n
.settings-rail-group + .settings-rail-group .settings-rail-title {\n
    padding: 14px 0 6px 12px;\n
}\n
.settings-rail-link {\n
    display: flex;\n
    align-items: center;\n
    gap: 10px;\n
    width: 100%;\n
    padding: 8px 12px;\n
    border: 0;\n
    border-left: 2px solid transparent;\n
    border-radius: 0 var(--radius-md) var(--radius-md) 0;\n
    background: transparent;\n
    color: var(--text-muted);\n
    font-family: var(--font-label);\n
    font-size: .86rem;\n
    letter-spacing: .02em;\n
    line-height: 1.35;\n
    text-align: left;\n
    text-decoration: none;\n
}\n
.settings-rail-link:not(.is-active):hover, .settings-rail-link:not(.is-active):focus-visible {\n
    background: var(--surface-sunken);\n
    color: var(--text-body);\n
    text-decoration: none;\n
}\n
.settings-rail-link.is-active {\n
    border-left-color: var(--gold-500);\n
    border-radius: 0 var(--radius-md) var(--radius-md) 0;\n
    background: var(--brand-subtle);\n
    color: var(--on-brand-subtle);\n
}\n
.settings-rail .icon {\n
    flex: 0 0 auto;\n
    width: 15px;\n
    height: 15px;\n
    stroke-width: 1.7;\n
}\n
.settings-rail .subnav-action {\n
    display: flex;\n
    align-items: center;\n
    min-height: 38px;\n
    align-self: flex-start;\n
    margin: 14px 12px 0;\n
    font-family: var(--font-label);\n
    font-size: .78rem;\n
    color: var(--text-muted);\n
}\n
@media (max-width: 719px) {\n
    .settings-screen {\n
        padding: 20px 16px 56px;\n
    }\n
    .settings {\n
        display: grid;\n
        grid-template-columns: minmax(0, 1fr);\n
        gap: 18px;\n
        min-width: 0;\n
    }\n
    .settings > .settings-rail {\n
        position: static;\n
        top: auto;\n
        width: 100%;\n
        min-width: 0;\n
    }\n
    .settings-rail-group {\n
        display: flex;\n
        flex-direction: row;\n
        flex-wrap: wrap;\n
        gap: 2px;\n
        min-width: 0;\n
    }\n
    .settings-rail-title,\n
    .settings-rail-group + .settings-rail-group .settings-rail-title {\n
        flex: 0 0 100%;\n
        padding: 14px 0 6px 12px;\n
    }\n
    .settings-rail-group:first-child .settings-rail-title {\n
        padding-top: 0;\n
    }\n
    .settings-rail-link {\n
        flex: 1 1 150px;\n
        width: auto;\n
        min-width: 0;\n
        min-height: 44px;\n
    }\n
    .settings-rail .subnav-action {\n
        min-height: 44px;\n
    }\n
}\n
/* Native account navigation keeps the form within the initial phone viewport. */\n
.settings-mobile-nav { display: none; }\n
.session-agent-details { margin-top: 6px; color: var(--text-muted); font-size: .86rem; }\n
.session-agent-details summary { cursor: pointer; width: fit-content; }\n
.session-agent-details p { margin: 8px 0 0; overflow-wrap: anywhere; }\n
@media (max-width: 719px) {\n
    .settings > .settings-rail-desktop { display: none; }\n
    .settings-mobile-nav { display: block; min-width: 0; }\n
    .settings-mobile-nav > summary {\n
        min-height: 44px;\n
        padding: 10px 12px;\n
        border: 1px solid var(--border-hair);\n
        border-radius: var(--radius-md);\n
        color: var(--text-strong);\n
        font-family: var(--font-label);\n
        overflow-wrap: anywhere;\n
        cursor: pointer;\n
    }\n
    .settings-mobile-nav[open] > summary { margin-bottom: 14px; }\n
    .settings-rail-link span { overflow-wrap: anywhere; }\n
    .session-agent-details summary { min-height: 44px; padding-block: 10px; }\n
}\n
@media (max-width: 860px) and (scripting: none) {\n
    /* With no drawer script, every member page keeps the real board, folder and\n
       feed links in a bounded rail above the content (Member chrome block);\n
       account pages also make it focusable and start their long form at the top. */\n
    html:not(.has-js) [data-account-settings] .app-shell { align-content: start; }\n
}\n
.field-grid {\n
    display: grid;\n
    grid-template-columns: 1fr 1fr;\n
    gap: 14px;\n
    width: 100%;\n
}\n
/* The account panel. It carried a 14px chamfered octagon plus a second,\n
   parallel octagon on a ::before at inset:4.5px. Both are gone (ADR 0033): one\n
   gold hairline on a 12px radius. No box-shadow — DESIGN.md asks for a\n
   hairline before a shadow, and a panel at rest is not elevated. */\n
.scribe-panel {\n
    position: relative;\n
    padding: 22px 24px;\n
    border: 1.5px solid var(--gold-400);\n
    border-radius: var(--radius-lg);\n
    background-color: var(--surface-raised);\n
}\n
.scribe-panel-head {\n
    display: flex;\n
    align-items: center;\n
    gap: 11px;\n
    margin: 0 0 15px;\n
    font-family: var(--font-label);\n
    text-transform: uppercase;\n
    letter-spacing: .14em;\n
    font-size: .72rem;\n
    color: var(--gold-ink);\n
}\n
.scribe-panel-head::after {\n
    content: "";\n
    height: 1px;\n
    background: var(--gold-200);\n
    flex: 1;\n
}\n
.avatar-row {\n
    display: flex;\n
    align-items: center;\n
    gap: 16px;\n
}\n
.avatar-actions {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 7px;\n
    align-items: flex-start;\n
}\n
.field-row {\n
    display: flex;\n
    align-items: center;\n
    gap: 11px;\n
    padding: 10px 14px;\n
    border: 1px solid var(--gold-200);\n
    border-radius: var(--radius-md);\n
    background-color: var(--surface-page);\n
    box-shadow: var(--shadow-inset);\n
}\n
.field-row + .field-row {\n
    margin-top: 9px;\n
}\n
/* The rule gilds rather than thickens: the row holds a borderless .row-input\n
   with outline:none, so the row itself is the focus indicator — but a width\n
   change here would reflow its content on every focus. Colour plus the halo\n
   instead. */\n
.field-row:focus-within {\n
    border-color: var(--gold-500);\n
    box-shadow: var(--shadow-inset), 0 0 0 3px var(--focus-ring);\n
}\n
/* A dot, not a diamond. The rotated square went with the chamfer (ADR 0033):\n
   the register is gold ink now, and carries no angular geometry. */\n
.field-row .row-bullet {\n
    flex: 0 0 auto;\n
    width: 7px;\n
    height: 7px;\n
    background: var(--gold-500);\n
    border-radius: 50%;\n
}\n
.field-row .row-input {\n
    flex: 1;\n
    min-width: 0;\n
    border: 0;\n
    background: transparent;\n
    font: inherit;\n
    font-family: var(--font-body);\n
    color: var(--text);\n
    outline: none;\n
}\n
.field-row .row-input::placeholder {\n
    color: var(--text-faint);\n
}\n
.field-row .row-mark {\n
    flex: 0 0 auto;\n
    color: var(--gold-ink);\n
    display: inline-flex;\n
}\n
/* The lapidary toggle register — .gem-field/.gem-check/.toggle-stack and the\n
   four jewel tones — is deleted here (ADR 0033). Slice 16 unified every boolean\n
   on the design system's Switch and left these declarations behind with zero\n
   template consumers; ADR 0024's closeout recorded that as C-50 and deferred it.\n
   Nothing rendered them (AppImladrisFidelityTest asserts no pane emits a gem\n
   checkbox, account-console.spec.ts asserts the locator is empty), and the gem\n
   glyph was the last `clip-path: polygon` in this file.\n
\n
   The design system keeps its copy: `.gem-*` is still a documented component\n
   there with its own gallery card (components/forms/forms.card.html). This is a\n
   production deletion of dead CSS, not a retirement of the component — the same\n
   divergence the chamfer removal records in LOCAL_RECONCILIATION.md. */\n
\n
	/* — Admin console: the operator's own shell (ADMIN.md §9.2, ADR 0024). —\n
	   Two ranks of navigation, kept apart on purpose: the area tier is a pill row\n
	   (.admin-bar/.admin-tier ship from the design system via imladris.css), the\n
	   page's own sections are underline tabs, and the heading sits between them.\n
	   Everything here is the application's complement — the parts the design\n
	   screens carry as inline style attributes, which CSP forbids. */\n
.admin-bar-right {\n
    margin-left: auto;\n
    display: flex;\n
    /* The brand name yields space to controls, whose contents cannot shrink. */\n
    flex: 0 0 auto;\n
    align-items: center;\n
    gap: 12px;\n
    min-width: 0;\n
}\n
.admin-bar-right .admin-bar-mode { margin-left: 0; }\n
.admin-bar-star { flex: none; width: 24px; height: 24px; color: var(--accent); }\n
.admin-bar-logo { flex: none; display: block; max-height: 24px; width: auto; }\n
.admin-bar-brand { text-decoration: none; }\n
.admin-bar-brand:hover { text-decoration: none; }\n
.admin-bar-search .input-small { min-width: 0; width: clamp(120px, 18vw, 220px); }\n
.admin-bar-user {\n
    max-width: 220px;\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 7px;\n
    min-width: 0;\n
    color: var(--text-muted);\n
    text-decoration: none;\n
    font-family: var(--font-label);\n
    font-size: .78rem;\n
    letter-spacing: .02em;\n
}\n
.admin-bar-user:hover { color: var(--text-strong); text-decoration: none; }\n
.admin-bar-username { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n
.admin-bar-action-label { font-family: var(--font-label); font-size: .78rem; letter-spacing: .03em; }\n
@media (max-width: 900px) {\n
    .admin-bar-right { gap: 10px; }\n
    .admin-bar-search,\n
    .admin-bar-action-label,\n
    .admin-bar-username { display: none; }\n
}\n
/* Disabled areas keep the note the nav contract has always carried; it is read\n
   out but never occupies a line of its own in the pill row. */\n
.admin-tier-item.is-disabled,\n
.admin-area-item.is-disabled {\n
    color: var(--text-faint);\n
    cursor: default;\n
    opacity: .55;\n
}\n
.admin-tier-item.is-disabled .subnav-item-note,\n
.admin-area-item.is-disabled .subnav-item-note {\n
    position: absolute;\n
    width: 1px;\n
    height: 1px;\n
    padding: 0;\n
    margin: -1px;\n
    overflow: hidden;\n
    clip: rect(0, 0, 0, 0);\n
    white-space: nowrap;\n
    border: 0;\n
}\n
\n
/* The current area must be visible before a narrow-screen reader scrolls or\n
   opens anything. Native details keeps the same role/flag gates without JS. */\n
.admin-area-menu { display: none; }\n
@media (max-width: 860px) {\n
    .admin-bar > .admin-tier { display: none; }\n
    .admin-area-menu { display: block; position: relative; margin: 0 16px 9px; }\n
    .admin-area-menu > summary {\n
        display: flex;\n
        align-items: center;\n
        justify-content: space-between;\n
        gap: 12px;\n
        min-height: 44px;\n
        padding: 8px 12px;\n
        border: 1px solid var(--border-soft);\n
        border-radius: var(--radius-md);\n
        background: var(--brand-subtle);\n
        color: var(--on-brand-subtle);\n
        font-family: var(--font-label);\n
        font-size: .86rem;\n
        list-style: none;\n
        cursor: pointer;\n
    }\n
    .admin-area-menu > summary::-webkit-details-marker { display: none; }\n
    .admin-area-menu > summary .icon { flex: none; width: 16px; height: 16px; }\n
    .admin-area-menu[open] > summary .icon { transform: rotate(180deg); }\n
    .admin-area-menu > summary strong { margin-left: auto; font-weight: var(--weight-medium); }\n
    .admin-mobile-areas {\n
        position: absolute;\n
        z-index: 1;\n
        inset-inline: 0;\n
        top: calc(100% + 6px);\n
        display: grid;\n
        gap: 4px;\n
        max-height: 60vh;\n
        max-height: 60dvh;\n
        overflow-y: auto;\n
        padding: 6px;\n
        border: 1px solid var(--border-soft);\n
        border-radius: var(--radius-md);\n
        background: var(--surface-raised);\n
        box-shadow: var(--shadow-lg);\n
    }\n
    .admin-area-item {\n
        display: flex;\n
        align-items: center;\n
        min-height: 44px;\n
        padding: 8px 12px;\n
        border-radius: var(--radius-md);\n
        color: var(--text-muted);\n
        font-family: var(--font-label);\n
        font-size: .86rem;\n
        text-decoration: none;\n
    }\n
    a.admin-area-item:hover { color: var(--text-strong); background: var(--surface-sunken); text-decoration: none; }\n
    .admin-area-item.is-active { color: var(--on-brand-subtle); background: var(--brand-subtle); font-weight: var(--weight-medium); }\n
    .admin-area-menu > summary:focus-visible,\n
    .admin-area-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; box-shadow: 0 0 0 3px var(--focus-ring); }\n
}\n
\n
.admin-console {\n
    display: block;\n
    width: 100%;\n
    max-width: 1160px;\n
    margin: 0 auto;\n
    padding: 22px 28px 110px;\n
}\n
.admin-console[data-area="content"],\n
.admin-console[data-area="people"],\n
.admin-console[data-area="appearance"],\n
.admin-console[data-area="settings"] { max-width: 1100px; }\n
.admin-console[data-area="notifications"] { max-width: 1140px; }\n
.admin-title {\n
    margin: 0;\n
    font-family: var(--font-display);\n
    font-weight: 500;\n
    font-size: 2.1rem;\n
    line-height: 1.1;\n
    letter-spacing: -0.01em;\n
    color: var(--text-strong);\n
}\n
.admin-tabs {\n
    display: flex;\n
    flex-wrap: wrap;\n
    gap: 2px;\n
    margin: 16px 0 0;\n
    border-bottom: 1px solid var(--border-hair);\n
}\n
.admin-tab {\n
    padding: 9px 15px;\n
    margin-bottom: -1px;\n
    border: 0;\n
    border-bottom: 2px solid transparent;\n
    background: transparent;\n
    font-family: var(--font-label);\n
    font-size: .84rem;\n
    letter-spacing: .03em;\n
    color: var(--text-muted);\n
    text-decoration: none;\n
    cursor: pointer;\n
}\n
.admin-tab:hover { color: var(--text-strong); text-decoration: none; }\n
.admin-tab.is-active {\n
    border-bottom-color: var(--gold-500);\n
    color: var(--text-strong);\n
    cursor: default;\n
}\n
.admin-tab.is-disabled { color: var(--text-faint); cursor: default; }\n
.admin-tab.is-disabled .subnav-item-note {\n
    position: absolute;\n
    width: 1px;\n
    height: 1px;\n
    padding: 0;\n
    margin: -1px;\n
    overflow: hidden;\n
    clip: rect(0, 0, 0, 0);\n
    white-space: nowrap;\n
    border: 0;\n
}\n
/* A drill-in — a board, a role, a member record, a package, a confirmation —\n
   keeps its parent tab lit and never renders a second <h1>: the area already\n
   supplies one. It gets a back link and an <h2> instead. */\n
/* Theme safe mode is variant=plain and carries no console chrome (ADR 0024 C-21). */\n
.safe-mode-head { display: flex; align-items: center; gap: 12px; }\n
.admin-back {\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 5px;\n
    font-family: var(--font-label);\n
    font-size: .78rem;\n
    letter-spacing: .03em;\n
    color: var(--text-muted);\n
    text-decoration: none;\n
}\n
.admin-back:hover { color: var(--accent); text-decoration: none; }\n
.admin-back .icon { width: 13px; height: 13px; }\n
.admin-record-title {\n
    margin: 6px 0 0;\n
    font-family: var(--font-display);\n
    font-weight: 500;\n
    font-size: 1.9rem;\n
    line-height: 1.15;\n
    letter-spacing: -0.01em;\n
    color: var(--text-strong);\n
}\n
.admin-pane {\n
    width: 100%;\n
    max-width: 100%;\n
    min-width: 0;\n
    display: flex;\n
    flex-direction: column;\n
    gap: 22px;\n
    padding-top: 24px;\n
}\n
.admin-pane > * {\n
    min-width: 0;\n
    max-width: 100%;\n
}\n
.pane-intro {\n
    color: var(--text-muted);\n
    margin: 0 0 4px;\n
    max-width: 64ch;\n
}\n
.admin-dashboard-section {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 12px;\n
}\n
.section-heading-row {\n
    display: flex;\n
    align-items: flex-end;\n
    justify-content: space-between;\n
    gap: 16px;\n
}\n
.section-heading-row h2 {\n
    margin: 1px 0 0;\n
}\n
.status-legend {\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 7px;\n
    font-family: var(--font-label);\n
    font-size: .7rem;\n
    color: var(--text-muted);\n
}\n
.status-legend i {\n
    width: 7px;\n
    height: 7px;\n
    border-radius: 50%;\n
    background: var(--success);\n
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 15%, transparent);\n
}\n
.admin-dashboard-grid {\n
    display: grid;\n
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));\n
    gap: 12px;\n
}\n
.queue-card {\n
    position: relative;\n
    display: flex;\n
    flex-direction: column;\n
    gap: 8px;\n
    min-height: 168px;\n
    color: inherit;\n
    text-decoration: none;\n
    overflow: hidden;\n
}\n
.queue-card::before {\n
    content: "";\n
    position: absolute;\n
    inset: 0 auto 0 0;\n
    width: 3px;\n
    background: var(--success);\n
}\n
.queue-card.queue-status-attention::before { background: var(--rust); }\n
.queue-card.queue-status-unavailable::before { background: var(--text-faint); }\n
.queue-card:hover {\n
    text-decoration: none;\n
    border-color: var(--border-strong);\n
    box-shadow: var(--shadow-sm);\n
}\n
.queue-card.is-static {\n
    cursor: default;\n
}\n
.queue-card-head {\n
    font-family: var(--font-label);\n
    letter-spacing: .06em;\n
    text-transform: uppercase;\n
    font-size: .68rem;\n
    color: var(--text-muted);\n
}\n
.queue-card-count {\n
    font-family: var(--font-display);\n
    font-size: 2.1rem;\n
    line-height: 1;\n
    color: var(--text-strong);\n
}\n
.queue-card-detail {\n
    color: var(--text-muted);\n
    line-height: 1.4;\n
}\n
.queue-card-state {\n
    margin-top: auto;\n
    font-family: var(--font-label);\n
    font-size: .65rem;\n
    letter-spacing: .07em;\n
    text-transform: uppercase;\n
    color: var(--on-done);\n
}\n
.queue-status-attention .queue-card-state { color: var(--danger); }\n
.queue-status-unavailable .queue-card-state { color: var(--text-faint); }\n
.attention-panel {\n
    border-left: 3px solid var(--accent-2);\n
}\n
.attention-total {\n
    display: inline-flex;\n
    align-items: center;\n
    justify-content: center;\n
    min-width: 30px;\n
    height: 30px;\n
    border-radius: var(--radius-pill);\n
    background: var(--gold-soft);\n
    color: var(--gold-ink);\n
    font-family: var(--font-mono);\n
    font-size: .82rem;\n
}\n
.attention-list li {\n
    color: var(--text-body);\n
}\n
.activity-card-grid {\n
    display: grid;\n
    grid-template-columns: repeat(2, minmax(0, 1fr));\n
    gap: 12px;\n
}\n
.activity-card {\n
    display: flex;\n
    align-items: center;\n
    justify-content: space-between;\n
    gap: 20px;\n
    color: inherit;\n
    text-decoration: none;\n
}\n
.activity-card:hover {\n
    border-color: var(--border-strong);\n
    text-decoration: none;\n
}\n
.activity-card-copy {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 4px;\n
}\n
.activity-card-title {\n
    font-family: var(--font-label);\n
    color: var(--text-strong);\n
}\n
.activity-card-count {\n
    flex: 0 0 auto;\n
    font-family: var(--font-display);\n
    font-size: 2rem;\n
    line-height: 1;\n
    color: var(--text-strong);\n
}\n
.recent-activity-heading {\n
    margin-bottom: 14px;\n
}\n
.recent-activity-heading > a {\n
    font-family: var(--font-label);\n
    font-size: .76rem;\n
}\n
.activity-table-shell,\n
.member-directory-table-shell {\n
    position: relative;\n
    min-width: 0;\n
    max-width: 100%;\n
}\n
.table-scroll-cue {\n
    display: none;\n
}\n
/* Admin overview body adoption. Shared console chrome and primitives live\n
   above; these rules only compose the dashboard and audit routes. */\n
.admin-overview-dashboard,\n
.admin-overview-audit {\n
    gap: 0;\n
}\n
.admin-overview-dashboard .pane-intro {\n
    max-width: 66ch;\n
    margin: 0 0 26px;\n
    line-height: 1.55;\n
    text-wrap: pretty;\n
}\n
.admin-overview-dashboard .admin-dashboard-section {\n
    gap: 12px;\n
    margin-bottom: 30px;\n
}\n
.admin-overview-dashboard .eyebrow {\n
    color: var(--gold-ink);\n
    font-size: .64rem;\n
    letter-spacing: .16em;\n
}\n
.admin-overview-dashboard .admin-dashboard-section > h2 {\n
    margin: 4px 0 0;\n
    font-size: 1.5rem;\n
}\n
.admin-overview-dashboard .section-heading-row h2 {\n
    margin: 4px 0 0;\n
    font-size: 1.5rem;\n
}\n
.admin-overview-dashboard .attention-panel h2,\n
.admin-overview-dashboard .recent-activity-card h2 {\n
    font-size: 1.35rem;\n
}\n
.admin-overview-dashboard .status-legend {\n
    font-size: .72rem;\n
    letter-spacing: .06em;\n
    color: var(--text-faint);\n
}\n
.admin-overview-dashboard .status-legend i {\n
    background: var(--presence);\n
    box-shadow: none;\n
}\n
.admin-overview-dashboard .admin-dashboard-grid {\n
    grid-template-columns: repeat(4, minmax(0, 1fr));\n
    gap: 14px;\n
}\n
.admin-console .admin-overview-dashboard .queue-card {\n
    gap: 3px;\n
    min-height: 0;\n
    padding: 16px 17px 14px;\n
    border-radius: var(--radius-lg);\n
    box-shadow: var(--shadow-sm);\n
    overflow: hidden;\n
}\n
.admin-console .admin-overview-dashboard .queue-card:hover {\n
    border-color: var(--border-hair);\n
    box-shadow: var(--shadow-md);\n
}\n
.admin-console .admin-overview-dashboard .queue-card.is-static:hover {\n
    box-shadow: var(--shadow-sm);\n
}\n
.admin-overview-dashboard .queue-card-head {\n
    font-size: .74rem;\n
    letter-spacing: .05em;\n
    text-transform: none;\n
}\n
.admin-overview-dashboard .queue-card-count {\n
    font-family: var(--font-mono);\n
    font-size: 1.9rem;\n
    font-weight: 400;\n
    line-height: 1.1;\n
}\n
.admin-overview-dashboard .queue-card-detail {\n
    color: var(--text-faint);\n
    font-size: .84rem;\n
    line-height: 1.4;\n
    text-wrap: pretty;\n
}\n
.admin-overview-dashboard .queue-card-state {\n
    margin-top: 6px;\n
    font-size: .66rem;\n
    letter-spacing: .1em;\n
}\n
.admin-console .admin-overview-dashboard .attention-panel {\n
    margin-bottom: 30px;\n
    padding: 18px 20px;\n
