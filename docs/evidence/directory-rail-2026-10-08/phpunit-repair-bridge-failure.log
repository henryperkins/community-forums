.notification-row form { margin: 0; }
.notification-open { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; align-items: center; gap: 13px; width: 100%; min-height: 44px; padding: 14px 8px; border: 0; border-radius: var(--radius-md); background: none; color: var(--text-body); font: inherit; text-align: left; cursor: pointer; }
.notification-open:hover { background: var(--surface-sunken); }
.notification-open:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
.notification-icon { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border-hair); border-radius: 50%; color: var(--text-muted); background: var(--surface-sunken); }
.notification-icon svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.notification-body { position: relative; min-width: 0; padding-left: 14px; overflow-wrap: anywhere; }
.notification-message { color: var(--text-muted); line-height: 1.5; }
.notification-context { font-style: italic; }
.notification-row.is-unread .notification-message, .notification-row.is-unread .notification-context { color: var(--text-strong); }
.notification-row.is-unread .notification-icon { background: var(--brand-subtle); color: var(--brand); }
.notification-unread-dot { position: absolute; left: 0; top: .55em; display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--gold-ink); }
.notification-open time { color: var(--text-muted); font-family: var(--font-mono); font-size: .72rem; white-space: nowrap; }
@media (max-width: 600px) {
