    font-family: var(--font-label);\n
    font-size: .8rem;\n
    letter-spacing: .04em;\n
    box-shadow: none;\n
}\n
.admin-console .admin-roles .role-definition-footer > .btn,\n
.admin-console .admin-roles .role-assign-actions > .btn {\n
    padding: 9px 18px;\n
    border: 0;\n
    border-radius: var(--radius-md);\n
    background: var(--accent);\n
    color: var(--accent-contrast);\n
    font-family: var(--font-label);\n
    font-size: .8rem;\n
    letter-spacing: .04em;\n
    box-shadow: none;\n
}\n
.admin-console .admin-roles .role-create-footer > .btn:hover,\n
.admin-console .admin-roles .role-definition-footer > .btn:hover,\n
.admin-console .admin-roles .role-assign-actions > .btn:hover,\n
.admin-console .admin-roles .role-simulator-actions > .btn:hover {\n
