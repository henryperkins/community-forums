@media (max-width: 680px) {\n
    /* The condensed bar grows for the touch floor, so the topics header that\n
       sticks beneath it has to know the new height. */\n
    .board-view { --board-condensed-h: 52px; }\n
    .board-view.read-pad { max-width: none; }\n
    .board-view .board-identity { grid-template-columns: minmax(0, 1fr); padding: 18px 18px 16px; }\n
    .board-view .board-identity h1 { font-size: 2rem; }\n
    .board-view .board-identity-aside { align-items: flex-start; width: 100%; }\n
    /* Facts wrap and read left-to-right; the leading rule would otherwise hang\n
       off the start of the line with nothing to divide. */\n
    .board-view .board-identity-facts { flex-wrap: wrap; gap: 10px 0; }\n
    .board-view .board-identity-facts > div { text-align: left; }\n
    .board-view .board-identity-facts > div:first-child { padding-left: 0; border-left: 0; }\n
    .board-view .board-identity-facts dd { font-size: .95rem; }\n
    /* Follow shrinks to an outline chip on the slab; the FAB already carries New\n
       topic at this width, which puts the first topic back above the fold. */\n
    .board-view .board-identity-actions { width: auto; }\n
    .board-view .board-identity-actions form,\n
    .board-view .board-identity-actions .btn { flex: 1; }\n
    /* The shell's touch-target floor, not the desktop 36px — both follow states. */\n
    .board-view .board-identity-actions .btn { min-height: 44px; }\n
    /* :not(.btn-on) so Following keeps the shared on-state at this width: this\n
       rule ties .board-identity-actions .btn-on on specificity and would win on\n
       source order, silently making Followed look identical to not-followed. */\n
    .board-view .board-identity-actions .btn-secondary:not(.btn-on) {\n
        border-color: var(--green-100);\n
        background: transparent;\n
        color: #FAF6EC;\n
    }\n
    .board-view .board-identity-actions [data-open-topic-composer] { display: none; }\n
    /* The condensed bar survives at this width, so its duplicate takes the touch\n
       floor too; 46px cannot hold a 44px chip, so the bar grows to suit. */\n
    .board-view .board-identity-condensed { min-height: var(--board-condensed-h); }\n
    .board-view .board-identity-condensed .btn { min-height: 44px; }\n
    .board-view .board-identity-follow-note { text-align: left; }\n
    /* The row is 2-D here, so the header stops being a column ruler and becomes\n
       an ordinary stacked heading. */\n
    /* The list goes full-bleed at this width, so the header that rules it has\n
       to as well — otherwise rows scroll past its ends, 18px proud on each\n
       side, and the sticky bar stops reading as the list's own head. */\n
    .board-view .board-topics-heading {\n
        display: flex;\n
        align-items: flex-start;\n
        flex-direction: column;\n
        gap: 5px;\n
        margin-inline: -18px;\n
        padding-inline: 18px;\n
    }\n
    .board-view .board-topics-heading-main,\n
    .board-view .board-topics-heading-aside { width: 100%; justify-content: flex-start; }\n
    .board-view .board-topics-order { margin: 0; }\n
    /* Rows run edge to edge with their padding inside, so the whole band is the\n
       tap target and the divider reads as a list rather than a stack of cards. */\n
    .board-view .board-topics-list {\n
        margin-inline: -18px;   /* cancels .read-pad's 18px gutter at this width */\n
        border-top: 1px solid var(--border-hair);\n
    }\n
    /* Two rows. The gutter and the monogram span both; the title and the star\n
       share row 1 so the star stays level with the words it marks; status and\n
       activity take row 2, where there is room for a pill beside a timestamp.\n
       The ACTIVITY track is the content-sized one and the copy absorbs the\n
       leftover, not the other way round: human_datetime() always emits the full\n
       "Aug 8, 2026 at 14:32 UTC" with white-space: nowrap, so an auto copy track\n
       would take its max-content first and starve a minmax(0, 1fr) activity\n
       column to nothing — and the row's own overflow: hidden would delete the\n
       stamp rather than overflow the page. */\n
    .board-view .thread-row-board {\n
        grid-template-columns: 10px 32px minmax(0, 1fr) auto 18px;\n
        grid-template-areas:\n
            "gutter mono main   main     star"\n
            "gutter mono status activity activity";\n
        column-gap: 11px;\n
        row-gap: 4px;\n
        min-height: 68px;\n
        padding: 11px 18px;\n
    }\n
    .board-view .thread-row-board > .unread-slot { grid-area: gutter; align-self: start; margin-top: 5px; }\n
    .board-view .thread-row-board > .monogram { grid-area: mono; align-self: start; width: 32px; height: 32px; font-size: .6rem; }\n
    /* NOT display: contents here — the copy occupies one area and stacks inside\n
       it, so the title and the byline stay together above the second row. */\n
    .board-view .thread-row-board .thread-row-main { grid-area: main; display: block; }\n
    .board-view .thread-row-board .thread-row-status { grid-area: status; justify-content: flex-start; }\n
    .board-view .thread-row-board .thread-row-star { grid-area: star; align-self: start; }\n
    .board-view .thread-row-board .thread-meta { gap: 0 7px; font-size: .8rem; }\n
    .board-view .board-topics.is-flat .thread-row-board {\n
        grid-template-columns: 10px minmax(0, 1fr) auto 18px;\n
        grid-template-areas:\n
            "gutter main   main     star"\n
            "gutter status activity activity";\n
        min-height: 60px;\n
    }\n
    .board-view .thread-row-board:active { background: var(--surface-raised); }\n
    /* Replies and time sit side by side rather than stacked, so row 2 stays one\n
       line tall next to the pill. */\n
    .board-view .thread-row-activity {\n
        grid-area: activity;\n
        flex-direction: row;\n
        align-items: baseline;\n
        justify-content: flex-end;\n
        gap: 8px;\n
        text-align: right;\n
    }\n
    .board-view .thread-row-activity .thread-row-replies { font-size: .66rem; }\n
    .pagination-board { flex-wrap: wrap; }\n
}\n
\n
@media (max-width: 430px) {\n
    .sidebar .rail-route-detail { display: none; }\n
    .board-view .board-identity-actions { align-items: stretch; flex-direction: column; }\n
    .board-view .board-identity-actions form,\n
    .board-view .board-identity-actions .btn { width: 100%; }\n
}\n
\n
@media (max-width: 860px) {\n
    .board-index.read-main,\n
    .board-view.read-main { margin-inline: -14px; }\n
}\n
