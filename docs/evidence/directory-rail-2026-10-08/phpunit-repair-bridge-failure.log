    color: var(--danger);\n
    font-family: var(--font-label);\n
    font-size: .62rem;\n
    letter-spacing: .06em;\n
    text-transform: uppercase;\n
    white-space: nowrap;\n
}\n
.admin-console .admin-roles .role-capability-locked {\n
    margin-left: 6px;\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    font-size: .68rem;\n
    letter-spacing: .03em;\n
}\n
.admin-console .admin-roles .role-create-footer,\n
.admin-console .admin-roles .role-definition-footer {\n
    display: flex;\n
    align-items: flex-end;\n
    gap: 14px;\n
    margin-top: 18px;\n
}\n
.admin-console .admin-roles .role-reauth-field {\n
