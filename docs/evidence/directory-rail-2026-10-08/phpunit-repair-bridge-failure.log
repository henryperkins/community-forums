}\n
.admin-console .admin-role-record .role-assignment-action-cell {\n
    text-align: right;\n
}\n
.admin-console .admin-role-record .role-assignment-actions {\n
    display: flex;\n
    flex-wrap: wrap;\n
    align-items: center;\n
    justify-content: flex-end;\n
    gap: 7px;\n
}\n
.admin-console .admin-role-record .role-assignment-actions .linkbtn {\n
    padding: 4px 11px;\n
    border: 0;\n
    border-radius: var(--radius-md);\n
    color: var(--rust);\n
    font-family: var(--font-label);\n
    font-size: .72rem;\n
    letter-spacing: .04em;\n
}\n
.admin-console .admin-role-record .role-assignment-actions .linkbtn:hover {\n
    background: var(--surface-sunken);\n
}\n
.admin-console .admin-role-record .role-renew-form {\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 7px;\n
}\n
.admin-console .admin-role-record .role-renew-form .input {\n
    width: 148px;\n
    min-width: 0;\n
    padding: 6px 8px;\n
    border-color: var(--border-soft);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-page);\n
    font-family: var(--font-mono);\n
    font-size: .78rem;\n
}\n
.admin-console .admin-role-record .role-renew-form input[type="password"] {\n
    width: 112px;\n
}\n
.admin-console .admin-role-record .role-renew-form .btn {\n
    padding: 6px 11px;\n
    border: 1.5px solid var(--border-soft);\n
    border-radius: var(--radius-md);\n
    background: transparent;\n
    color: var(--text-body);\n
    font-family: var(--font-label);\n
    font-size: .72rem;\n
}\n
.admin-console .admin-role-record .role-assignments-card > h4 {\n
    margin: 22px 0 12px;\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    font-size: .68rem;\n
    font-weight: 400;\n
    letter-spacing: .16em;\n
    text-transform: uppercase;\n
}\n
.admin-console .admin-role-record .role-assign-form {\n
    display: grid;\n
    grid-template-columns: repeat(3, minmax(0, 1fr));\n
    gap: 14px 16px;\n
    align-items: end;\n
}\n
.admin-console .admin-role-record .role-assign-form > .field-error,\n
.admin-console .admin-role-record .role-time-format,\n
.admin-console .admin-role-record .role-assign-actions {\n
    grid-column: 1 / -1;\n
}\n
.admin-console .admin-role-record .role-mono-input,\n
.admin-console .admin-role-record .role-time-input {\n
    font-family: var(--font-mono);\n
    font-size: .88rem;\n
}\n
.admin-console .admin-role-record .role-time-input {\n
    font-size: .86rem;\n
}\n
.admin-console .admin-role-record .role-label-note {\n
    letter-spacing: .02em;\n
    text-transform: none;\n
}\n
.admin-console .admin-role-record .role-time-format {\n
    margin: -4px 0 0;\n
    color: var(--text-faint);\n
    font-size: .78rem;\n
}\n
.admin-console .admin-role-record .role-assign-actions {\n
    display: flex;\n
    align-items: center;\n
    gap: 14px;\n
}\n
\n
/* Permission simulator. */\n
.admin-console .admin-role-simulator .role-simulator-intro {\n
    max-width: 74ch;\n
    margin: 0 0 20px;\n
    color: var(--text-muted);\n
    font-size: 1rem;\n
    line-height: 1.55;\n
    text-wrap: pretty;\n
}\n
.admin-console .admin-role-simulator .role-simulator-intro code {\n
    color: var(--text-body);\n
    font-family: var(--font-mono);\n
    font-size: .88rem;\n
}\n
.admin-console .admin-role-simulator .role-simulator-form-card,\n
.admin-console .admin-role-simulator .role-simulator-result {\n
    padding: 20px 22px;\n
    box-shadow: var(--shadow-sm);\n
}\n
.admin-console .admin-role-simulator .role-simulator-form-card > h2 {\n
    margin-bottom: 16px;\n
}\n
.admin-console .admin-role-simulator .role-simulator-form {\n
    display: grid;\n
    grid-template-columns: repeat(2, minmax(0, 1fr));\n
    gap: 14px 18px;\n
    align-items: end;\n
}\n
.admin-console .admin-role-simulator .role-simulator-actions {\n
    grid-column: 1 / -1;\n
}\n
.admin-console .admin-role-simulator .role-simulator-error {\n
    margin-top: 16px;\n
    padding: 18px 20px;\n
    border-left: 3px solid var(--rust);\n
    box-shadow: none;\n
}\n
.admin-console .admin-role-simulator .role-simulator-error > h2 {\n
    margin: 0 0 6px;\n
    color: var(--text-strong);\n
    font-family: var(--font-display);\n
    font-size: 1.2rem;\n
    font-weight: 500;\n
}\n
.admin-console .admin-role-simulator .role-simulator-error > p {\n
    margin: 0;\n
    color: var(--danger);\n
    font-size: .93rem;\n
}\n
.admin-console .admin-role-simulator .role-simulator-result {\n
    margin-top: 16px;\n
}\n
.admin-console .admin-role-simulator .role-simulator-result > h2 {\n
    margin-bottom: 10px;\n
}\n
.admin-console .admin-role-simulator .role-simulator-verdict-row {\n
    display: flex;\n
    flex-wrap: wrap;\n
    align-items: baseline;\n
    gap: 8px;\n
    margin: 0;\n
    color: var(--text-body);\n
    font-size: 1rem;\n
    line-height: 1.5;\n
    text-wrap: pretty;\n
}\n
.admin-console .admin-role-simulator .role-simulator-verdict {\n
    padding: 2px 11px;\n
    border-radius: var(--radius-pill);\n
    font-family: var(--font-label);\n
    font-size: .74rem;\n
    letter-spacing: .1em;\n
    text-transform: uppercase;\n
}\n
.admin-console .admin-role-simulator .role-simulator-verdict-allowed {\n
    background: var(--surface-done);\n
    color: var(--on-done);\n
}\n
.admin-console .admin-role-simulator .role-simulator-verdict-denied {\n
    background: color-mix(in srgb, var(--rust) 12%, var(--surface-raised));\n
    color: var(--danger);\n
}\n
.admin-console .admin-role-simulator .role-simulator-verdict-row code {\n
    font-family: var(--font-mono);\n
    font-size: .86rem;\n
}\n
.admin-console .admin-role-simulator .role-simulator-facts {\n
    display: flex;\n
    flex-direction: column;\n
    gap: 6px;\n
    margin: 14px 0 0;\n
    padding: 0;\n
    list-style: none;\n
}\n
.admin-console .admin-role-simulator .role-simulator-facts li {\n
    color: var(--text-muted);\n
    font-size: .93rem;\n
}\n
.admin-console .admin-role-simulator .role-simulator-facts code {\n
    color: var(--text-body);\n
    font-family: var(--font-mono);\n
    font-size: .82rem;\n
}\n
@keyframes role-simulator-rise {\n
    from { opacity: 0; transform: translateY(6px); }\n
    to { opacity: 1; transform: none; }\n
}\n
@media (prefers-reduced-motion: no-preference) {\n
    .admin-console .admin-role-simulator .role-simulator-result {\n
        animation: role-simulator-rise 180ms var(--ease-calm) both;\n
    }\n
}\n
@media (max-width: 860px) {\n
    /* The console collapses to one column; the area tier scrolls horizontally\n
       (its own thin scrollbar is the honest signal that areas sit off-edge) and\n
       the section tabs wrap. No drawer, no focus trap, no JavaScript — the\n
       console nav behaves identically with scripting disabled.\n
       ADMIN.md §9.4, amended by ADR 0024. */\n
    /* Urgent actions have to work on a phone: 44px minimum target. */\n
    .admin-tier-item { min-height: 44px; display: inline-flex; align-items: center; padding: 8px 12px; }\n
    .admin-tab { min-height: 44px; display: inline-flex; align-items: center; }\n
    .admin-console { max-width: none; padding: 18px 16px 56px; }\n
    .admin-console[data-area] { max-width: none; }\n
    .admin-title { font-size: 1.65rem; }\n
    .settings-general-grid { grid-template-columns: minmax(0, 1fr); }\n
    .admin-console .admin-roles .role-table,\n
    .admin-console .admin-role-record .role-assignment-table {\n
        min-width: 760px;\n
    }\n
    .admin-console .admin-roles .role-definition-grid,\n
    .admin-console .admin-roles .role-capability-grid,\n
    .admin-console .admin-role-record .role-held-list,\n
    .admin-console .admin-role-record .role-assign-form,\n
    .admin-console .admin-role-simulator .role-simulator-form {\n
        grid-template-columns: minmax(0, 1fr);\n
    }\n
    .admin-console .admin-roles .role-create-footer,\n
    .admin-console .admin-roles .role-definition-footer,\n
    .admin-console .admin-role-record .role-clone-form {\n
        align-items: stretch;\n
        flex-direction: column;\n
    }\n
    .admin-console .admin-roles .role-reauth-field,\n
    .admin-console .admin-role-record .role-clone-form .role-reauth-field {\n
        flex-basis: auto;\n
        width: 100%;\n
    }\n
    .admin-console .admin-roles .role-create-footer > .btn,\n
    .admin-console .admin-roles .role-definition-footer > .btn,\n
    .admin-console .admin-role-record .role-clone-form > .btn,\n
    .admin-console .admin-role-record .role-assign-actions > .btn,\n
    .admin-console .admin-role-simulator .role-simulator-actions > .btn,\n
    .admin-console .admin-roles .role-row-action {\n
        align-items: center;\n
        justify-content: center;\n
        min-height: 44px;\n
    }\n
    .admin-console .admin-roles .role-capability-count {\n
        margin-left: 0;\n
    }\n
    .admin-console .admin-role-record .role-assignment-table {\n
        min-width: 940px;\n
    }\n
    .admin-console .admin-role-record .role-assignment-actions {\n
        flex-wrap: nowrap;\n
    }\n
    .admin-console .admin-role-record .role-assign-form > .field-error,\n
    .admin-console .admin-role-record .role-time-format,\n
    .admin-console .admin-role-record .role-assign-actions,\n
    .admin-console .admin-role-simulator .role-simulator-actions {\n
        grid-column: 1;\n
    }\n
    .admin-dashboard-grid,\n
    .admin-overview-dashboard .admin-dashboard-grid,\n
    .activity-card-grid {\n
        grid-template-columns: 1fr;\n
    }\n
    .queue-card { min-height: 142px; }\n
    .admin-overview-dashboard .queue-card { min-height: 0; }\n
    .admin-console .admin-overview-audit .filter-grid { grid-template-columns: 1fr; }\n
    .admin-overview-audit .filter-result-count {\n
        width: 100%;\n
        margin-left: 0;\n
    }\n
    .admin-overview-audit .filter-actions .btn,\n
    .admin-overview-audit .state-empty a {\n
        display: inline-flex;\n
        align-items: center;\n
        min-height: 44px;\n
    }\n
    .section-heading-row { align-items: center; }\n
    .recent-activity-heading {\n
        align-items: flex-start;\n
        flex-direction: column;\n
        gap: 7px;\n
    }\n
    .table-scroll-cue {\n
        display: flex;\n
        align-items: center;\n
        justify-content: flex-end;\n
        gap: 5px;\n
        min-height: 28px;\n
        margin: 0;\n
        padding-right: 2px;\n
        color: var(--text-muted);\n
        font-family: var(--font-label);\n
        font-size: .68rem;\n
        transition: opacity var(--dur-fast) var(--ease-calm);\n
    }\n
    .activity-table-shell::after,\n
    .member-directory-table-shell::after {\n
        content: "";\n
        position: absolute;\n
        z-index: 2;\n
        top: 28px;\n
        right: 0;\n
        bottom: 0;\n
        width: 34px;\n
        pointer-events: none;\n
        background: linear-gradient(90deg, transparent, var(--surface-raised));\n
        transition: opacity var(--dur-fast) var(--ease-calm);\n
    }\n
    .activity-table-shell.is-at-end::after,\n
    .activity-table-shell.is-unneeded::after,\n
    .member-directory-table-shell.is-at-end::after,\n
    .member-directory-table-shell.is-unneeded::after { opacity: 0; }\n
    .activity-table-shell.is-at-end .table-scroll-cue,\n
    .activity-table-shell.is-unneeded .table-scroll-cue,\n
    .member-directory-table-shell.is-at-end .table-scroll-cue,\n
    .member-directory-table-shell.is-unneeded .table-scroll-cue {\n
        opacity: 0;\n
        visibility: hidden;\n
    }\n
    .admin-console .check-grid,\n
    .admin-console .admin-split,\n
    .admin-console .admin-split--fixed {\n
        grid-template-columns: 1fr;\n
    }\n
    .admin-console .admin-content .content-category-card,\n
    .admin-console .admin-content .content-roster-card {\n
        overflow: hidden;\n
    }\n
    .admin-console .admin-content .admin-cat-head {\n
        align-items: stretch;\n
        flex-direction: column;\n
    }\n
    .admin-console .admin-content .content-category-rename {\n
        flex-basis: auto;\n
        width: 100%;\n
    }\n
    .admin-console .admin-content .admin-cat-actions {\n
        gap: 8px;\n
    }\n
    .admin-console .admin-content .content-icon-button-category,\n
    .admin-console .admin-content .content-icon-button-board {\n
        width: 44px;\n
        height: 44px;\n
    }\n
    .admin-console .admin-content .content-category-delete,\n
    .admin-console .admin-content .content-board-action {\n
        min-height: 44px;\n
    }\n
    .admin-console .admin-content .content-board-row,\n
    .admin-console .admin-content .content-roster-row {\n
        align-items: stretch;\n
        flex-direction: column;\n
    }\n
    .admin-console .admin-content .content-board-actions {\n
        flex-wrap: wrap;\n
    }\n
    .admin-console .admin-content .content-add-category-form,\n
    .admin-console .admin-content .content-roster-form {\n
        align-items: stretch;\n
        flex-direction: column;\n
    }\n
    .admin-console .admin-content .content-roster-form .input {\n
        flex: 0 0 auto;\n
        width: 100%;\n
        max-width: none;\n
        min-height: 44px;\n
    }\n
    .admin-console .admin-content .content-add-category-form .btn,\n
    .admin-console .admin-content .content-roster-form .btn {\n
        min-height: 44px;\n
    }\n
    .admin-console .admin-content .content-board-grid,\n
    .admin-console .admin-content .content-check-grid,\n
    .admin-console .admin-content .content-tag-create-grid {\n
        grid-template-columns: 1fr;\n
    }\n
    .admin-console .admin-content .content-tag-create-grid > .btn {\n
        min-height: 44px;\n
    }\n
    .admin-console .admin-content .content-tag-catalogue {\n
        overflow: hidden;\n
    }\n
    .admin-console .admin-content .content-tag-search {\n
        flex-basis: 100%;\n
        max-width: none;\n
    }\n
    .admin-console .admin-content .content-tag-sort-control,\n
    .admin-console .admin-content .content-tag-update .input,\n
    .admin-console .admin-content .content-tag-enabled,\n
    .admin-console .admin-content .content-tag-save,\n
    .admin-console .admin-content .content-tag-merge .input,\n
    .admin-console .admin-content .content-tag-merge .content-board-action {\n
        min-height: 44px;\n
    }\n
    .admin-console .admin-content .content-tag-update,\n
    .admin-console .admin-content .content-tag-merge {\n
        flex: 1 1 100%;\n
        width: 100%;\n
    }\n
    .admin-console .admin-content .content-tag-update .content-tag-name,\n
    .admin-console .admin-content .content-tag-update .content-tag-slug,\n
    .admin-console .admin-content .content-tag-update .content-tag-description,\n
    .admin-console .admin-content .content-tag-update .content-tag-visibility {\n
        flex: 1 1 100%;\n
        width: 100%;\n
    }\n
    .admin-console .admin-content .content-tag-merge .input {\n
        flex: 1 1 auto;\n
        max-width: none;\n
    }\n
    .admin-console .admin-content .content-tag-result-count {\n
        width: 100%;\n
        margin-left: 0;\n
    }\n
    .admin-console .admin-content .content-confirm-form .form-actions,\n
    .admin-console .admin-content .content-confirm-card > .form-actions {\n
        align-items: stretch;\n
        flex-direction: column;\n
    }\n
    .admin-console .admin-content .content-confirm-form .btn,\n
    .admin-console .admin-content .content-confirm-card > .form-actions .btn {\n
        display: inline-flex;\n
        align-items: center;\n
        justify-content: center;\n
        min-height: 44px;\n
    }\n
    .admin-console .pager {\n
        flex-wrap: wrap;\n
    }\n
    .admin-console .pager-control { min-height: 44px; }\n
}\n
@media (max-width: 520px) {\n
}\n
.stat-cards {\n
    list-style: none;\n
    display: grid;\n
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));\n
    gap: 10px;\n
    padding: 0;\n
    margin: 0;\n
}\n
.stat-card {\n
    background: var(--surface-sunken);\n
    border-radius: var(--radius-md);\n
    padding: 13px 15px;\n
}\n
.stat-num {\n
    display: block;\n
    font-family: var(--font-display);\n
    font-weight: var(--weight-semibold);\n
    font-size: 1.7rem;\n
    line-height: 1;\n
    color: var(--text-strong);\n
    font-variant-numeric: tabular-nums;\n
}\n
.stat-label {\n
    font-family: var(--font-label);\n
    text-transform: uppercase;\n
    letter-spacing: .08em;\n
    font-size: .62rem;\n
    color: var(--text-muted);\n
}\n
.state {\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 6px;\n
    font-family: var(--font-label);\n
    letter-spacing: .02em;\n
    font-size: .78rem;\n
}\n
.state::before {\n
    content: "";\n
    width: 7px;\n
    height: 7px;\n
    border-radius: 50%;\n
    background: var(--ink-300);\n
    flex: 0 0 auto;\n
}\n
.state-active::before,\n
.state-sent::before,\n
.state-done::before {\n
    background: var(--leaf);\n
}\n
.state-paused::before,\n
.state-queued::before,\n
.state-pending::before,\n
.state-suspended::before,\n
.state-review::before {\n
    background: var(--amber);\n
}\n
.state-danger::before,\n
.state-revoked::before,\n
.state-failed::before,\n
.state-bounced::before,\n
.state-complained::before,\n
.state-banned::before,\n
.state-deactivated::before {\n
    background: var(--rust);\n
}\n
/* The console's one status pill. A lifecycle word keys its tone (state-active,\n
   state-revoked); a label that is not a lifecycle word names the tone it wants\n
   (state-done, state-review, state-danger, state-muted, state-staff). The\n
   feature, package, invitation and override pills were copies of this rule\n
   under four names. Every tone is a flipping semantic pair: the design's\n
   fixed-ramp inks for the install chip (C-49) and the override chip (C-45)\n
   measured 1.10:1 and 3.55:1 in one register or the other. */\n
.admin-console .state {\n
    gap: 0;\n
    padding: 1px 9px;\n
    border-radius: var(--radius-pill);\n
    background: var(--surface-pending);\n
    color: var(--on-pending);\n
    font-size: .66rem;\n
    letter-spacing: .06em;\n
    white-space: nowrap;\n
}\n
.admin-console .state::before {\n
    display: none;\n
}\n
.admin-console .state-active,\n
.admin-console .state-sent,\n
.admin-console .state-done {\n
    background: var(--surface-done);\n
    color: var(--on-done);\n
}\n
.admin-console .state-queued,\n
.admin-console .state-pending,\n
.admin-console .state-paused,\n
.admin-console .state-suspended,\n
.admin-console .state-scheduled,\n
.admin-console .state-review {\n
    background: var(--surface-review);\n
    color: var(--on-review);\n
}\n
.admin-console .state-revoked,\n
.admin-console .state-failed,\n
.admin-console .state-bounced,\n
.admin-console .state-complained,\n
.admin-console .state-banned,\n
.admin-console .state-deactivated,\n
.admin-console .state-expired,\n
.admin-console .state-danger {\n
    background: color-mix(in srgb, var(--rust) 12%, var(--surface-raised));\n
    color: var(--danger);\n
}\n
.admin-console .state-muted {\n
    background: var(--surface-sunken);\n
    color: var(--text-muted);\n
}\n
.admin-console .state-staff {\n
    background: var(--surface-staff);\n
    color: var(--on-staff);\n
}\n
/* Role chips for the admin roster + user record: Marcellus uppercase pill,\n
   gilt for admin, evergreen for moderator, muted for plain members. */\n
.role-pill {\n
    display: inline-block;\n
    font-family: var(--font-label);\n
    text-transform: uppercase;\n
    letter-spacing: .08em;\n
    font-size: .62rem;\n
    padding: 2px 8px;\n
    border-radius: var(--radius-pill);\n
    background: var(--surface-sunken);\n
    color: var(--text-muted);\n
    border: 1px solid var(--border-hair);\n
}\n
.role-admin { color: var(--gold-700); background: var(--gold-100); border-color: var(--gold-200); }\n
.role-moderator { color: var(--green-800); background: var(--brand-subtle); border-color: var(--green-200); }\n
/* — Admin appearance: AdminAppearance.dc.html body adoption (Slice 8). — */\n
.admin-console .admin-appearance > .pane-intro {\n
    margin: 0;\n
    max-width: 68ch;\n
    font-size: 1rem;\n
    line-height: 1.55;\n
    text-wrap: pretty;\n
}\n
.admin-console .admin-appearance-branding .brand-cols {\n
    display: grid;\n
    grid-template-columns: minmax(0, 1fr) 380px;\n
    gap: 28px;\n
    align-items: start;\n
    margin: 0;\n
}\n
.branding-form-card {\n
    min-width: 0;\n
    padding: 20px 22px;\n
    background: var(--surface-raised);\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    box-shadow: var(--shadow-sm);\n
}\n
.branding-field-grid {\n
    display: grid;\n
    grid-template-columns: repeat(2, minmax(0, 1fr));\n
    gap: 14px 18px;\n
}\n
.branding-field {\n
    min-width: 0;\n
}\n
.branding-field-wide {\n
    grid-column: 1 / -1;\n
}\n
.branding-field > label,\n
.branding-css-label,\n
.branding-reset-card > label {\n
    display: block;\n
    margin: 0 0 5px;\n
    font-family: var(--font-label);\n
    font-size: .68rem;\n
    font-weight: 400;\n
    letter-spacing: .1em;\n
    text-transform: uppercase;\n
    color: var(--text-faint);\n
}\n
.branding-field .input,\n
.branding-reset-input {\n
    padding: 8px 11px;\n
    border-color: var(--border-soft);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-page);\n
    color: var(--text-body);\n
    font-family: var(--font-body);\n
    font-size: .92rem;\n
}\n
.branding-field .branding-hex-input,\n
.branding-reset-input {\n
    font-family: var(--font-mono);\n
    font-size: .88rem;\n
}\n
.branding-reset-input {\n
    letter-spacing: .1em;\n
}\n
.branding-section-label {\n
    margin: 22px 0 12px;\n
    font-family: var(--font-label);\n
    font-size: .68rem;\n
    font-weight: 400;\n
    letter-spacing: .16em;\n
    text-transform: uppercase;\n
    color: var(--text-faint);\n
}\n
.branding-marks {\n
    display: grid;\n
    grid-template-columns: repeat(2, minmax(0, 1fr));\n
    gap: 12px 18px;\n
}\n
.branding-mark-field {\n
    display: flex;\n
    align-items: center;\n
    justify-content: space-between;\n
    gap: 10px;\n
    min-width: 0;\n
    padding: 10px 12px;\n
    border: 1px dashed var(--border-soft);\n
    border-radius: var(--radius-md);\n
    color: var(--text-body);\n
    font-size: .9rem;\n
}\n
.branding-mark-field > span:first-child {\n
    min-width: 0;\n
}\n
.branding-current {\n
    font-family: var(--font-label);\n
    font-size: .7rem;\n
    letter-spacing: .04em;\n
    color: var(--text-faint);\n
}\n
.branding-file-control {\n
    position: relative;\n
    flex: 0 0 auto;\n
    display: inline-flex;\n
    border-radius: var(--radius-md);\n
}\n
.branding-mark-action {\n
    display: inline-block;\n
    padding: 5px 12px;\n
    border: 1.5px solid var(--border-soft);\n
    border-radius: var(--radius-md);\n
    background: transparent;\n
    color: var(--text-muted);\n
    font-family: var(--font-label);\n
    font-size: .72rem;\n
    letter-spacing: .04em;\n
    line-height: 1.35;\n
    cursor: pointer;\n
}\n
.branding-file-control:hover .branding-mark-action {\n
    background: var(--surface-sunken);\n
    color: var(--text-body);\n
}\n
.branding-file-control:focus-within {\n
    outline: 3px solid var(--focus-ring);\n
    outline-offset: 2px;\n
}\n
.branding-file-control input[type="file"] {\n
    position: absolute;\n
    inset: 0;\n
    width: 100%;\n
    height: 100%;\n
    margin: 0;\n
    opacity: 0;\n
    cursor: pointer;\n
}\n
.branding-checkline {\n
    display: flex;\n
    align-items: center;\n
    gap: 9px;\n
    margin: 0 0 10px;\n
    color: var(--text-body);\n
    font-size: .92rem;\n
    cursor: pointer;\n
}\n
.branding-checkline input {\n
    flex: 0 0 auto;\n
    width: 15px;\n
    height: 15px;\n
    accent-color: var(--accent);\n
}\n
.branding-custom-css:has(input[name="custom_css_enabled"]:not(:checked)) .branding-custom-css-fields {\n
    display: none;\n
}\n
.branding-custom-css-fields .code-area {\n
    width: 100%;\n
    padding: 10px 12px;\n
    border-color: var(--border-soft);\n
    border-radius: var(--radius-md);\n
    background: var(--surface-page);\n
    color: var(--text-body);\n
    font-family: var(--font-mono);\n
    font-size: .82rem;\n
    line-height: 1.6;\n
    resize: vertical;\n
}\n
.branding-css-ack {\n
    align-items: flex-start;\n
    margin: 10px 0 0;\n
    font-size: .9rem;\n
    line-height: 1.45;\n
}\n
.branding-css-ack input {\n
    margin-top: 3px;\n
}\n
.admin-console .branding-css-unavailable {\n
    margin: 0;\n
}\n
.branding-save-row {\n
    display: flex;\n
    align-items: center;\n
    gap: 14px;\n
    margin-top: 20px;\n
}\n
.admin-console .branding-primary-button {\n
    padding: 9px 20px;\n
    border: 0;\n
    box-shadow: none;\n
    font-size: .8rem;\n
    letter-spacing: .04em;\n
}\n
.admin-console .branding-primary-button:hover {\n
    filter: brightness(1.08);\n
}\n
.branding-status {\n
    font-family: var(--font-label);\n
    font-size: .76rem;\n
    letter-spacing: .04em;\n
    color: var(--on-done);\n
}\n
.branding-status.callout-review {\n
    margin: 0;\n
    color: var(--on-review);\n
}\n
.branding-error {\n
    color: var(--danger);\n
    font-size: .87rem;\n
}\n
.admin-console .admin-appearance-branding .brand-preview {\n
    position: sticky;\n
    top: 84px;\n
    display: flex;\n
    flex-direction: column;\n
    gap: 18px;\n
    margin: 0;\n
    --preview-accent: var(--accent);\n
    --preview-accent-contrast: var(--accent-contrast);\n
    --preview-accent-2: var(--accent-2);\n
    --preview-accent-2-contrast: var(--brand-accent-contrast, var(--ink-900));\n
}\n
.brand-preview-panel > .eyebrow {\n
    margin: 0 0 9px;\n
    font-family: var(--font-label);\n
    font-size: .64rem;\n
    letter-spacing: .16em;\n
    text-transform: uppercase;\n
    color: var(--gold-ink);\n
}\n
.brand-preview-shell {\n
    border: 1px solid var(--border-hair);\n
    border-radius: var(--radius-lg);\n
    overflow: hidden;\n
    box-shadow: var(--shadow-sm);\n
}\n
/* Paints from the preview custom properties, never from a static token: with JS\n
   they carry the values being typed, and without JS they fall back through\n
   .brand-preview to --accent, which /brand.css overrides with the saved colour. */\n
.brand-preview-bar {\n
    display: flex;\n
    align-items: center;\n
    justify-content: space-between;\n
    gap: 12px;\n
    padding: 11px 14px;\n
    background: var(--preview-accent);\n
    color: var(--preview-accent-contrast);\n
}\n
.brand-preview-bar strong {\n
    font-family: var(--font-display);\n
    font-size: 1.05rem;\n
    font-weight: 600;\n
}\n
.brand-preview-bar span {\n
    font-family: var(--font-label);\n
    font-size: .68rem;\n
    letter-spacing: .1em;\n
    text-transform: uppercase;\n
    color: color-mix(in srgb, var(--preview-accent-contrast) 85%, var(--preview-accent));\n
}\n
.brand-preview-body {\n
    display: flex;\n
    flex-direction: column;\n
    align-items: flex-start;\n
    gap: 12px;\n
    padding: 16px 14px;\n
    background: var(--surface-raised);\n
}\n
.brand-preview-body a {\n
    color: var(--preview-accent);\n
    font-size: .95rem;\n
}\n
.admin-console .brand-preview-body .btn {\n
    align-self: flex-start;\n
    padding: 7px 16px;\n
    border: 0;\n
    box-shadow: none;\n
    font-size: .78rem;\n
    letter-spacing: .04em;\n
    background: var(--preview-accent);\n
    color: var(--preview-accent-contrast);\n
}\n
.brand-preview-accent {\n
    align-self: flex-start;\n
    padding: 3px 11px;\n
    border: 0;\n
    border-radius: var(--radius-pill);\n
    background: var(--preview-accent-2);\n
    color: var(--preview-accent-2-contrast);\n
    font-family: var(--font-label);\n
    font-size: .72rem;\n
    letter-spacing: .04em;\n
}\n
.brand-preview-note {\n
    margin: 10px 0 0;\n
    color: var(--text-faint);\n
    font-size: .84rem;\n
    line-height: 1.5;\n
    text-wrap: pretty;\n
}\n
.branding-reset-card {\n
    padding: 16px 18px;\n
    background: var(--surface-raised);\n
    border: 1px solid var(--border-hair);\n
    border-left: 3px solid var(--rust);\n
    border-radius: var(--radius-lg);\n
}\n
.branding-reset-card > h2 {\n
    margin: 0 0 6px;\n
    font-size: 1.15rem;\n
}\n
.branding-reset-card > p:not(.field-error):not(.branding-reset-status) {\n
    margin: 0 0 12px;\n
    color: var(--text-muted);\n
    font-size: .87rem;\n
    line-height: 1.5;\n
    text-wrap: pretty;\n
}\n
.admin-console .branding-reset-button {\n
    margin-top: 12px;\n
    padding: 8px 16px;\n
    border: 0;\n
    background: var(--rust);\n
    color: var(--parchment-50);\n
    box-shadow: none;\n
    font-size: .78rem;\n
    letter-spacing: .04em;\n
}\n
.admin-console .branding-reset-button:hover {\n
    background: var(--rust);\n
    filter: brightness(1.08);\n
}\n
.branding-reset-status {\n
    margin: 10px 0 0;\n
    color: var(--on-done);\n
    font-size: .87rem;\n
}\n
.code-area {\n
    font-family: var(--font-mono);\n
    font-size: .85rem;\n
}\n
\n
.admin-console .admin-appearance-themes {\n
    gap: 16px;\n
}\n
.admin-console .admin-appearance-themes > .pane-intro {\n
    margin-bottom: 6px;\n
}\n
.admin-console .admin-appearance-themes > .card {\n
    margin: 0;\n
    padding: 16px 20px;\n
    box-shadow: none;\n
}\n
.admin-console .admin-appearance-themes > .card > h2 {\n
    margin: 0 0 8px;\n
    font-size: 1.25rem;\n
}\n
.admin-console .admin-appearance-themes .theme-safe-mode-card .theme-card-row h2 {\n
    margin: 0;\n
    font-size: 1.25rem;\n
}\n
.admin-console .admin-appearance-themes > .theme-packages-card > h2 {\n
    margin-bottom: 12px;\n
}\n
.theme-card-row {\n
    display: flex;\n
    align-items: center;\n
    gap: 14px;\n
}\n
.theme-card-row > :first-child {\n
    flex: 1;\n
    min-width: 0;\n
}\n
.theme-card-row p {\n
    margin: 0;\n
    font-size: .95rem;\n
}\n
.theme-card-action {\n
    flex: 0 0 auto;\n
}\n
.theme-safe-mode-card .muted,\n
.theme-safe-mode-status {\n
    margin: 4px 0 0;\n
    font-size: .92rem;\n
}\n
.theme-safe-mode-status {\n
    color: var(--on-review);\n
}\n
.admin-console .admin-appearance-themes .theme-safe-mode-card .theme-card-action.btn,\n
.admin-console .admin-appearance-themes .theme-safe-mode-card .theme-card-action .btn {\n
    padding: 7px 16px;\n
    font-size: .78rem;\n
    letter-spacing: .04em;\n
}\n
.admin-console .admin-appearance-themes .theme-preview-card .theme-card-action .btn {\n
    padding: 6px 14px;\n
    font-size: .74rem;\n
    letter-spacing: .04em;\n
}\n
.theme-preview-digest {\n
    color: var(--text-muted);\n
    font-family: var(--font-mono);\n
    font-size: .82rem;\n
}\n
.theme-serving,\n
.theme-empty-copy {\n
    margin: 0;\n
    font-size: .95rem;\n
}\n
.theme-empty-copy {\n
    color: var(--text-faint);\n
}\n
.theme-serving code {\n
    color: var(--text-muted);\n
    font-size: .82rem;\n
}\n
.theme-lkg-copy {\n
    margin: 5px 0 0;\n
    color: var(--text-faint);\n
    font-size: .88rem;\n
}\n
.theme-lkg-copy code {\n
    font-size: .8rem;\n
}\n
.admin-console .theme-active-facts {\n
    margin-top: 14px;\n
}\n
.theme-rollback-form {\n
    margin-top: 12px;\n
}\n
.admin-console .theme-rollback-form .reauth-field {\n
    margin-top: 0;\n
}\n
.admin-console .theme-rollback-button {\n
    margin-top: 12px;\n
    padding: 6px 14px;\n
    color: var(--danger);\n
    font-size: .74rem;\n
    letter-spacing: .04em;\n
}\n
.admin-console .theme-packages-card {\n
    padding-bottom: 10px;\n
    box-shadow: var(--shadow-sm);\n
}\n
.admin-console .theme-package-table {\n
    font-size: .92rem;\n
}\n
.admin-console .theme-package-table th {\n
    padding: 9px 10px 8px;\n
    border-bottom-color: var(--border-soft);\n
    font-size: .66rem;\n
    letter-spacing: .12em;\n
}\n
.admin-console .theme-package-table th:first-child,\n
.admin-console .theme-package-table td:first-child {\n
    padding-left: 0;\n
}\n
.admin-console .theme-package-table th:last-child,\n
.admin-console .theme-package-table td:last-child {\n
    padding-right: 0;\n
    text-align: right;\n
}\n
.admin-console .theme-package-table td {\n
    padding: 11px 10px;\n
    border-bottom-color: var(--border-hair);\n
}\n
.theme-package-cell strong {\n
    display: block;\n
    color: var(--text-strong);\n
    font-weight: 500;\n
}\n
.theme-package-cell code {\n
    color: var(--text-faint);\n
    font-size: .74rem;\n
}\n
.theme-package-version {\n
    color: var(--text-muted);\n
    font-family: var(--font-mono);\n
    font-size: .8rem;\n
}\n
.theme-build-digest {\n
    color: var(--text-muted);\n
    font-size: .76rem;\n
}\n
.theme-not-built {\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    font-size: .74rem;\n
    letter-spacing: .03em;\n
}\n
.theme-row-actions {\n
    display: flex;\n
    flex-direction: column;\n
    align-items: stretch;\n
    gap: 8px;\n
    min-width: 330px;\n
    text-align: left;\n
}\n
@keyframes aaRise {\n
    from { opacity: 0; transform: translateY(6px); }\n
    to { opacity: 1; transform: none; }\n
}\n
.admin-console .theme-row-actions .inline-form {\n
    justify-content: flex-end;\n
}\n
.admin-console .theme-row-button {\n
    padding: 4px 12px;\n
    box-shadow: none;\n
    font-size: .72rem;\n
    letter-spacing: .04em;\n
}\n
.theme-activate-form {\n
    padding: 18px 20px;\n
    background: var(--surface-raised);\n
    border: 1px solid var(--border-hair);\n
    border-left: 3px solid var(--warning);\n
    border-radius: var(--radius-lg);\n
    animation: aaRise 180ms var(--ease-calm) both;\n
}\n
.theme-activate-title {\n
    display: block;\n
    margin: 0 0 6px;\n
    color: var(--text-strong);\n
    font-family: var(--font-display);\n
    font-size: 1.2rem;\n
    font-weight: 500;\n
    line-height: 1.15;\n
}\n
.theme-activation-impact {\n
    margin: 0 0 14px;\n
    max-width: 62ch;\n
    color: var(--text-muted);\n
    font-size: .92rem;\n
    line-height: 1.5;\n
    text-wrap: pretty;\n
}\n
.admin-console .theme-activate-form .reauth-field {\n
    margin-top: 0;\n
}\n
.admin-console .theme-activate-form > .theme-row-button {\n
    margin-top: 10px;\n
    padding: 9px 18px;\n
    font-size: .8rem;\n
}\n
.theme-enable-link {\n
    color: var(--on-info);\n
    font-family: var(--font-label);\n
    font-size: .72rem;\n
    letter-spacing: .03em;\n
}\n
\n
.safe-mode-recovery {\n
    max-width: 760px;\n
}\n
.safe-mode-recovery .safe-mode-head h1 {\n
    margin: 0;\n
    font-size: 2.1rem;\n
}\n
.safe-mode-recovery > .admin-back {\n
    margin-top: 10px;\n
}\n
.safe-mode-recovery > .pane-intro {\n
    margin: 18px 0 22px;\n
    max-width: 68ch;\n
    font-size: 1rem;\n
    line-height: 1.55;\n
}\n
.safe-mode-recovery > .card {\n
    padding: 16px 20px;\n
    background: var(--surface-raised);\n
    border-color: var(--border-hair);\n
    border-radius: var(--radius-lg);\n
}\n
.safe-mode-recovery > .card > h2 {\n
    margin: 0 0 8px;\n
    font-size: 1.25rem;\n
}\n
.safe-mode-status {\n
    margin: 0;\n
    color: var(--text-muted);\n
    font-size: .92rem;\n
}\n
.safe-mode-status.is-on {\n
    color: var(--on-review);\n
}\n
.safe-mode-forced {\n
    margin: 12px 0 0;\n
    padding: 11px 14px;\n
    border-left: 3px solid var(--rust);\n
    border-radius: var(--radius-md);\n
    background: color-mix(in srgb, var(--rust) 12%, var(--surface-raised));\n
    color: var(--danger);\n
    font-size: .88rem;\n
    line-height: 1.5;\n
}\n
.safe-mode-recovery .reauth-field {\n
    display: grid;\n
    gap: 6px;\n
    width: 100%;\n
    max-width: 360px;\n
    margin: 0 0 12px;\n
}\n
.safe-mode-recovery .reauth-field > span:first-child {\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    font-size: .68rem;\n
    letter-spacing: .1em;\n
    text-transform: uppercase;\n
}\n
.safe-mode-recovery .btn {\n
    padding: 7px 16px;\n
    font-size: .78rem;\n
    letter-spacing: .04em;\n
}\n
\n
@media (max-width: 760px) {\n
    .admin-console .admin-appearance-branding .brand-cols,\n
    .branding-field-grid,\n
    .branding-marks {\n
        grid-template-columns: 1fr;\n
    }\n
    .admin-console .admin-appearance-branding .brand-preview {\n
        position: static;\n
        top: auto;\n
    }\n
    .theme-card-row {\n
        align-items: flex-start;\n
        flex-direction: column;\n
    }\n
    .theme-card-action,\n
    .theme-card-action .btn {\n
        width: 100%;\n
    }\n
}\n
\n
/* — Admin notifications: the Imladris email + announcements workbench. — */\n
.admin-console .admin-notifications {\n
    gap: 16px;\n
}\n
.admin-notifications > .flash {\n
    margin-bottom: 0;\n
}\n
.admin-console .admin-notifications > .notification-card,\n
.admin-console .admin-notifications .notification-top-grid > .notification-card {\n
    margin: 0;\n
    padding: 18px 20px;\n
    box-shadow: none;\n
}\n
.admin-notifications .notification-card > h2 {\n
    margin: 0 0 10px;\n
    color: var(--text-strong);\n
    font-family: var(--font-display);\n
    font-size: 1.25rem;\n
    font-weight: 500;\n
}\n
\n
/* F24 is production-owned: keep transport, From and sending domain as three\n
   independent facts, but set them in the design system's spec-list register. */\n
.admin-notifications .email-status-facts {\n
    display: grid;\n
    grid-template-columns: max-content minmax(0, 1fr);\n
    gap: 7px 18px;\n
    margin: 0;\n
    padding: 0;\n
    list-style: none;\n
}\n
.admin-notifications .email-status-facts li {\n
    display: contents;\n
}\n
.admin-notifications .email-status-facts strong {\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    font-size: .66rem;\n
    font-weight: 400;\n
    letter-spacing: .12em;\n
    text-transform: uppercase;\n
}\n
.admin-notifications .email-status-facts > li > span {\n
    min-width: 0;\n
    color: var(--text-strong);\n
    overflow-wrap: anywhere;\n
}\n
.admin-notifications .email-status-facts code {\n
    font-family: var(--font-mono);\n
    font-size: .8rem;\n
}\n
\n
.notification-top-grid {\n
    display: grid;\n
    grid-template-columns: repeat(2, minmax(0, 1fr));\n
    gap: 16px;\n
}\n
.notification-domain-name {\n
    margin: 0;\n
    color: var(--text-body);\n
    font-size: 1rem;\n
}\n
.notification-domain-name strong {\n
    font-weight: 500;\n
}\n
.notification-domain-name > span {\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    font-size: .76rem;\n
    letter-spacing: .03em;\n
}\n
.notification-domain-name code {\n
    font-family: var(--font-mono);\n
    font-size: .8rem;\n
}\n
.notification-domain-statuses {\n
    display: flex;\n
    flex-wrap: wrap;\n
    align-items: center;\n
    gap: 8px;\n
    margin: 10px 0 0;\n
}\n
.email-domain-chip {\n
    display: inline-flex;\n
    align-items: center;\n
    gap: 6px;\n
    padding: 2px 10px;\n
    border-radius: var(--radius-pill);\n
    background: var(--surface-review);\n
    color: var(--on-review);\n
    font-family: var(--font-label);\n
    font-size: .7rem;\n
    letter-spacing: .05em;\n
}\n
.email-domain-chip.is-pass {\n
    background: var(--surface-done);\n
    color: var(--on-done);\n
}\n
.email-domain-chip.is-fail {\n
    background: color-mix(in srgb, var(--rust) 12%, var(--surface-raised));\n
    color: var(--danger);\n
}\n
.email-domain-chip.is-unknown {\n
    background: var(--surface-pending);\n
    color: var(--on-pending);\n
}\n
.notification-domain-checked {\n
    color: var(--text-faint);\n
    font-family: var(--font-mono);\n
    font-size: .76rem;\n
}\n
.notification-domain-actions {\n
    display: flex;\n
    align-items: center;\n
    gap: 12px;\n
    margin-top: 14px;\n
}\n
.notification-domain-actions .btn,\n
.notification-test-actions .btn {\n
    padding: 7px 15px;\n
    font-size: .76rem;\n
    letter-spacing: .04em;\n
    box-shadow: none;\n
}\n
.notification-domain-actions > span {\n
    color: var(--text-faint);\n
    font-family: var(--font-label);\n
    font-size: .74rem;\n
    letter-spacing: .03em;\n
}\n
.notification-test-card > p {\n
    max-width: 46ch;\n
    margin: 0 0 14px;\n
    color: var(--text-muted);\n
    font-size: .92rem;\n
    line-height: 1.5;\n
    text-wrap: pretty;\n
}\n
.notification-test-actions {\n
    display: flex;\n
    align-items: center;\n
    gap: 12px;\n
}\n
.notification-test-actions .btn:disabled {\n
    cursor: not-allowed;\n
    border-color: var(--border-hair);\n
    background: var(--surface-sunken);\n
    color: var(--text-faint);\n
    filter: none;\n
    opacity: 1;\n
}\n
.notification-test-actions .btn:disabled:hover {\n
    background: var(--surface-sunken);\n
}\n
.notification-inline-status {\n
    color: var(--on-done);\n
    font-family: var(--font-label);\n
    font-size: .76rem;\n
    letter-spacing: .04em;\n
}\n
.notification-inline-status.is-error {\n
    color: var(--danger);\n
}\n
\n
