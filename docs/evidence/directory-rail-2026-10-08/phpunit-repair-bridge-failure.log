    overflow-y: auto;
}
body[data-route="inbox"] .main { overflow: hidden; }
/* `.main > .read-main` carries `margin: -24px` to cancel `.main`'s own 24px
   padding. The rule above zeroes that padding on these routes, which left the
   negative margin uncompensated: it dragged the reading column 24px left and,
   being a shorthand at higher specificity, also overrode `.board-index`'s own
   `margin: 0 auto` — so the one member surface that asks to be centred never
   could. Zero it wherever the padding it answers to has been zeroed. */
body[data-route="boards"] .main > .read-main,
body[data-route="search"] .main > .read-main,
body[data-route="compose"] .main > .read-main,
body[data-route="inbox"] .main > .read-main { margin: 0 auto; }

/* Board index */
.board-index {
    width: min(100%, 840px);
    margin: 0 auto;
    padding: 26px 40px 90px;
}
.forum-directory__tabs {
    display: flex;
    gap: 22px;
    margin: 0 0 30px;
    overflow-x: auto;
    border-bottom: 1px solid var(--border-hair);
}
.forum-directory__tabs a {
    position: relative;
    flex: 0 0 auto;
    padding: 0 0 9px;
    border-bottom: 2px solid transparent;
    color: var(--text-faint);
    font-family: var(--font-label);
    font-size: .88rem;
    letter-spacing: .03em;
    text-decoration: none;
}
.forum-directory__tabs a:hover { color: var(--text-body); text-decoration: none; }
.forum-directory__tabs a[aria-current="page"] {
    border-bottom-color: var(--gold-500);
    color: var(--text-strong);
}
/* --gold-ink, not --gold-500: the numbered gold is a single primitive the
   twilight register never remaps, and at 6px this is a non-text cue that has to
   clear 3:1 against the page in BOTH registers. --gold-ink is semantic and
   flips with the register, so it clears the floor in each. */
.directory-tab-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 5px;
    border-radius: 50%;
    background: var(--gold-ink);
