body[data-route="boards"] .app-shell,
body[data-route="search"] .app-shell,
body[data-route="compose"] .app-shell,
body[data-route="inbox"] .app-shell {
    height: calc(100vh - var(--topbar-h));
    height: calc(100dvh - var(--topbar-h));
    min-height: 0;
}
body[data-route="boards"] .main,
body[data-route="search"] .main,
body[data-route="compose"] .main,
body[data-route="inbox"] .main {
