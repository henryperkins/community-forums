/* Forum inbox */
.inbox-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    height: calc(100vh - var(--topbar-h));
    height: calc(100dvh - var(--topbar-h));
    min-height: 0;
}
.inbox-list {
    min-width: 0;
    padding: 26px 30px 40px;
    overflow-y: auto;
    border-right: 0;
    background: var(--surface-page);
    scrollbar-gutter: stable;
}
/* Keep the queue close to its controls; occasional actions live in disclosures. */
.inbox-list-head { margin: 0 0 12px; padding: 0; border: 0; }
.compose-eyebrow {
    margin: 0 0 6px;
    color: var(--gold-ink);
    font-family: var(--font-label);
    font-size: .68rem;
    letter-spacing: .18em;
    text-transform: uppercase;
}
.inbox-title-line { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
.inbox-list-head h1 {
    margin: 0;
